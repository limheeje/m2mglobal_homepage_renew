---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="Where AI Transformation Begins—Turning Market Change into Speed and Direction<br/>24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner"
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-5'} />
    <TitleMain title="News" />

    <section class="g-section">
      <div class="innerWrap">
        <div class="company__news-list">
          {
            newsItems.map((item) => (
              <div class="company__news-row">
                <div class="company__news-row-main">
                  <span class="company__news-tag">{item.tag}</span>
                  <p class="company__news-title">{item.title}</p>
                  <span class="company__news-date">{item.date}</span>
                </div>
                <Button
                  variant="white"
                  size="sm"
                  useSuffixIcon="blank"
                  href={item.href ?? undefined}
                  target={item.href ? '_blank' : undefined}
                  class:list="company__news-link"
                >
                  바로가기
                </Button>
              </div>
            ))
          }
        </div>

        <div class="company__news-clients">
          {
            clientCategories.map((category) => (
              <div class="company__news-client-category">
                <TitleSub
                  title={`${category.title.replace(/분야$/, '')}<span class="mark">분야</span>`}
                />
                <ClientLogoGrid clients={category.clients} />
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
