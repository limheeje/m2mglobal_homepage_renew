// 메인 페이지 (/) — Figma "Main"은 Main slogan(1) / 사업정보(2) / AI(3) / Business(4) /
// Solution_Project 인스턴스 3개(5,6,7: Solution/Why,M2MGLOBAL?/Project) / Partner 순서로 8개
// 섹션이다. PC($breakpoint-md=1300px 이상)는 fullPage.js로 섹션 단위 스냅/락 스크롤(원래 동작
// 그대로, 각 섹션 정확히 100vh). 모바일(1300px 미만)은 fullPage의 responsiveWidth로 스냅을 완전히
// 꺼서 문서가 평범하게 스크롤되고, 섹션은 min-height:100vh라 컨텐츠가 넘치면 그만큼 더 자라난다
// (모바일에서 컨텐츠 많은 섹션이 고정 100vh 안에서 잘려 보이던 문제 때문에 모바일만 이렇게 뺌 —
// PC는 안 건드림). 컨트롤은 Figma 실측대로 두 가지로 나뉜다 —
//   1~4: 우측 세로 닷 페이지네이션만(화살표 버튼 없음), 섹션 내부 아이템끼리 loop 가로 슬라이드
//   5~7: 페이지네이션 없이 섹션 헤더의 우측 상단 prev/next 버튼만. 5·7은 카드 폭 고정 +
//        slidesPerView:'auto'라 다음 카드가 오른쪽에 살짝 걸쳐 보이는(peek) 스와이프,
//        6은 케이스 1장씩 통째로 전환.
//   Partner: 슬라이드 아님, 고정 1장.
// Section 1 하단 가운데 스크롤 유도 마우스 아이콘도 Figma 실측(CSS로 구현, 휠이 흐르는 애니메이션).
// Swiper는 npm 설치 대신 CDN <script src>로 불러온다(사용자 지정) — Layout의 "head" 슬롯으로 CSS를
// <head>에, 본문 끝에서 JS 스크립트 태그 + 초기화 스크립트를 로드한다.
import MainLayout from '~/layouts/MainLayout.astro'
import TextList from '~/components/common/TextList.astro'
import Box from '~/components/common/Box.astro'
import Footer from '~/components/layout/Footer.astro'

const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL
// Partner 섹션 로고: 이미 다운로드되어 있는 src/assets/images/clients/ico_client_*.png 재사용
// (ClientLogoGrid 공용 컴포넌트는 카드가 테두리+고정 비율(277x133) 고정이라 Figma의 이 섹션
// 카드(테두리 없음, radius 24, 내용 높이에 맞춰 자연스러운 높이)와 맞지 않아 여기서는 직접 구현)
const partnerLogoFiles = import.meta.glob<{default: ImageMetadata}>(
  '/src/assets/images/clients/*.png',
  {eager: true}
)
const partnerLogoSrc = (key: string) => {
  const entry = Object.entries(partnerLogoFiles).find(([path]) =>
    path.includes(`ico_client_${key}`)
  )
  return entry?.[1].default.src
}

// 메인 전용 배경/사진(Figma export, src/assets/images/main/*.png) + 아이콘(src/assets/icons/main/*.svg)
// — Figma "Main" 전체 선택 조회 후 export한 자산. 파일명은 다운로드 시 의미 기준으로 재명명했다.
const mainImgFiles = import.meta.glob<{default: ImageMetadata}>('/src/assets/images/main/*.png', {
  eager: true
})
const mainImgSrc = (key: string) => {
  const entry = Object.entries(mainImgFiles).find(([path]) => path.endsWith(`/${key}.png`))
  return entry?.[1].default.src
}
const mainIconFiles = import.meta.glob<{default: ImageMetadata}>('/src/assets/icons/main/*.svg', {
  eager: true
})
const mainIconSrc = (key: string) => {
  const entry = Object.entries(mainIconFiles).find(([path]) => path.endsWith(`/${key}.svg`))
  return entry?.[1].default.src
}

