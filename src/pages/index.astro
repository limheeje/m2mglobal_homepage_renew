              </div>
              <div class="sp-why-card">
                {/* <!-- TODO: 로고 이미지 삽입 --> */}
                <span class="sp-why-logo-ph" aria-hidden="true" />
                <p class="sp-why-card-title" set:html={item.cardTitle} />
                <div class="sp-why-card-list">
                  {item.cardList.map((text) => (
                    <div class="sp-why-card-item">
                      {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                      <span class="sp-solution-item-icon-ph" aria-hidden="true" />
