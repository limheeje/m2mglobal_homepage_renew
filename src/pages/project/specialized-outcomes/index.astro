      <TitleSub title={`특별한 <span class="mark">성과</span>`} />
      <div class="spec__gallery-grid">
        {Array.from({length: 6}).map(() => <div class="spec__gallery-ph" aria-hidden="true" />)}
      </div>
    </div>
  </section>

  <section id="cj" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`로봇기반 통합관제시스템 <span class="mark">구축 사례</span>`} />
      <div class="spec__timeline">
        {
          cjTimelinePhases.map((phase) => (
            <div class="spec__timeline-phase">
              <p class="spec__timeline-phase-label">{phase.label}</p>
              <p class="spec__timeline-phase-date">{phase.dateRange}</p>
              <div class="spec__timeline-stages">
                {phase.stages.map((stage) => (
                  <div class="spec__timeline-stage">
                    <p class="spec__timeline-step">{stage.step}</p>
                    <p class="spec__timeline-desc">{stage.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <TitleSub title={`구현 <span class="mark">기능</span>`} />
      <div class="spec__num-grid">
        {
          cjFeatures.map((text, i) => (
            <div class="spec__num-card">
              <p class="spec__num-index">{String(i + 1).padStart(2, '0')}</p>
              <p class="spec__num-label" set:html={text.replace(/\n/g, '<br/>')} />
            </div>
          ))
        }
      </div>

      <TitleSub title={`연동 제조사 <span class="mark">AMR / AGV</span>`} />
      <div class="spec__equip-table">
        <div class="spec__equip-row spec__equip-row--head">
          <span>제조사</span><span>모델</span><span>유형</span><span>용도</span>
        </div>
        {
          cjEquipment.map((row) => (
            <div class="spec__equip-row">
              <>
                <span>{row.maker}</span>
                <span>{row.model}</span>
                <span>{row.type}</span>
                <span>{row.usage}</span>
              </>
            </div>
          ))
        }
      </div>

      <TitleSub
        title={`CJ 대한통운 APRIL 로봇통합플랫폼 : <span class="mark">동작 구현 화면</span>`}
      />
      <!-- TODO: 동작 구현 화면 이미지 삽입 -->
      <div class="spec__image-ph spec__image-ph--wide" aria-hidden="true"></div>

      <TitleSub title={`시스템 <span class="mark">업무 구성</span>`} />
      <p class="spec__intro-text">
        플랫폼 통합관제, 통합정보관리, 작업관리, 사용자 시스템을 통합 구현하여 로봇 운영과 물류
        업무를 하나의 플랫폼에서 효율적으로 관리할 수 있는 환경을 제공합니다.
      </p>
      <div class="spec__sysmap-grid">
        {
          cjSystemCards.map((card) => (
            <div class="spec__sysmap-card">
              {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
              <span class="spec__sysmap-icon-ph" aria-hidden="true" />
              <p class="spec__sysmap-title">{card.title}</p>
              {card.items.length > 0 && (
                <ul class="spec__sysmap-list">
                  {card.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <TitleSub title={`주요 <span class="mark">기능 소개</span>`} />
      <p class="spec__intro-text">
        PC는 보충주문, 일반 피킹, 반출 피킹, 재고조사 등 운영 관리 기능을 제공하고, 태블릿은
        대시보드, 오더 피킹, 맵 조회, 실시간 위치 확인 등 현장 중심의 작업 지원 기능을 제공합니다.
      </p>
      <div class="spec__compare">
        {
          cjCompareCols.map((col, i) => (
            <>
              {
                /* TODO: 화살표 이미지 삽입 */
                i === 1 && <span class="spec__compare-arrow-ph" aria-hidden="true" />
              }
              <div class="spec__compare-col">
                {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                <span class="spec__compare-icon-ph" aria-hidden="true" />
                <p class="spec__compare-device">{col.device}</p>
                <div class="spec__compare-list">
                  {col.items.map((text) => (
                    <TextList type="type_2">{text}</TextList>
                  ))}
                </div>
                {/* <!-- TODO: 화면 스크린샷 이미지 삽입 --> */}
                <div class="spec__image-ph" aria-hidden="true" />
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
