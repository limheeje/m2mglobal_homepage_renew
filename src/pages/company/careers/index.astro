---
// Company > 인재 채용 (/company/careers)
// 참고: Figma "About us > 인재채용" 프레임(node 360:1185)
import Layout from '~/layouts/Layout.astro'
import Gnb from '~/components/layout/Gnb.astro'
import PageBanner from '~/components/PageBanner.astro'
import Tab from '~/components/Tab.astro'
import Title from '~/components/Title.astro'
import Container from '~/components/Container.astro'
import Box from '~/components/Box.astro'
import IconCircle from '~/components/IconCircle.astro'
import TextList from '~/components/TextList.astro'
import Footer from '~/components/Footer.astro'
import {route} from '@config/route'

const tabs = [
  {label: '회사 개요', href: route['/company/info']},
  {label: 'CEO 인사말', href: route['/company/ceo-message']},
  {label: '회사 연혁', href: route['/company/history']},
  {label: '인재 채용', href: route['/company/careers']},
  {label: 'News', href: route['/company/news']},
  {label: '위치 및 연락처', href: route['/company/address']},
  {label: '사업 문의', href: route['/company/contact-us']}
]

const benefits = [
  {
    icon: 'ico_value_trust',
    title: '임직원 건강검진 시행',
    desc: ['국내 최고의 검진 기관을 통해', '임직원, 가족의 검진 비용 지원']
  },
  {
    icon: 'ico_benefit_culture',
    title: '문화 외식비 지원',
    desc: ['임직원의 문화 생활을 위한', '분기별 문화 회식비 지원']
  },
  {
    icon: 'ico_benefit_longterm',
    title: '장기근속자 포상제도 시행',
    desc: ['장기 근속 임직원에 대한', '근속년수 5년 단위 포상 제공']
  },
  {
    icon: 'ico_benefit_referral',
    title: '인재 추천',
    desc: ['정 직원 추천 및 채용 후 특정 기간 근속 시', '추천 직원에게 포상금액 지급']
  },
  {
    icon: 'ico_benefit_training',
    title: '직무교육 지원',
    desc: ['직무교육, 세미나, 컨퍼런스,', '온라인 강의 지원']
  },
  {
    icon: 'ico_benefit_cert',
    title: '자격증 취득 지원',
    desc: ['자격증 취득, 전문 교육과정 등', '자기성장교육 지원']
  },
  {
    icon: 'ico_benefit_condolence',
    title: '경조비 지원',
    desc: ['임직원 본인 및 가족 경조사에 대한', '경조금 지급']
  },
  {
    icon: 'ico_benefit_holiday',
    title: '명절 귀향비 지급',
    desc: ['즐거운 명절을 위한', '명절 귀향비 지급']
  }
]

const fields = [
  {title: ['플랫폼 전문', '구축 역량'], desc: ['PMO, QA, AA, TA, DA,', 'AI, Cloud, 영업지원']},
  {title: '이커머스 플랫폼', desc: ['다이소, 농협몰, 수협몰 등', '이커머스 플랫폼 구축']},
  {title: '물류 플랫폼', desc: ['CJ, 로봇, 무역에 관련', '물류 플랫폼 구축']},
  {title: 'AI, 클라우드', desc: ['Appreneur, Microsoft AZURE,', 'IBM, AWS']},
  {title: '모바일 플랫폼', desc: 'Android, IOS 구축'},
  {title: 'UI/UX', desc: ['기획, 디자인, 퍼블', '전문 팀 구성']}
]
---

<Layout>
  <Gnb />

  <PageBanner
    title="Company"
    subtitle={[
      'Where AI Transformation Begins—Turning Market Change into Speed and Direction',
      '24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner'
    ]}
  />

  <Tab variant="line" size="large" items={tabs} activeIndex={3} />

  <Title
    variant="hero"
    title="인재 채용"
    subtitle={[
      '미래를 함께 만들어가며, 성장과 성취를 함께할 창의적이고 도전적인 인재를 기다립니다.',
      '엠투엠글로벌은 함께 나누고 성장하기 위해 다양한 복지제도를 운영하고 있습니다.'
    ]}
  />

  <Container maxWidth={1760} class="company-page-end">
    <div class="company-careers">
      <div class="company-careers__benefits">
        <Title
          variant="section"
          prefix="M2M GLOBAL "
          highlight="복지 제도"
          class="company-careers__benefit-title"
        />
        <div class="company-careers__benefit-grid">
          {
            benefits.map((benefit) => (
              <Box icon={benefit.icon} title={benefit.title} class="company-careers__benefit-box">
                {benefit.desc.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </Box>
            ))
          }
        </div>
      </div>

      <div>
        <Title
          variant="section"
          prefix="인재 채용 "
          highlight="분야 / 안내"
          class="company-info__section-title"
        />
        <div class="company-careers__fields">
          {
            fields.map((field) => (
              <Box variant="filled" title={field.title} class="company-careers__field-box">
                {Array.isArray(field.desc)
                  ? field.desc.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))
                  : field.desc}
              </Box>
            ))
          }
        </div>
      </div>

      <div class="company-careers__process">
        <IconCircle icon="ico_benefit_process" />
        <div class="company-careers__process-body">
          <Title variant="section" prefix="채용 절차 " highlight="(상시)" />
          <div class="company-careers__process-list">
            <TextList>
              1차 서류 전형 : 지원자는 이력서와 자기소개(경력자는 경력기술서 포함)를 인사지원팀
              이메일(<a href="mailto:recruit@m2mglobal.co.kr">recruit@m2mglobal.co.kr</a>) 로
              보내주세요
            </TextList>
            <TextList
              >제출한 입사지원 서류는 반환하지 않으며, 입사지원 검토용으로만 사용됩니다</TextList
            >
          </div>
        </div>
      </div>
    </div>
  </Container>

  <Footer />
</Layout>
