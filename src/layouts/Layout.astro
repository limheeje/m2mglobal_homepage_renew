---
import '~/styles/css/main.css'
import AllMenu from '~/components/common/AllMenu.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="//www.m2mglobal.co.kr/img/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="Author" content="M2MGlobal" />
    <meta name="keywords" content="M2MGlobal" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta property="og:title" content="M2MGLOBAL" />
    <meta property="og:type" content="M2MGLOBAL e-Commerce and e-Trade Solution Partner" />
    <meta property="og:url" content="http://www.m2mglobal.co.kr" />
    <meta property="og:image" content="//www.m2mglobal.co.kr/img/img_meta.png" />
    <meta
      property="og:description"
      content="한국 전자상거래의 역사와 함께한 엠투엠글로벌은 B2C, B2B, B2E 영역에서 Totale-Commerce솔루션을 제공합니다."
    />
    <title>M2MGlobal</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <button type="button" class="layout__top-btn" aria-label="맨 위로 가기">
      <span class="layout__top-btn-icon" aria-hidden="true"> </span>
      <span class="layout__top-btn-icon-text">TOP</span>
    </button>
    <AllMenu />
    <script>
      import '~/scripts/tab-box-scrollspy.ts'
      import '~/scripts/scroll-to-top.ts'
      import '~/scripts/all-menu-toggle.ts'
      import '~/scripts/layer-popup.ts'
      import '~/scripts/nav-active-state.ts'
      import '~/scripts/navi-group-active-scroll.ts'
    </script>
  </body>
</html>

<style>
  /* height:100%였던 걸 min-height:100%로 — src/styles/scss/base/_reset.scss의 동일 규칙과 같은
     이유(overflow-x:hidden과 만나면 body가 고정 높이 스크롤 컨테이너가 돼버려 window 스크롤이
     항상 0으로 멈추는 버그였음). Astro 스코프 스타일이라 이 파일도 별도로 고쳐야 실제로 적용됨. */
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
