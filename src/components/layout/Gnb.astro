---
import {route} from '@config/route/routeMap.ts'
const localGnbItems = route
const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL
---

<div class="gnb-wrap">
  <div class="lts">
    <a href="/" class="logo">로고</a>
  </div>
  <div class="content">
    <ul class="gnb">
      {
        localGnbItems &&
          localGnbItems.map((item) => (
            <li class="gb-item">
              <a href={PUBLIC_BUILD_URL + item.href} class="g-link">
                {item.label}
              </a>
            </li>
          ))
      }
    </ul>
  </div>
  <div class="rts">
    <button class="all-gnb"></button>
  </div>
</div>
