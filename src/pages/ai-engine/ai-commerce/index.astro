---
// AI Engine > AI Commerce (/ai-engine/ai-commerce)
// Figma "AI > AI Commerce" 9개 프레임(추천설계 / 아키텍처 전환 / 상황기반추천설계 / AI 스코어링 /
// 개인화 / 재구매 예측 / 재 랭킹 / 리밸런싱 / 실행 사례) — 전부 같은 Tap_box_series 앵커 탭의 상태라
// 한 페이지로 합쳤다 (/ai-engine/machine-learning과 동일 패턴).
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import Label from '~/components/common/Label.astro'
import stepArrowUrl from '~/assets/images/step-arrow.svg'
import {ICON_KEY_NAME} from '~/constants/Icon'
import Icon from '~/components/common/Icon.astro'
import SYMBOL001 from '~/assets/images/common/symbol001.png'
import SYMBOL002 from '~/assets/images/common/symbol002.png'
import SYMBOL003 from '~/assets/images/common/symbol003.png'
import SYMBOL004 from '~/assets/images/common/symbol004.png'
import SYMBOL005 from '~/assets/images/common/symbol005.png'
import ClientLogoGrid from '~/components/common/ClientLogoGrid.astro'
import UiNoti from '~/components/ui/box/UiNoti.astro'
const localNavigation = route.find((item) => item.href === '/ai-engine/machine-learning')

const sectionTabs = [
  {id: 'design', label: '추천설계'},
  {id: 'architecture', label: '아키텍처 전환'},
  {id: 'context', label: '상황기반추천설계'},
  {id: 'scoring', label: 'AI 스코어링'},
  {id: 'personalize', label: '개인화'},
  {id: 'repurchase', label: '재구매 예측'},
  {id: 'reranking', label: '재 랭킹'},
  {id: 'rebalancing', label: '리밸런싱'},
  {id: 'cases', label: '실행 사례'}
]

// --- 추천설계: 아이콘+타이틀+체크리스트 카드 3개 ---
const designCards = [
  {
    icon: ICON_KEY_NAME['AI & Machine Learning3-1'],
    title: '초개인화',
    items: [
      '맥락(Context) 기반 랭킹 시스템 도입',
      '단순 클릭 기반을 넘어 구매 주기와 취향 벡터를 결합한 개인화 실현'
    ]
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning3-2'],
    title: '통제 가능한 AI',
    items: [
      '블랙박스(Black Box)가 아닌 글래스박스(AI)',
      '재고, 프로모션, 회원 등급에 따라 운영자가 즉시 개입 가능한 구조'
    ]
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning3-3'],
    title: '단계적 확장성',
    items: [
      'Multi-Layer Scoring Framework 적용',
      '1단계 랭킹 고도화부터 3단계 실시간 튜닝까지 리스크 최소화를 위한 단계적 도입'
    ]
  }
]

// --- 아키텍처 전환: Level 1~4 ---
const levels = [
  {
    level: 'Level 1',
    title: '상품 중심 진열',
    items: [
      '카테고리/이벤트 기반 노출',
      '운영자 수동 편성',
      '고객 행동 데이터 미반영',
      '상품 중심 노출 기준',
      '개인별 최적화 구조 부재'
    ],
    dataLevel: '상품 데이터 중심',
    metric: '노출량'
  },
  {
    level: 'Level 2',
    title: '정책 중심 추천',
    items: [
      '함께 본/함께 산 상품',
      '단순 교차 판매 로직',
      '세그먼트 단위 추천',
      '조건 기반 필터링 구조',
      '실시간 반응 제한'
    ],
    dataLevel: '상품 + 거래',
    metric: '클릭률'
  },
  {
    level: 'Level 3',
    title: '맥락 기반 추천 구조',
    items: [
      '사용자 행동 신호 실시간 반영',
      '회원 유형/재고/정책 통합',
      '노출 가중치 동적 적용',
      '상품 속성 + 구매 주기 분석',
      'KPI 기준 추천 모델 튜닝'
    ],
    dataLevel: '상품 + 거래 + 행동',
    metric: '전환율'
  },
  {
    level: 'Level 4',
    title: '실시간 적응형 추천',
    items: [
      '실시간 행동 피드백 루프',
      '운영 통제와 알고리즘 통합',
      'KPI 기반 자동 최적화',
      '세션 단위 동적 개인화',
      'A/B 테스트 반영'
    ],
    dataLevel: '상품 + 거래 + 행동 + 실시간 세션 데이터',
    metric: 'LTV*/재구매율'
  }
]

// --- 상황기반추천설계: 고객 여정 5단계 + 커머스 특성 3카드 ---
const journeyStages = [
  {
    title: '탐색 단계 (Discovery)',
    items: ['목적 : 관심 상품 발견', '유형 : 개인화 추천(취향 기반)']
  },
  {
    title: '상품 상세 (Detail)',
    items: ['목적 : 구매확신 강화', '유형 : 연관 상품(함께 본/산 상품)']
  },
  {
    title: '장바구니 (Cart)',
    items: ['목적 : 객단가(AOV*) 상승', '유형 : 교차 판매 Cross-Selling, 보완재']
  },
  {title: '주문/배송 (Order)', items: ['목적 : 재구매 유도', '유형 : 반복 구매 주기 분석']},
  {title: '마이페이지 (MyPage)', items: ['목적 : 충성도 강화', '유형 : 개인화 피드']}
]
const strategyCards = [
  {
    title: '복합 회원 정책',
    items: ['가격 정책 차별화', 'B2B·B2C 혼합 구조 대응', '노출 우선 순위 전략화']
  },
  {
    title: '식품 물류 특성',
    items: ['합배송 최적화', '배송비 부담 완화', '장바구니 기반 묶음 추천']
  },
  {
    title: '재고 및 유통기한',
    items: ['임박 상품 가중치 조정', '재고 회전율 최적화', '폐기 리스크 최소화']
  }
]

// --- AI 스코어링: 2단 레이어 구조 ---
const scoringLayers = [
  {
    title: 'Layer 1 : Catalog Intelligence',
    items: ['상품 속성 정규화', '카테고리/브랜드/가격 구조화']
  },
  {
    title: 'Layer 2 : Business Rule Engine',
    items: ['회원 유형 필터', '정책/프로모션 반영', '노출 우선순위 제어']
  },
  {
    title: 'Layer 3 : Inventory & Logistics Layer',
    items: ['재고 가중치', '유통기한 민감도', '합배송 조건 반영']
  },
  {
    title: 'Layer 4 : Behavior Modeling',
    items: ['클릭/구매 시그널', '구매 주기 분석', '구매 주기 분석']
  },
  {title: 'Layer 5 : Adaptive Scoring', items: ['가중치 통합', 'KPI 기반 튜닝', '실시간 최적화']}
]
const scoringFunctions = [
  {
    title: 'Layer 1: 후보군 생성 (Candidate Generation)',
    items: ['행동/카테고리 기반 광범위 후보 확보']
  },
  {
    title: 'Layer 2: 개인화 신호 (Personalization Layer)',
    items: ['사용자 벡터(Vector) 매칭 & 선호도 반영']
  },
  {title: 'Layer 3: 재구매 모델링 (Repurchase Modeling)', items: ['식품 구매 주기 패턴 분석']},
  {title: 'Layer 4: 비즈니스 통제 (Business Control)', items: ['재고, 프로모션, 정책 필터링']},
  {title: 'Layer 5 : 재랭킹 (Re-Ranking)', items: ['다양성 확보 및 최신성 반영']},
  {title: 'Output: 최종 추천 리스트', items: []}
]

// --- 개인화: Layer 1~2 카드 ---
const personalizeCards = [
  {
    title: 'Layer 1: 후보군 생성',
    subtitle: '(Candidate Generation)',
    desc: '빠르게 많이 모으는 단계.<br/>사전 계산(Pre-Computation) 기반으로 속도와 안정성 확보',
    items: ['세션 내 동시 조회', '구매 연계', '행동 기반 연관']
  },
  {
    title: 'Layer 2: 개인화 신호 강화',
    subtitle: '(Personalization Layer)',
    desc: '동일 상품이라도 사용자에 따라<br/>순위가 달라집니다.',
    items: ['카테고리 선호도', '최근 행동 가중치', '브랜드 선호']
  }
]

// --- 실행 사례: 고객사 로고 4개 (/company/news와 동일한 로고 자산 재사용) ---
const caseClients = [
  {name: '수협쇼핑', key: '05-suhyupshopping'},
  {name: 'SemiMarket', key: '03-semimarket'},
  {name: '케이카', key: '04-kcar'},
  {name: '다이소', key: '02-daiso'}
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="AI Engine"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>모듈화 된 e-Commerce 아키텍처+AI를 결합하여 Commerce Platform에 속도와 생산성을 높입니다."
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-AI-ENGINE-ID-2'} />
    <TitleMain
      title="AI Commerce"
      description="Hybrid Multi-Layer Scoring Framework를 통해 거래·추천·분석까지<br/>AI Commerce 비즈니스를 실현 중인 M2M GLOBAL만의 지능형 프레임워크"
    />

    <div class="ai-com-sub-banner">
      <div class="innerWrap">
        <div class="inner">
          <!--  -->
          <div class="item">
            <div class="txt">
              <span class="tit">후보군 생성</span>
              <span class="dec">(Candidate Generation)</span>
            </div>
          </div>
          <div class="item">
            <div class="txt">
              <span class="tit">AI 스코어링</span>
              <span class="dec">(AI Scoring)</span>
            </div>
          </div>
          <div class="item point">
            <div class="txt">
              <span class="tit">AI Commerce</span>
            </div>
          </div>
          <div class="item">
            <div class="txt">
              <span class="tit">최종 랭킹</span>
              <span class="dec">(Ranking & Optimization)</span>
            </div>
          </div>
          <div class="item">
            <div class="txt">
              <span class="tit">비즈니스 룰 적용</span>
              <span class="dec">(Business Rules)</span>
            </div>
          </div>
          <!--  -->
        </div>
      </div>
    </div>

    <div class="innerWrap">
      <div class="bs-tab-group">
        {
          sectionTabs.map((tab, i) => (
            <a
              class="bs-tab tab__item"
              class:list={{'is-active': i === 0}}
              data-type="box"
              href={`#${tab.id}`}
            >
              {tab.label}
            </a>
          ))
        }
      </div>
    </div>

    <section id="design" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`추천 <span class="mark">설계</span>`}
          description="추천 시스템은 데이터·모델·운영 통제를 결합한 전략 자산으로 개인화 → 분석 기반 최적화 → 확장 가능한 아키텍처로 단계적으로 진화합니다."
        />
        <div class="ai__feature-grid">
          {
            designCards.map((card) => (
              <div class="ai__feature-card">
                <div class="ai__feature-head">
                  {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                  <span class="ai__feature-icon" aria-hidden="true">
                    <Icon name={card.icon} />
                  </span>
                  <p class="ai__feature-title">{card.title}</p>
                </div>
                <div>
                  {card.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="architecture" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`추천 <span class="mark">아키텍처 전환</span>`}
          description="데이터 기반 개인화 및 실시간 보정 체계로 전환 함으로써, 고객 여정 전반에서 실질적인 매출 기여가 가능한 추천 체계로 진화합니다."
        />
        <div class="ai__level-grid">
          {
            levels.map((lv) => (
              <div class="ai__level-card">
                <Label type="type_2">{lv.level}</Label>
                <p class="ai__level-title">{lv.title}</p>
                <div>
                  {lv.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
                <UiNoti dataLevel={lv.dataLevel} metric={lv.metric} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="context" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`상황별 <span class="mark">추천 전략</span>`}
          description="고객 여정 단계에 따라 목적이 달라져야 하며, 홈 · 상품상세· 장바구니 · 주문완료 단계별로 강력한 추천 데이터를 적용합니다."
        />
        <div class="ai__flow">
          {
            journeyStages.map((stage, i) => (
              <>
                <div class="ai__flow-box">
                  <p class="ai__flow-title">{stage.title}</p>
                  {stage.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
                {i < journeyStages.length - 1 && (
                  <span class="ai__flow-arrow" aria-hidden="true">
                    <img src={stepArrowUrl.src} alt="" />
                  </span>
                )}
              </>
            ))
          }
        </div>

        <TitleSub title={`커머스 특성을 반영한 <span class="mark">추천 설계 적용</span>`} />
        <div class="ai__strategy-row">
          {
            strategyCards.map((card) => (
              <div class="ai__strategy-card">
                <p class="ai__strategy-title">{card.title}</p>
                <div>
                  {card.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
              </div>
            ))
          }
          <span class="ai__strategy-arrow" aria-hidden="true">
            <img src={stepArrowUrl.src} alt="" />
          </span>
          <div class="ai__strategy-banner">
            <p class="ai__strategy-banner-title">Context-Aware Semantic Scoring Engine</p>
            <p class="ai__strategy-banner-desc">
              Score = Member Type + Logistics Condition + Inventory Sensitivity + Behavior Signal
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="scoring" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`Hybrid Multi-Layer <span class="mark">Scoring Framework</span>`}
          description="다층 구조 기반의 통합 가중치 설계를 통해 최종 점수를 산정하는 지능형 의사결정 엔진으로 상품 구조·회원 정책·재고 조건·행동 신호를 동시에 반영하여 전략적으로 제어 가능한 추천 체계를 구현합니다."
        />
        <div class="ai__scoring-grid">
          <div>
            <p class="ai__scoring-col-title">Core Architecture Layers</p>
            {
              scoringLayers.map((layer) => (
                <div class="ai__scoring-layer">
                  <p class="ai__scoring-layer-head">{layer.title}</p>
                  {layer.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
              ))
            }
          </div>

          <!-- TODO: 이미지 삽입 -->
          <div class="ai__scoring-image ai__thumb-ph" aria-hidden="true">
            <img src={SYMBOL001.src} alt="" />
          </div>

          <div>
            <p class="ai__scoring-col-title">Applied Recommendation Functions</p>
            {
              scoringFunctions.map((layer) => (
                <div class="ai__scoring-layer">
                  <p class="ai__scoring-layer-head">{layer.title}</p>
                  {layer.items.map((item) => (
                    <TextList>{item}</TextList>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="personalize" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`Vector 기반 <span class="mark">개인화 프로파일링</span>`}
          description="사용자 행동과 상품 속성을 벡터 공간으로 구조화하여, 유사도 기반 개인화 추천을 구현합니다. 동일 상품이라도 사용자 맥락에 따라 노출 우선순위가 동적으로 재정렬됩니다."
        />
        <p class="ai__diagram-pill">Layer 1 &amp; 2 : 광범위한 탐색과 정교한 취향 매칭</p>
        <div class="ai__personalize-grid">
          <div class="ai__personalize-card">
            <!-- TODO: 아이콘 이미지 삽입 -->
            <span class="ai__icon-ph" aria-hidden="true">
              <Icon name={ICON_KEY_NAME['AI & Machine Learning4-1']} />
            </span>
            <p class="ai__personalize-title">{personalizeCards[0].title}</p>
            <p class="ai__personalize-subtitle">{personalizeCards[0].subtitle}</p>
            <p class="ai__personalize-desc" set:html={personalizeCards[0].desc} />
            <div>
              {personalizeCards[0].items.map((item) => <TextList type="type_2">{item}</TextList>)}
            </div>
          </div>
          <!-- TODO: 이미지 삽입 -->
          <div class="ai__personalize-image ai__thumb-ph" aria-hidden="true">
            <img src={SYMBOL005.src} alt="" />
          </div>
          <div class="ai__personalize-card">
            <!-- TODO: 아이콘 이미지 삽입 -->
            <span class="ai__icon-ph" aria-hidden="true">
              <Icon name={ICON_KEY_NAME['AI & Machine Learning4-2']} />
            </span>
            <p class="ai__personalize-title">{personalizeCards[1].title}</p>
            <p class="ai__personalize-subtitle">{personalizeCards[1].subtitle}</p>
