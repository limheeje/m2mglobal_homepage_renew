---
// e-Commerce > Commerce Technology (/e-commerce/commerce-technology)
// Figma "e-Commerce > Commerce Technology" 4개 프레임(제공기술 및 특징 / 활용 분야 / 주요 고객사 /
// 주요 레퍼런스) — 전부 같은 Tap_series(box 스타일) 앵커 탭의 상태라 한 페이지로 합쳤다.
//
// 참고: "활용 분야" 탭의 "e-Commerce 프레임워크"(프론트(사용자)/핵심기능/백오피스(관리자) 상세 분해)는
// 사용자 요청에 따라 이미지로 대체할 자리만 남기고 세부 구현은 하지 않았다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'

const localNavigation = route.find((item) => item.href === '/e-commerce/commerce-technology')

const sectionTabs = [
  {id: 'features', label: '제공기술 및 특징'},
  {id: 'usage', label: '활용 분야'},
  {id: 'references', label: '주요 레퍼런스'},
  {id: 'clients', label: '주요 고객사'}
]

// --- 제공기술 및 특징 (9개) ---
const featureCards = [
  {
    title: '웹 표준 준수',
    items: [
      '표준 준수 및 검증된 검색기술 (Elastics Search) 적용으로 SEO (Search engine optimization) 구현',
      '고객 구매 패턴 분석을 통한 최적의 마케팅 활용'
    ]
  },
  {
    title: '경영 관리 기능',
    items: [
      'WMS (재고관리), 기초 정보 관리, 전자 세금계산서, 전자 계약 체결 등 폭넓은 ERP 연계',
      '외부시스템 솔루션 연동 탑제를 통해 시간과 비용 절약 효과 (택배사, 인증기관, 제휴사, 검색, SMS, 배송 추천… 연계 시간과 비용)'
    ]
  },
  {
    title: '입점/오픈마켓 구조',
    items: [
      '다양한 셀러 및 정산 관리를 기반으로 종합몰, 오픈 마켓 구축 시 안정적, 원활하게 구축 가능'
    ]
  },
  {
    title: 'B2C, B2B, B2E',
    items: [
      'B2B에 최적화 된 커머스 시스템 제공',
      'B2C에 최적화 된 커머스 시스템 제공',
      'B2E에 최적화 된 커머스 시스템 제공'
    ]
  },
  {
    title: '글로벌 통합 시스템',
    items: [
      'Language, Currency설계, Open API 제공을 통해 국내 외 채널들과 연동하고 국가 언어, 화폐에 따라 반응하는 글로벌 몰을 제공함'
    ]
  },
  {
    title: '모바일',
    items: [
      'IOS, Android 앱 모바일 전시 관리, 프로모션 등 컨텐츠를 관리 및 위치 기반의 컨텐츠 및 알림을 제공하여 최적의 개인화 된 서비스 제공'
    ]
  },
  {
    title: '통계/분석툴 연계 제공',
    items: [
      '방문자, 소비자 활동 수집 해석을 통한 구매율을 높이기 위한 데이터 분석 / 제공',
      '외부 분석 TOOL 연계 제공 가능'
    ]
  },
  {
    title: '보안',
    items: ['웹 보안 시스템 지원', 'ISMS 대응 및 HW / SW / NET 보안 영역까지 컨설팅 제공']
  },
  {
    title: '유연한 커스터마이징',
    items: ['커머스 구축 Case에 따라 특화 된 기능 등 자체 구현 및 제공 가능']
  }
]

// --- 활용 분야 ---
const mallTypes = [
  'B2C 종합 몰',
  'B2C 종합 몰',
  'B2E 기업 몰',
  'B2C 종합 온-오프라인 통합 몰',
  '온-오프라인 통합몰',
  '국내외 전문 몰 제휴 연계',
  '쇼핑몰 솔류션 공급',
  'Mobile Web / App'
]

// --- 주요 레퍼런스 (7건) ---
const references = [
  {
    title: '수협중앙회 쇼핑몰 재구축',
    desc: '바이어와 셀러 간의 반도체 장비, 부품 커머스 기반 거래 플랫폼 설계 및 구현',
    list: [
      '4개 채널 (수협몰/복지몰/공제 사은품/특판)',
      '3개 전문관 (회원조합/바다마트/수산시장)',
      '최신 이커머스 프레임워크 적용, 온라인 통합 플랫폼 구축',
      '오픈마켓 기반의 회원가입/상품등록/주문결제/배송',
      '개인화 추천 등 최신 디지털 기술 적용'
    ]
  },
  {
    title: '농협몰 구축 / 고도화 / 운영',
    desc: '산지직송, 하나로마트배송, 식자재몰, MRO, 제휴연계',
    list: [
      'B2C몰, B2B몰, B2E몰, 콕푸드',
      '현업 관리자시스템(NGIN), 공급업체 관리자시스템(PSCM)',
      '내부시스템 연계 (전자세금계산서, SMS, Push, MCA 등)',
      '대외기관 연계 (농협중앙회, 농협은행, 네이버, 링크프라이스 등)',
      '제휴사 연계 (11번가, G마켓, 옥션, 현대H몰, 무림오피스, 네이버 등)'
    ]
  },
  {
    title: '다이소 커머스 플랫폼 구축',
    desc: '다이소 쇼핑몰을 차세대 플랫폼으로 전면 고도화',
    list: [
      '오프라인 매장의 온라인 옴니 채널 구축',
      '온라인 운영 대상 통합 BO 구축',
      '온라인 주문 시 오프라인 상품 피킹 시스템 구현',
      '클라우드 인프라 도입을 통한 안정성을 확보한 시스템 구축',
      '모바일 시스템 구축'
    ]
  },
  {
    title: 'C2C 직거래플랫폼 구축',
    desc: 'Kcar.com 개인간 중고차 안심 직거래 서비스 추가 개발',
    list: [
      '실차주 인증 기반, 매물직거래',
      '보험 정비 / 사고 이력 공개',
      '직거래 품질인증 / 개인정보보호',
      '온라인 명의이전 제공',
      '직거래 전용 대출 연동',
      '웹, 모바일 구축'
    ]
  },
  {
    title: '롯데ON 통합 EC구축',
    desc: '롯데그룹 6개 이커머스 통합 플랫폼 구축',
    list: [
      '7개 온라인 상거래 서비스의 오픈마켓 기반 단일 서비스 통합 구축',
      '총 21개의 이커머스 업무영역에 대한 기능 구현 (FO/BO통합)',
      'MSA 기반 설계 (모듈별 분산처리 및 독립적 개발-운영-배포 구현)',
      '구매자와 판매자 중개플랫폼, 온라인서비스/채널연동',
      '판매자를 위한 특화광고/부가서비스 제공'
    ]
  },
  {
    title: '세마마켓 반도체 거래 플랫폼',
    desc: '바이어와 셀러 간의 반도체 장비, 부품 커머스 기반 거래  플랫폼 설계 및 구현',
    list: [
      'Equipment, Parts, Extras 아이템 구매 기능',
      '셀러 판매자 샵 구축',
      '오퍼, 물류견적 기능',
      '통합 백오피스 구축',
      '모바일 서비스 구축'
    ]
  },
  {
    title: '서린상사 B2B 온라인 플랫폼',
    desc: '비철 금속 B2B거래 플랫폼',
    list: [
      '하이브리드 모바일 기반 비철금속에 특화된 커머스 시스템 기능 구현',
      '주문/결제 (아연라이브, 아연고정가, 주문고도화 및 여신_보증사 보증 연계, 복합결제 등)',
      '상품/회원 (판매고도화, 등급별 회원관리/증거금, 영업/마케팅)',
      'Pricing (라이브대응), 물류/배송 (소량/아연/톤차)',
      '모바일 서비스 구축'
    ]
  }
]

// --- 주요 고객사 (8개, 로고는 이미지로 삽입) ---
const clients = [
  '수협중앙회',
  '다이소',
  '세마마켓',
  '케이카',
  '수협쇼핑',
  '롯데ON',
  '롯데아이몰',
  'e-shop'
]
---

<Layout>
  <SubBanner
    title="e-Commerce"
    description={`Commerce Platform에 속도와 생산성을 높이다.<br/>"Front –BackOffice-Interface" 모듈화 된 e-Commerce 아키텍처! AI와 융합 및 빠른 구축과 확장성을 제공합니다.`}
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-E-COMMERCE-ID-1'} />
  <TitleMain
    title="Commerce Technology"
    description={`&quot;일반 커머스를 비롯 ~ 실시간 시세, 환율, 재고 연동형 거래 및 기업간의 자재, 원자재 거래를 플랫폼으로 구현한 B2B 특화된 커머스 기술력을 보유하고 있습니다.&quot;<br/>「Front ↔ BackOffice ↔ Interface」 상호 간의 최적화 된 e-Commerce 프레임워크 기반 커머스 시스템 제공`}
  />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="features" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`제공 <span class="mark">기술 및 특징</span>`} />
      <div class="ec__feature-grid">
        {
          featureCards.map((card) => (
            <div class="ec__feature-card">
              <div class="ec__feature-head">
                {/* TODO: 아이콘 이미지 삽입 */}
                <span class="ec__feature-icon" aria-hidden="true" />
                <p class="ec__feature-title">{card.title}</p>
              </div>
              <div>
                {card.items.map((item) => (
                  <TextList>{item}</TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="usage" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`활용 <span class="mark">분야</span>`} />
      <div class="ec__tag-row">
        {mallTypes.map((type) => <span class="ec__tag">{type}</span>)}
      </div>

      <!-- TODO: "e-Commerce 프레임워크"(프론트(사용자)/핵심기능/백오피스(관리자)) 다이어그램 이미지 삽입 —
           사용자 요청에 따라 세부 구현은 하지 않고 이미지로 대체 -->
      <div class="ec__diagram-placeholder" aria-hidden="true"></div>
    </div>
  </section>

  <section id="references" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`주요 <span class="mark">레퍼런스</span>`}
        description="다양한 커머스 플랫폼 프로젝트를 성공적으로 수행하며 실행력을 입증했으며, 신뢰할 수 있는 상생 파트너로 자리매김을 했습니다."
      />
      <div class="ec__ref-grid">
        {
          references.map((item) => (
            <div class="ec__ref-card">
              <p class="ec__ref-title">{item.title}</p>
              <p class="ec__ref-desc">{item.desc}</p>
              <div>
                {item.list.map((text) => (
                  <TextList>{text}</TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="clients" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`주요 <span class="mark">고객사</span>`} />
      <div class="ec__client-grid">
        {
          clients.map((name) => (
            <div class="ec__client-card">
              {/* <!-- TODO: 로고 이미지 삽입 --> */}
              {name}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
