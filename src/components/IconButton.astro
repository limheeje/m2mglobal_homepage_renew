---
// IconButton 공통 컴포넌트 — 아이콘만 있는 원형 버튼 (예: 맨 위로 가기 FAB)
// 참고: https://comet-take-17267726.figma.site/button ("top" 버튼)
//
// Figma 실측: 48px 원 안에 24px 아이콘 "프레임"이 있다(지름의 50%) — 프레임 자체는 절반 비율.
// 화살표 그림 자체가 프레임보다 더 작게 그려져 있던 건 아이콘 SVG(ico_arrow_top.svg)의
// viewBox 패딩으로 이미 반영해뒀으므로, 여기서는 "프레임 = 지름의 50%"만 신경 쓰면 된다.
// (16/20/24/32 규칙과 다른 값(28 등)이 나올 수 있어 예외로 문서화한다.)
//
// Figma에서 흰 배경(Default)/네이비 채움(Variant2)이 위아래로 쌓여 있던 것은
// 서로 다른 타입이 아니라 "기본 상태 → hover 상태" 데모였다 — 그래서 variant prop 대신
// :hover 한 종류로 통일했다. 옅은 배경 위에서 항상 강조돼야 하는 경우에만 variant="primary" 사용.
//
// 아이콘 전용 버튼은 시각적 라벨이 없으므로 ariaLabel 필수 (접근성).
//
// 사용 예:
//   <IconButton icon="ico_arrow_top" ariaLabel="맨 위로 가기" />
//   <IconButton icon="ico_arrow_top" variant="primary" ariaLabel="맨 위로 가기" />

import Icon from '~/components/Icon.astro'
import {pxToRem} from '~/utils/rem'

export interface Props {
  icon: string
  ariaLabel: string
  /** default: 흰 배경(hover 시 네이비로 전환) · primary: 항상 네이비 채움 */
  variant?: 'default' | 'primary'
  /** 원 지름(px). 40 / 48 / 56 중에서만 선택 */
  size?: 40 | 48 | 56
  disabled?: boolean
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const {
  icon,
  ariaLabel,
  variant = 'default',
  size = 48,
  disabled = false,
  href,
  type = 'button',
  class: className
} = Astro.props

// Figma 실측: 아이콘 프레임 = 원 지름의 50%.
const iconSize = Math.round(size * 0.5)

const classes = ['icon-btn', `icon-btn--${variant}`, className].filter(Boolean).join(' ')

const Tag = href ? 'a' : 'button'
---

<Tag
  class={classes}
  style={`--icon-btn-size:${pxToRem(size)}`}
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  aria-label={ariaLabel}
>
  <Icon name={icon} size={iconSize} />
</Tag>
