          {
            projectCases.map((item) => (
              <div class="sp-card">
                {/* <!-- TODO: 프로젝트 썸네일 이미지 삽입 --> */}
                <div class="sp-thumb" aria-hidden="true" />
                <p class="sp-title-text">{item.title}</p>
                <div class="sp-list">
                  {item.list.map((text) => (
                    <p>{text}</p>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
