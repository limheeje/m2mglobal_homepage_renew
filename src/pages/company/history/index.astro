              <ul class="company-history__list">
                {left.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            {right && (
              <div class="col-12 col-lg-6 company-history__cell">
                <span class="company-history__year">{right.year}</span>
                <ul class="company-history__list">
                  {right.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div id="archive">
