---
// Footer 공통 컴포넌트
// 참고: https://comet-take-17267726.figma.site/navigation ("Copyright" 섹션)
//
// 다운로드 버튼 2개는 padding(12/24)·radius(pill)·color는 Button md와 동일하지만
// gap 8px·font 15px는 Figma 실측 기준 다르다 — 새 Button 사이즈를 만드는 대신
// Button(variant="primary" size="md") 재사용 + _footer.scss의 `.footer__downloads .btn` 로컬
// override로 정확히 맞춘다(Footer가 이미 쓰던 `.footer__privacy`류 scoped override와 동일 패턴).

// Footer는 어두운 배경이라 GNB의 원색 로고가 아니라 Figma의 별도 화이트 2줄(워드마크+국문 표기)
// 로고 자산을 그대로 쓴다 — 단순 색 반전이 아니라 Figma에 이미 존재하는 별개 export.
import logoUrl from '~/assets/images/m2m-global-logo-white.svg'
import Button from '~/components/Button.astro'
import TextButton from '~/components/TextButton.astro'

export interface Props {
  class?: string
}

const {class: className} = Astro.props
const classes = ['footer', className].filter(Boolean).join(' ')
const year = new Date().getFullYear()
---

<footer class={classes}>
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__info">
        <a href="/" class="footer__logo">
          <img src={logoUrl.src} width="152" height="40" alt="M2M GLOBAL 엠투엠글로벌(주)" />
        </a>
        <div class="footer__contact">
          <p class="footer__address">
            <span>Head Office</span>
            <span class="footer__strong"
              >서울특별시 영등포구 영등포로 150, B동 1509호 (생각공장 당산), 엠투엠글로벌</span
            >
          </p>
          <p class="footer__reach">
            <span class="footer__reach-item"
              ><span>Email</span> <span class="footer__strong">help@m2mglobal.co.kr</span></span
            >
            <span class="footer__reach-item"
              ><span>Tel</span> <span class="footer__strong">02-6956-3955</span></span
            >
          </p>
        </div>
      </div>

      <div class="footer__downloads">
        <Button variant="primary" size="md" icon="ico_download">회사소개서</Button>
        <Button variant="primary" size="md" icon="ico_download">로봇물류 소개서</Button>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">Copyright ⓒ {year} M2M GLOBAL. All rights reserved.</p>
      <TextButton href="/privacy" class="footer__privacy">개인정보처리방침</TextButton>
    </div>
  </div>
</footer>
