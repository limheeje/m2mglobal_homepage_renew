---
// /style-guide 전용 레이아웃 — SubLayout(Gnb/Footer)을 쓰지 않고 완전히 별도로 뺐다.
// 왼쪽 고정(fixed) 사이드바 + 오른쪽 스크롤 콘텐츠의 2단 구조. Layout.astro(전역 <html> 뼈대,
// main.css/전역 스크립트/맨위로가기/AllMenu)는 그대로 재사용 — 이 부분까지 새로 만들 필요는 없음.
import Layout from '~/layouts/Layout.astro'

export interface Props {
  sections: {id: string; label: string}[]
}
const {sections} = Astro.props
---

<Layout>
  <div class="sgl">
    <aside class="sgl__sidebar">
      <a href="#top" class="sgl__brand">
        스타일 가이드
        <span class="sgl__brand-sub">/style-guide</span>
      </a>
      <nav class="sgl__nav">
        {
          sections.map((s) => (
            <a class="sgl__nav-link" href={`#${s.id}`} data-sgl-link={s.id}>
              {s.label}
            </a>
          ))
        }
      </nav>
    </aside>
    <main class="sgl__content" id="top">
      <slot />
    </main>
  </div>

  <script>
    // 사이드바 active 상태 — 지금 보이는 섹션에 해당하는 링크에 is-active를 부여한다.
    // 전역 스크립트(src/scripts/*)로 안 뺀 이유: .sgl__*은 이 페이지에만 존재하는 마크업이라
    // 다른 페이지에 영향 줄 일이 없는 페이지 로컬 스크립트로 충분함.
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-sgl-link]')
    const sections = document.querySelectorAll<HTMLElement>('.sgl__content > section[id]')

    if (links.length && sections.length) {
      const setActive = (id: string) => {
        links.forEach((link) => {
          link.classList.toggle('is-active', link.dataset.sglLink === id)
        })
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActive(entry.target.id)
          })
        },
        {rootMargin: '-15% 0px -70% 0px', threshold: 0}
      )
      sections.forEach((section) => observer.observe(section))
    }
  </script>
</Layout>
