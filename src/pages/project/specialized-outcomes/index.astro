---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Project"
      description={`"전문 구축 경험 · 산업별 커스터마이징 · B2B 특화 솔루션 · 검증된 성과 · 높은 재계약률"<br/>24년간 꾸준히 수행해온 프로젝트가 엠투엠글로벌의 경쟁력을 입증합니다.`}
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-PROJECT-ID-2'} />
    <TitleMain
      title="Specialized Outcomes"
      description={`“일반 커머스(B2C쇼핑몰)를 비롯~실시간 시세, 환율, 재고 연동형 거래 및 기업간의 대규모 자재, 원자재 거래” 실거래 수준으로 구현 및 AI Commerce 통해 거래·추천·분석까지 AI Commerce로 확장 적용 가능한 유일한 B2B 특화 Commerce 경험을 보유한 플랫폼 전문 기업.`}
    />

    <div class="innerWrap">
      <div class="bs-tab-group">
        {
          sectionTabs.map((tab, i) => (
            <a
              class="bs-tab tab__item"
              class:list={{'is-active': i === 0}}
              data-type="box"
              href={`#${tab.id}`}
            >
              {tab.label}
            </a>
          ))
        }
      </div>
    </div>

    <section id="overview" class="g-section">
      <div class="innerWrap">
        <!-- TODO: 원형/네트워크 그래픽 이미지 삽입 -->
        <div class="spec__banner-diagram" aria-hidden="true">
          <img src={SYMBOL029.src} alt="" />
        </div>

        <TitleMiddle>Why M2M GLOBAL? 특별한 성과가 차이를 만듭니다.</TitleMiddle>

        <div class="spec__case-grid">
          {
            overviewCases.map((item) => {
              const logo = logoSrc(item.logoKey)
              return (
                <div class="spec__case-card">
                  <div class="spec__case-head">
                    {/* <!-- TODO: 로고 이미지 삽입 --> */}
                    <span class="spec__case-logo-ph" aria-hidden="true">
                      <img src={logo} alt="" />
                    </span>
                    <p class="spec__case-name">{item.name}</p>
                  </div>
                  <div class="spec__case-list">
                    {item.items.map((text) => (
                      <TextList type="type_1">{text}</TextList>
                    ))}
                  </div>
                  <p class="spec__case-footer">{item.footer}</p>
                </div>
              )
            })
          }
        </div>
      </div>
    </section>

    <section id="semimarket" class="g-section">
      <div class="innerWrap">
        <TitleSub title={`<span class="mark">Semimarket</span>`} />
        <div class="spec__row-grid">
          {
            semimarketRows.map((row) => (
              <div class="spec__row">
                <div class="spec__row-box">
                  <div class="spec__row-label">
                    {/* TODO: 아이콘 이미지 삽입 */}
                    <span
                      class="spec__row-icon-ph"
                      class:list={`ico-${row.icon}`}
                      aria-hidden="true"
                    />
                    <p set:html={row.label.replace('\n', '<br/>')} />
                  </div>
                  <div class="spec__row-summary">
                    {row.summary.map((text) => (
                      <TextList type="type_1">{text}</TextList>
                    ))}
                  </div>
                </div>
                <span class="spec__row-arrow" aria-hidden="true">
                  <img src={stepArrowUrl.src} alt="" />
                </span>
                <div class="spec__row-list">
                  {row.items.map((text) => (
                    <TextList type="type_1">{text}</TextList>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <TitleSub title={`특별한 <span class="mark">성과</span>`} />
        <div class="spec__gallery-grid">
          {
            semimarketGalleryCaptions.map((caption) => (
              <div class="spec__gallery-card">
                {/* TODO: 앱 화면 스크린샷 이미지 삽입 */}
                <div class="spec__gallery-ph" aria-hidden="true">
                  <img src={caption.imgSrc} alt="" />
                </div>
                <TitleThird>{caption.title}</TitleThird>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="sorin" class="g-section">
      <div class="innerWrap">
        <TitleSub title={`<span class="mark">SORIN</span>`} />
        <div class="spec__row-grid">
          {
            sorinRows.map((row) => (
              <div class="spec__row">
                <div class="spec__row-box">
                  <div class="spec__row-label">
                    {/* TODO: 아이콘 이미지 삽입 */}
                    <span
                      class="spec__row-icon-ph"
                      class:list={`ico-${row.icon}`}
                      aria-hidden="true"
                    />
                    <p set:html={row.label.replace('\n', '<br/>')} />
                  </div>
                  <div class="spec__row-summary">
                    {row.summary.map((text) => (
                      <TextList type="type_1">{text}</TextList>
                    ))}
                  </div>
                </div>
                <span class="spec__row-arrow" aria-hidden="true">
                  <img src={stepArrowUrl.src} alt="" />
                </span>
                <div class="spec__row-list">
                  {row.items.map((text) => (
                    <TextList type="type_1">{text}</TextList>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <TitleSub title={`특별한 <span class="mark">성과</span>`} />
        <div class="spec__gallery-grid">
          {
            sorinGalleryCaptions.map((caption) => (
              <div class="spec__gallery-card">
                {/* TODO: 앱 화면 스크린샷 이미지 삽입 */}
                <div class="spec__gallery-ph" aria-hidden="true">
                  <img src={caption.imgSrc} alt="" />
                </div>
                <TitleThird>{caption.title}</TitleThird>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CaseStudySection id="cj" />
  </div>
</Layout>
