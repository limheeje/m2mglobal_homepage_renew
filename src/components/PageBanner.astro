---
// PageBanner — GNB 바로 아래에 오는 서브페이지 공통 상단 배너
// 참고: https://comet-take-17267726.figma.site/navigation ("Header" 섹션, property1=About us 등)
//
// Figma 원본은 GNB(80px)가 배너 위에 absolute로 겹쳐 있는 구조라 배너 프레임 자체 높이가
// 273px(GNB 높이 포함)였지만, 실제 페이지 조합에서는 <Gnb />를 이 컴포넌트 "위에" 일반 흐름으로
// 배치하므로 GNB 높이만큼의 상단 padding은 제외하고 순수 배너 영역만 옮겼다.
//
// 배경: Secondary color(#171d48) 위에 네트워크 패턴 이미지를 20% 투명도로 오버레이.
// breadcrumb는 참고 인스턴스(Company 페이지)에서 hidden 상태였지만 컴포넌트 구조상 존재해서
// optional prop으로 살려뒀다 — 필요한 페이지에서만 넘기면 됨.
//
// 사용 예:
//   <PageBanner
//     title="Company"
//     subtitle={['Where AI Transformation Begins—Turning Market Change into Speed and Direction', '24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner']}
//     breadcrumb={[{label: 'About us', href: '/company'}, {label: '2Depth'}]}
//   />

import patternUrl from '~/assets/images/subpage-banner-pattern.png'
import Icon from '~/components/Icon.astro'

export interface Props {
  title: string
  /** 줄 단위 배열(최대 2줄) */
  subtitle?: string[]
  /** 배경 패턴 이미지 — 지정 없으면 Figma 기본 네트워크 패턴 사용 */
  image?: string
  /** 마지막 항목은 보통 현재 페이지(링크 없음) */
  breadcrumb?: {label: string; href?: string}[]
  class?: string
}

const {
  title,
  subtitle = [],
  image = patternUrl.src,
  breadcrumb = [],
  class: className
} = Astro.props

const classes = ['page-banner', className].filter(Boolean).join(' ')
---

<div class={classes}>
  <img class="page-banner__bg" src={image} alt="" aria-hidden="true" />

  <div class="page-banner__content">
    <p class="page-banner__title">{title}</p>
    {
      subtitle.length > 0 && (
        <div class="page-banner__subtitle">
          {subtitle.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      )
    }
  </div>

  {
    breadcrumb.length > 0 && (
      <nav class="page-banner__breadcrumb" aria-label="현재 위치">
        <Icon name="ico_home" size={24} />
        {breadcrumb.map((item, i) => (
          <>
            {i > 0 && <Icon name="ico_chevron_right" size={10} />}
            {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
          </>
        ))}
      </nav>
    )
  }
</div>
