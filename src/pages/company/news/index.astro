---

<Layout>
  <Gnb />

  <PageBanner
    title="Company"
    subtitle={[
      'Where AI Transformation Begins—Turning Market Change into Speed and Direction',
      '24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner'
    ]}
  />

  <Tab variant="line" size="large" items={tabs} activeIndex={4} />

  <Title variant="hero" title="News" />

  <Container maxWidth={1760} class="company-page-end">
    <div class="company-news__list">
      {
        newsItems.map((item) => (
          <div class="company-news__row">
            <div class="company-news__row-main">
              <span class="company-news__tag">{item.tag}</span>
              <p class="company-news__title">{item.title}</p>
              <span class="company-news__date">{item.date}</span>
            </div>
            <Button
              variant="secondary"
              size="md"
              icon="ico_external_link"
              href={item.href ?? undefined}
              target={item.href ? '_blank' : undefined}
              disabled={!item.href}
              class="company-news__link"
            >
              바로가기
            </Button>
          </div>
        ))
      }
    </div>

    <div class="company-news__clients">
      {
        clientCategories.map((category) => (
          <div class="company-news__client-category">
            <Title
              variant="section"
              highlight={category.title}
              class="company-news__category-title"
            />
            <div class="company-news__client-grid">
              {category.clients.map((client) => (
                <div class="company-news__client-card">
                  <img src={logoSrc(client.key)} alt={client.name} loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Container>

  <Footer />
</Layout>
