---
// Robot Logistics > 로봇 물류 플랫폼 (/robot-logistics/overview)
// Figma "Robot Logistics > 로봇 물류 플랫폼" 9개 프레임(M2M-RLCK 개요 / RLCK 구현 로봇 / 시스템구성 /
// 로봇물류제어기술 / 인프라구성 / 소프트웨어 구성 / 시뮬레이션 / 스케줄링·경로계획·영역제어 / 구축사례)
// — 전부 같은 Tap_box_series 앵커 탭의 상태라 한 페이지로 합쳤다.
import {route} from '@config/route'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import TitleThird from '~/components/common/TitleThird.astro'
import ImagePlaceholder from '~/components/common/ImagePlaceholder.astro'
import IconTitle from '~/components/common/IconTitle.astro'
import Navigation from '~/components/common/Navigation.astro'
