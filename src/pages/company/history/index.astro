// Figma 원본은 연도가 2열로 짝지어 배치돼있다(예: 2025+2024가 한 줄).
function pairUp<T>(list: T[]): [T, T | null][] {
  const pairs: [T, T | null][] = []
  for (let i = 0; i < list.length; i += 2) {
    pairs.push([list[i], list[i + 1] ?? null])
  }
  return pairs
}
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>다년 간의 경험과 전문성을 겸비한 인력과 AI가 한 팀이 되어, 고객 비즈니스의 성공을 위해 끊임없이 실행하고 성장합니다."
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-3'} />
    <TitleMain
      title="회사 연혁"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>다년 간의 경험과 전문성을 겸비한 인력과 AI가 한 팀이 되어, 고객 비즈니스의 성공을 위해 끊임없이 실행하고 성장합니다. (고용노동부 지정 청년친화 강소기업)"
    />

    <section class="g-section">
      <div class="innerWrap">
        <TitleSub title={`History`} />

        <div class="company__history-year-tabs" id="historyYearTabs">
          {
            yearTabs.map((tab, i) => (
              <a
                class="company__history-tab"
                class:list={{'is-active': i === 0}}
                data-target={tab.id}
                href={`#${tab.id}`}
              >
                {tab.label}
              </a>
            ))
          }
        </div>

        <div id="recent" class="company__history-panel is-active">
          {
            pairUp(recentYears).map(([left, right], i, arr) => (
              <div class="company__history-row" class:list={{'is-last': i === arr.length - 1}}>
                <div class="company__history-cell">
                  <span class="company__history-year">{left.year}</span>
                  <ul class="company__history-list">
                    {left.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                {right && (
                  <div class="company__history-cell">
                    <span class="company__history-year">{right.year}</span>
                    <ul class="company__history-list">
                      {right.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))
          }
        </div>

        <div id="archive" class="company__history-panel">
          {
            pairUp(archiveYears).map(([left, right], i, arr) => (
              <div class="company__history-row" class:list={{'is-last': i === arr.length - 1}}>
                <div class="company__history-cell">
                  <span class="company__history-year">{left.year}</span>
                  <ul class="company__history-list">
                    {left.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                {right && (
                  <div class="company__history-cell">
                    <span class="company__history-year">{right.year}</span>
                    <ul class="company__history-list">
                      {right.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // 이 페이지의 연도 구간 탭만 앵커-스크롤이 아니라 진짜 탭(show/hide)처럼 동작한다.
  function initHistoryTabs() {
    const wrap = document.getElementById('historyYearTabs')
    if (!wrap) return
    const tabs = wrap.querySelectorAll<HTMLAnchorElement>('.company__history-tab')

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault()
        const target = tab.dataset.target
        if (!target) return

        tabs.forEach((t) => t.classList.toggle('is-active', t === tab))
        document.querySelectorAll('.company__history-panel').forEach((panel) => {
          panel.classList.toggle('is-active', panel.id === target)
        })
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHistoryTabs)
  } else {
    initHistoryTabs()
  }
</script>
