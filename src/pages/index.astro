<Layout>
  <div class="main-wrap">
    <!-- Section 1: Main slogan -->
    <div class="section1-slide">
      {
        mainSlides.map((slide) => (
          <div class="section-item">
            {/* <!-- TODO: 슬라이드 배경 이미지 삽입 (인라인 style="background-image:url(...)") --> */}
            <div class="content-inner">
              <div class="b-texts">
                <div class="b-title" set:html={slide.title} />
                {slide.desc && <div class="b-desc" set:html={slide.desc} />}
                {slide.caption && <div class="b-caption" set:html={slide.caption} />}
                {slide.list && (
                  <div class="b-list">
                    {slide.list.map((li) => (
                      <div class="b-li">{li}</div>
                    ))}
                  </div>
                )}
              </div>
              <a href="#" class="ad-more">
                Read More
              </a>

              {slide.diagram && (
                <div class="b-diagram">
                  <div class="b-diagram-node b-diagram-node--tl">
                    <span>
                      <strong>후보군 생성</strong>(Candidate Generation)
                    </span>
                  </div>
                  <div class="b-diagram-node b-diagram-node--tr">
                    <span>
                      <strong>AI 스코어링</strong>(AI Scoring)
                    </span>
                  </div>
                  <div class="b-diagram-node b-diagram-node--bl">
                    <span>
                      <strong>비즈니스 룰 적용</strong>(Business Rules)
                    </span>
                  </div>
                  <div class="b-diagram-node b-diagram-node--br">
                    <span>
                      <strong>최종 랭킹</strong>(Ranking & Optimization)
                    </span>
                  </div>
                  <div class="b-diagram-node b-diagram-node--center">AI Commerce</div>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Section 2: 사업정보 -->
    <div class="section2-slide">
      {
        bizSlides.map((slide) => (
          <div class="section-item">
            {/* <!-- TODO: 슬라이드 배경 이미지 삽입 --> */}
            <div class="content-inner">
              <p class="biz-eyebrow">M2MGLOBAL Biz</p>
              <div class="biz-core">
                {slide.coreTitle}
                <br />
                <span>{slide.coreSub}</span>
              </div>
              <div class="biz-grid">
                {slide.cards.map((card) => (
                  <div class="biz-card">
                    <p class="biz-card-title">{card.title}</p>
                    <p class="biz-card-desc" set:html={card.desc} />
                  </div>
                ))}
              </div>
            </div>
            <a href="#" class="ad-more">
              Read More
            </a>
          </div>
        ))
      }
    </div>

    <!-- Section 3: AI -->
    <div class="section3-slide">
      {
        aiSlides.map((slide) => (
          <div class="section-item">
            <p class="ai-eyebrow">{slide.eyebrow}</p>
            <p class="ai-head">{slide.head}</p>
            <div class="ai-banner">
              <p class="ai-banner-title">{slide.bannerTitle}</p>
              <p class="ai-banner-desc" set:html={slide.bannerDesc} />
            </div>
            <div class="ai-flow">
              {slide.flow.map((node) => (
                <div class:list={['ai-flow-node', {'ai-flow-node--accent': node.accent}]}>
                  {node.sub ? (
                    <span>
                      <strong>{node.title}</strong>
                      <span set:html={node.sub} />
                    </span>
                  ) : (
                    node.title
                  )}
                </div>
              ))}
            </div>
            {slide.cols && (
              <div class="ai-cols">
                {slide.cols.map((col) => (
                  <div class="ai-col">
                    <p class="ai-col-title">{col.title}</p>
                    <p class="ai-col-desc" set:html={col.desc} />
                  </div>
                ))}
              </div>
            )}
            {slide.footer && (
              <div class="ai-cols">
                <div class="ai-col">
                  <p class="ai-col-title">{slide.footer}</p>
                  <p class="ai-col-desc">{slide.footerCaption}</p>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>

