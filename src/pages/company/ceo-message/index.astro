---
// Company > CEO 인사말 (/company/ceo-message)
// 참고: Figma "About us > CEO인사말" 프레임(node 211:2235)
// 예전 구(舊) 컴포넌트(PageBanner/Title/Container/Box/IconCircle) 참조로 깨져있던 페이지를
// 현재 공용 컴포넌트(SubBanner/Navigation/TitleMain/TitleSub)로 재구축 — 콘텐츠는 그대로 유지.
import {route} from '@config/route'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import Navigation from '~/components/common/Navigation.astro'
import Box from '~/components/common/Box.astro'
import BoxTitleCase2 from '~/components/ui/box/boxTitleCase/BoxTitleCase2.astro'
import IconTitle from '~/components/common/IconTitle.astro'
import stepArrowUrl from '~/assets/images/step-arrow.svg'
import {ICON_KEY_NAME} from '~/constants/Icon'
const localNavigation = route.find((item) => item.href === '/company/info')

const steps = [
  {label: 'Step 1', title: '프로젝트 수행 의도'},
  {label: 'Step 2', title: '실제 플랫폼 이용자에 대한 이해'},
  {label: 'Step 3', title: '발주사의 지속 가능한 수익 모델 창출'}
]

const values = [
  {
    codeIcon: ICON_KEY_NAME['CEP 인사말1'],
    codeContent: '시대의 흐름을 읽고<br/> 변화와 혁신으로 발전하는 <br/>회사'
  },
  {
    codeIcon: ICON_KEY_NAME['CEP 인사말2'],
    codeContent:
      '고객의 가치를 우선시하고, <br/>끝까지 완성도 있게 함께 완수하는 <br/>신뢰 받는 회사'
  },
  {
    codeIcon: ICON_KEY_NAME['CEP 인사말3'],
    codeContent:
      '고도의 기술력과 성공적인 프로젝트 <br/>완수를 통해 실제 성취에 자부심을<br/> 느끼는 회사'
  },
  {
    codeIcon: ICON_KEY_NAME['CEP 인사말4'],
    codeContent:
      '임직원 개개인의 성취와 발전을 위해 <br/>함께 생각을 나누고 도움을 주는<br/> 즐거운 회사'
  }
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="Where AI Transformation Begins—Turning Market Change into Speed and Direction<br/>24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner"
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-2'} />
    <TitleMain title="CEO 인사말" />

    <section class="g-section">
      <div class="innerWrap">
        <p class="company__ceo-intro">
          엠투엠글로벌은 프로젝트 수행에 있어 세 가지 본질적인 흐름을 최우선 가치로 삼고 있습니다.
        </p>
        <div class="company__ceo-steps">
          {
            steps.map((step, i) => (
              <>
                <Box>
                  <BoxTitleCase2 label={step.label} title={step.title} tight />
                </Box>
                {i < steps.length - 1 && (
                  <span class="company__ceo-step-arrow" aria-hidden="true">
                    <img src={stepArrowUrl.src} alt="" />
                  </span>
                )}
              </>
            ))
          }
        </div>

        <div class="company__ceo-quote">
          <p class="company__ceo-quote-text">
            AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br />
            다년 간의 경험과 전문성을 겸비한 인력과 AI가 한 팀이 되어, 고객 비즈니스의 성공을 위해 끊임없이
            실행하고 성장합니다.
          </p>
          <p class="company__ceo-quote-sign">
            대표이사 <strong>김 승 원</strong>
          </p>
        </div>

        <div class="company__ceo-values">
          {
            values.map((item) => (
              <div class="company__ceo-value">
                <IconTitle icon={item.codeIcon} title={item.codeContent} />
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
