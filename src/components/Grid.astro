---
// Grid 공통 컴포넌트 — 스펙/비교용 테이블(표) 또는 key-value 리스트
// 참고: https://comet-take-17267726.figma.site/data-display ("Grid" 섹션)
//
// variant="table": 헤더 행 + 데이터 행으로 구성된 일반 표 (Grid Set Case1)
// variant="spec": 라벨 + 값 한 쌍으로 구성된 스펙 리스트 (Grid Set Case2)
//
// 사용 예:
//   <Grid variant="table" columns={['제조사','모델','유형','용도']} rows={[['LG','Cloi','AMR','피킹']]} />
//   <Grid variant="spec" spec={[{label:'Length', value:'L950*W702*H275 mm'}]} />

export interface Props {
  variant?: 'table' | 'spec'
  /** sm: py12 · md: py20 · lg: py40 (셀 세로 padding) */
  size?: 'sm' | 'md' | 'lg'
  /** variant="table" 전용 헤더 라벨 */
  columns?: string[]
  /** variant="table" 전용 데이터 행 */
  rows?: string[][]
  /** variant="spec" 전용 라벨/값 쌍 */
  spec?: {label: string; value: string}[]
  class?: string
}

const {
  variant = 'table',
  size = 'sm',
  columns = [],
  rows = [],
  spec = [],
  class: className
} = Astro.props

const classes = ['grid-table', `grid-table--${size}`, className].filter(Boolean).join(' ')
---

<div class={classes}>
  {
    variant === 'table' && (
      <>
        {columns.length > 0 && (
          <div class="grid-table__row grid-table__row--head">
            {columns.map((col) => (
              <div class="grid-table__cell grid-table__cell--th">{col}</div>
            ))}
          </div>
        )}
        {rows.map((row) => (
          <div class="grid-table__row">
            {row.map((cell) => (
              <div class="grid-table__cell">{cell}</div>
            ))}
          </div>
        ))}
      </>
    )
  }

  {
    variant === 'spec' &&
      spec.map((item) => (
        <div class="grid-table__row">
          <div class="grid-table__label">{item.label}</div>
          <div class="grid-table__value">{item.value}</div>
        </div>
      ))
  }
</div>
