<MainLayout>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${PUBLIC_BUILD_URL}/css/jquery.fullpage.min.css`} />
    <link rel="stylesheet" href={`${PUBLIC_BUILD_URL}/css/swiper.min.css`} />
  </Fragment>
  <div id="fullpage" class="main-wrap">
    <!-- Section 1: Main slogan -->
    <div class="section1-slide js-swiper swiper section">
      <div class="swiper-wrapper">
        {
          mainSlides.map((slide) => (
            <div
              class="section-item swiper-slide"
              style={`background-image:url(${mainImgSrc(slide.bg)})`}
            >
              <div class="content-inner">
                <div class="b-texts">
                  <div class="b-title" set:html={slide.title} />
                  {slide.desc && <div class="b-desc" set:html={slide.desc} />}
                  {slide.caption && <div class="b-caption" set:html={slide.caption} />}
                  {slide.list && (
                    <div class="b-list">
                      {slide.list.map((li) => (
                        <div class="b-li">{li}</div>
                      ))}
                    </div>
                  )}
                </div>

                {slide.diagram && (
                  <div class="b-diagram">
                    <div class="b-diagram-node b-diagram-node--tl">
                      <span>
                        <strong>후보군 생성</strong>(Candidate Generation)
                      </span>
                    </div>
                    <div class="b-diagram-node b-diagram-node--tr">
                      <span>
                        <strong>AI 스코어링</strong>(AI Scoring)
                      </span>
                    </div>
                    <div class="b-diagram-node b-diagram-node--bl">
                      <span>
                        <strong>비즈니스 룰 적용</strong>(Business Rules)
                      </span>
                    </div>
                    <div class="b-diagram-node b-diagram-node--br">
                      <span>
                        <strong>최종 랭킹</strong>(Ranking & Optimization)
                      </span>
                    </div>
                    <div class="b-diagram-node b-diagram-node--center">AI Commerce</div>
                  </div>
                )}
              </div>
              {/* Figma 실측(node 1714:29424 등 4개 슬라이드 전부): content-inner 좌측 하단 CTA —
                   기존엔 마크업 누락으로 렌더링 안 되고 있었음(.ad-more CSS는 이미 있었음) */}
            </div>
          ))
        }
      </div>
      <div class="swiper-pagination"></div>
      {
        /* Figma 실측: 첫 섹션 하단 가운데 스크롤 유도 마우스 아이콘 — CSS 애니메이션(휠이 흐르는 효과) */
      }
      <div class="scroll-mouse" aria-hidden="true"></div>
    </div>

    <!-- Section 2: 사업정보 -->
    <div class="section2-slide js-swiper swiper section">
      <div class="swiper-wrapper">
        {
          bizSlides.map((slide) => (
            <div class="section-item swiper-slide">
              <div class="content-inner">
                <p class="biz-eyebrow">M2MGLOBAL Biz</p>
                <div class="biz-core">
                  <div class="biz-core-text">
                    <p>{slide.coreTitle}</p>
                    <p class="accent">{slide.coreSub}</p>
                  </div>
                </div>
                <img class="biz-connector" src={mainIconSrc('biz-connector-lines')} alt="" />
                <div class="biz-grid">
                  {slide.cards.map((card) => (
                    <div class="biz-card">
                      <p class="biz-card-title">{card.title}</p>
