---
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import Navigation from '~/components/common/Navigation.astro'
import Icon from '~/components/common/Icon.astro'
import TextList from '~/components/common/TextList.astro'
import Button from '~/components/common/Button.astro'
import UiBoxCase2 from '~/components/ui/box/UiBoxCase2.astro'
import UiBoxCase3 from '~/components/ui/box/UiBoxCase3.astro'
import UiTags from '~/components/ui/box/UiTags.astro'
import BoxTitleCase4 from '~/components/ui/box/boxTitleCase/BoxTitleCase4.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'

const localNavigation = route.find((item) => item.href === '/company/info')
const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL
// --- General Overview: POINT 1~5 (플랫폼 구축 역량 강점) ---
const localDataCompany = [
  {
    label: 'POINT 1',
    title: '플랫폼 전문<br/>구축 역량',
    content: `
    <span class="mark">이커머스, 물류, 클라우드, AI, 모바일</span> 등 다양한 산업 분야에서
    <span class="mark">20년 이상 축적</span>된 노하우와 성과를 보유한 전문 기업
    `
  },
  {
    label: 'POINT 2',
    title: '차별화 된<br/>기술력',
    content: `
    <span class="mark">로봇 물류</span>와 글로벌 <span class="mark">무역 플랫폼</span> 등 복잡한 프로젝트를<br/>성공적으로 구현해온 기술 선도 기업
    `
  },
  {
    label: 'POINT 3',
    title: 'B2B 특화 커머스 플랫폼<br/>구축 경험을 보유한 유일 기업',
    content: `
    실거래 수준의 플랫폼 완성도와 <span class="mark">99% 재계약률</span>로 신뢰를 입증한 <span class="mark">B2B 산업재 플랫폼 리더</span>
    `
  },
  {
    label: 'POINT 4',
    title: '고객 중심의<br/>철학',
    content: `
    고객의 성공을 최우선으로 생각하며, <span class="mark">완성도 있는 결과</span>로 <span class="mark">함께 성장</span>하는 믿음직한 기업
    `
  },
  {
    label: 'POINT 5',
    title: '함께 성장하는<br/>든든한 파트너',
    content: `
    <span class="mark">전문 인력</span>과 <span class="mark">축적된 노하우</span>로 귀사의 성공을 함께 완성하는 믿음직한 파트너
    `
  }
]

// --- 숫자로 보는 M2M GLOBAL ---
const statsData = [
  {value: '24', unit: '년', label: 'M2M GLOBAL 업력'},
  {value: '93', unit: '%', label: 'IT 전문 인력 비율'},
  {value: '130', unit: '+', label: '수행 프로젝트'},
  {value: '17', unit: '개', label: '자체 개발 솔루션'},
  {value: '09', unit: '개', label: '수상 및 인증현황'},
  {value: '73', unit: '명', label: '직원 수'},
  {value: '35', unit: '+', label: '주요 고객사 수'},
  {value: '12', unit: '개', label: '물류/무역/커머스 솔루션'}
]

// --- Specialized Outcomes ①: 사업영역 하이라이트 ---
const businessAreas = [
  {
    icon: 'Business1-1',
    title: 'e-Commerce',
    desc: '다년간의 프로젝트 경험과 노하우를 바탕으로 안정적인 e-Commerce 프레임워크 제공 (Web, Admin, Mobile)',
    items: [
      '수협중앙회 쇼핑몰 재구축',
      '세마마켓 반도체 거래 플랫폼',
      '다이소 쇼핑몰',
      '서린상사 B2B 온라인 플랫폼',
      '농협 온라인 쇼핑몰'
    ]
  },
  {
    icon: 'Business1-2',
    title: 'AI & Machine Learning',
    desc: '데이터 수집부터 운영 모니터링까지 전 주기를 지원하는 End-to-End AI 파이프라인을 통해 다양한 AI 서비스를 효율적으로 제공',
    items: ['KCar C2C 프로젝트', '수협중앙회 쇼핑몰 재구축', '세마마켓 반도체 거래 플랫폼']
  },
  {
    icon: 'Business1-3',
    title: 'Robot Logistics',
    desc: 'AGV/AWR 기반 로봇 통합 관제 및 실시간 모니터링을 통한 택배 물류 센터 자동화 관리 플랫폼 구축/운영',
    items: [
      '세마마켓 반도체 물류 시스템',
      'CJ 대한통운 로봇관제시스템 3차',
      'CJ 대한통운 로봇관제시스템 2차',
      'CJ 대한통운 로봇관제시스템 1차'
    ]
  },
  {
    icon: 'Business1-4',
    title: 'Smart Factory',
    desc: '"생산 현장 데이터를 실시간 수집/가공/분석"을 통한 자율공장 실현이 가능한 지능화 된 스마트 팩토리 제공',
    items: ['금호폴리캠 MES 시스템', '씨에스윈드 MES시스템', '디에이치라이팅 MES 시스템']
  }
]

// --- Specialized Outcomes ②: B2B 특화 커머스 레퍼런스 3건 ---
const caseStudies = [
  {
    href: '/project/specialized-outcomes/#cj',
    label: '재계약율 100%',
    title: 'CJ 대한통운 로봇물류',
    prefix: '1차 / 2차 / 3차',
    list: ['21년 ~ 23년 계약', '웹 / 태블릿 / 갤럭시워치 / PDA', '구축 / 운영'],
    tags: ['로봇', '통합관제', '모니터링', '위치 정보', '정보 관리', '작업관리']
  },
  {
    href: '/project/specialized-outcomes/#semimarket',
    label: '재계약율 100%',
    title: '중고 반도체 거래 플랫폼',
    prefix: '1차 / 2차',
    list: ['24년 ~ 26년 계약', '웹 / 어드민 / 모바일', '구축 / 운영 / 컨설팅'],
    tags: ['셀러,바이어', 'Seller 입점몰', '입찰 구매', '오퍼 구매', '견적 구매']
  },
  {
    href: '/project/specialized-outcomes/#sorin',
    label: '재계약율 100%',
    title: '비철 / 금속 거래 플랫폼',
    prefix: '1차 / 2차 / 3차',
    list: ['21년 ~ 23년 계약', '웹 / 어드민 / 모바일', '구축 / 운영 / 컨설팅'],
    tags: [
      '알루미늄, 아연, 주석…',
      '실시간 라이브가격 구매/차트 제공',
      '평균가 구매, 지정가 구매 # 구매 입찰 # 견적 구매',
      '선물거래, 수출입 대행 구축'
    ]
  }
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="Where AI Transformation Begins—Turning Market Change into Speed and Direction<br/>24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner"
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-1'} />
    <TitleMain title="회사 개요" />

    <section class="g-section">
      <div class="innerWrap">
        <TitleSub title={`M2MGLOBAL<span class="mark"> 회사 개요</span>`} />
        <div class="g-container">
          <div class="g-row g-row-cols-1 g-row-cols-md-5">
            {
              localDataCompany.map((item) => (
                <div class="g-col">
                  <UiBoxCase2 label={item.label} title={item.title} set:html={item.content} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="g-section">
      <div class="innerWrap">
        <TitleSub title={`General <span class="mark">Overview</span>`} />
        <div class="company__info">
          <div class="company__info-row">
            <div class="company__info-cell">
              <span class="company__info-label">회사명</span>
              <span class="company__info-value">엠투엠글로벌㈜</span>
            </div>
            <div class="company__info-cell">
              <span class="company__info-label">대표이사</span>
              <span class="company__info-value">김승원 대표</span>
            </div>
          </div>
          <div class="company__info-row">
            <div class="company__info-cell">
              <span class="company__info-label">설립일</span>
              <span class="company__info-value">
                엠투엠글로벌㈜ 설립 : 2002년 1월<br />
                샵피온㈜ 사업 분사 : 2004년 1월
              </span>
            </div>
            <div class="company__info-cell">
              <span class="company__info-label">인원</span>
              <span class="company__info-value">73명</span>
            </div>
          </div>
          <div class="company__info-row">
            <div class="company__info-cell">
              <span class="company__info-label">주소</span>
              <span class="company__info-value"
                >서울특별시 영등포구 영등포로 150, B동 1509호 생각공장 당산</span
              >
            </div>
            <div class="company__info-cell">
              <span class="company__info-label">연락처</span>
              <span class="company__info-value company__info-value--inline">
                Tel : 02) 6956-3955 / Email : help@m2mglobal.co.kr
                <!-- TODO: 메일 아이콘 이미지 삽입 -->
                <span class="company__icon-ph ico-mail" aria-hidden="true"></span>
              </span>
            </div>
          </div>
          <div class="company__info-row">
            <div class="company__info-cell company__info-cell--full">
              <span class="company__info-label">주요사업</span>
              <span class="company__info-value"
                >이커머스 플랫폼 구축 / 로봇 물류 플랫폼 구축 / 무역 물류 플랫폼 구축 / 축산 경매
                플랫폼 구축 / 클라우드, AI 솔루션 공급</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="company__stats">
      <div class="innerWrap">
        <div class="company__stats-inner">
          <div class="company__stats-label">
            <!-- TODO: 트로피 아이콘 이미지 삽입 -->
            <span class="company__icon-ph ico-crow company__icon-ph--lg" aria-hidden="true"></span>
            <p>숫자로 보는<br />M2M GLOBAL</p>
          </div>
          <div class="company__stats-grid">
            {
              statsData.map((item) => (
                <div class="company__stats-card">
                  <p class="company__stats-num">
                    <span>{item.value}</span>
                    <span class="unit">{item.unit}</span>
                  </p>
                  <p class="company__stats-desc">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="g-section">
      <div class="innerWrap">
        <TitleMain
          title="Specialized Outcomes"
          description={`AI 기반 비즈니스 혁신을 현실로 만드는 엠투엠글로벌입니다.<br/>AI & Machine Learning / AI Commerce Platform / AI Robot & Logistics Knowledge`}
        />
        <div class="company__business-divider">
          <span>M2M <b>GLOBAL</b></span>
        </div>
        <div class="company__business-grid">
          {
            businessAreas.map((area) => (
              <div class="company__business-card">
                <span class="company__business-icon">
                  <Icon name={ICON_KEY_NAME[area.icon as keyof typeof ICON_KEY_NAME]} />
                </span>
                <p class="company__business-title">{area.title}</p>
                <p class="company__business-desc">{area.desc}</p>
                <div class="company__business-list">
                  {area.items.map((text) => (
                    <TextList type="type_2">{text}</TextList>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="g-section">
      <div class="innerWrap">
        <TitleMain
          title={`Specialized <span class="mark">Outcomes</span>`}
          description={`B2B 현장을 잘 아는, 24년 경험의 e-Commerce 전문기업, M2MGlobal의 유일한 B2B 특화 커머스 플랫폼 수행 입증력이 기업의 차별을 만듭니다.<br/>또한 AI Commerce를 통해 거래·추천·분석까지 AI Commerce로 변화를 실현 중입니다.`}
        />
        <div class="company__case-grid">
          {
            caseStudies.map((item) => (
              <div class="company__case-item">
                <UiBoxCase3>
                  <Fragment slot="slotHead">
                    <BoxTitleCase4 label={item.label} title={item.title} prefix={item.prefix} />
                  </Fragment>
                  {item.list.map((text) => (
                    <TextList>{text}</TextList>
                  ))}
                  <UiTags items={item.tags.map((tag, i) => ({codeId: i, codeName: `#${tag}`}))} />
                  <Fragment slot="slotFoot">
                    <Button
                      href={PUBLIC_BUILD_URL + item.href}
                      useBlock={true}
                      useSuffixIcon="copy"
                    >
                      자세히 보기
                    </Button>
                  </Fragment>
                </UiBoxCase3>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
