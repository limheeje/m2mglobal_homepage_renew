import RobotGeekplus003 from '~/assets/images/common/robot-geekplus-003.png'
import RobotGeekplus004 from '~/assets/images/common/robot-geekplus-004.png'
import Rl_image001 from '~/assets/images/common/rl_image001.png'
import Rl_image002 from '~/assets/images/common/rl_image002.png'
import Rl_image003 from '~/assets/images/common/rl_image003.png'
import Rl_image004 from '~/assets/images/common/rl_image004.png'
import Rl_image005 from '~/assets/images/common/rl_image005.png'

const localNavigation = route.find((item) => item.href === '/robot-logistics/overview')

// Figma 실측 다이어그램 이미지 자리(실제 이미지는 담당자 작업 예정) — px 값을 rem으로 변환해서 인라인 style에 사용
const toRem = (px: number) => `${px / 10}rem`

const sectionTabs = [
  {id: 'overview', label: 'M2M-RLCK 개요'},
  {id: 'control-tech', label: '로봇물류제어기술'},
  {id: 'robots', label: 'RLCK 구현 로봇'},
  {id: 'system', label: '시스템구성'},
  {id: 'infra', label: '인프라구성'},
  {id: 'software', label: '소프트웨어 구성'},
  {id: 'simulation', label: '시뮬레이션'},
  {id: 'scheduling', label: '스케줄링, 경로계획, 영역제어'},
  {id: 'cases', label: '구축사례'}
]

// --- M2M-RLCK 개요 --- (Figma 실측: 87x87 원형 칩 2줄 — 비활성/활성 그룹)
const rcsChips = {
  inactive: ['Interface', '장비제어', '라우팅', '관제'],
  active: ['입출고', '장비제어', '라우팅', '관제', '관제']
}
const wesChips = {
  inactive: ['파킹', '운반', '소팅', '최적화'],
  active: ['데이터', '알고리즘', '시뮬레이션', '가시화']
}
const processStages = [
  {title: 'Planning', chips: ['운영 계획', '주문 계획', '최적화', '시뮬레이션']},
  {
    title: 'Execution (Fulfilment / Shipping)',
    chips: ['주문', '하차', '이동', '적치 (보관)', '재고', '피킹', '분배', '패킹', '상차']
  },
  {title: 'Monitoring (Management)', chips: ['성과 관리', '노무 관리', '가시성 관리', '장비 관리']}
]

