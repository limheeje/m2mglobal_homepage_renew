---
// e-Commerce > B2B Commerce (/e-commerce/b2b-commerce)
// Figma "e-Commerce > B2B Commerce" 4개 프레임(기업구매프로세스 / 구축사례 / 제공기술 및 특징 /
// 시스템연계구조) — 전부 같은 Tap_series(box 스타일) 앵커 탭의 상태라 한 페이지로 합쳤다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import Label from '~/components/common/Label.astro'

const localNavigation = route.find((item) => item.href === '/e-commerce/commerce-technology')

const sectionTabs = [
  {id: 'process', label: '기업구매프로세스'},
  {id: 'cases', label: '구축사례'},
  {id: 'features', label: '제공기술 및 특징'},
  {id: 'system', label: '시스템연계구조'}
]

// --- 기업 구매 프로세스 (6단계) ---
const processSteps = [
  {step: 'STEP 01', title: '구매 요청', desc: ['품목 검색', '장바구니 담기']},
  {step: 'STEP 02', title: '견적 · 단가', desc: ['계약단가 자동 적용', '견적서 발행']},
  {step: 'STEP 03', title: '결재 승인', desc: ['다단계 결재', '예산 한도 검증']},
  {step: 'STEP 04', title: '발주 · 출고', desc: ['ERP 발주 전송', 'WMS 출고 지시']},
  {step: 'STEP 05', title: '입고 확인', desc: ['납품 검수', '반품·교환 처리']},
  {step: 'STEP 06', title: '마감 · 정산', desc: ['여신 관리', '세금계산서 발행']}
]
const processFeatures = [
  {
    title: '구매 리드타임 단축',
    desc: '요청·승인·발주가 한 화면에서 이어져<br/>수기 문서 왕복이 사라집니다.'
  },
  {
    title: '단가 오류 차단',
    desc: '거래처별 계약단가가 자동 적용되어<br/>수기 입력 오류를 원천 제거합니다.'
  },
  {
    title: '정산 투명성 확보',
    desc: '거래 이력과 여신·마감 데이터가<br/>실시간으로 일치합니다.'
  }
]

// --- 구축사례 (3건) ---
const cases = [
  {
    title: '서플러스글로벌 반도체장비 마켓플레이스 구축',
    date: '2025.08 ~ 2026.01',
    desc: 'AI 기반 자동화 상품추천'
  },
  {
    title: '서플러스글로벌 반도체장비 파트너오피스 구축',
    date: '2025.03 ~ 2026.03',
    desc: 'AI 데이터 분석 기법을 활용한 고객 맞춤형 상품 자동 추천 기능'
  },
  {
    title: '서린상사 B2B 온라인 플랫폼',
    date: '2022.03 ~ 2023.12',
    desc: '비철금속에 특화된 커머스 시스템 기능 구현'
  }
]

// --- 제공기술 및 특징 (3개) ---
const featureCards = [
  {
    title: '몰 구축',
    items: [
      ['기업 전용 쇼핑몰 (B2B Mall)', '기업 고객 전용 주문 · 조회 환경 구축'],
      ['폐쇄몰 (Private Mall)', '인증 회원만 접근하는 비공개 거래 채널'],
      ['특판몰 / 협력사 전용몰', '대상별 가격·상품 노출 정책 분리 운영']
    ]
  },
  {
    title: '거래 관리',
    items: [
      ['기업 구매 시스템', '부서·직급별 구매 권한 및 예산 통제'],
      ['계약단가 및 견적관리', '거래처별 계약가 자동 적용, 견적 이력 관리'],
      ['대량 주문 및 승인 프로세스', '엑셀 대량 발주 + 다단계 결재 라인']
    ]
  },
  {
    title: '운영 연계',
    items: [
      ['ERP · SCM · WMS 연계', '주문·재고·출고 데이터 실시간 동기화'],
      ['거래처 및 정산 관리', '여신·마감·세금계산서 정산 자동화']
    ]
  }
]

// --- 시스템 연계 구조 (4단 매트릭스) ---
const systemLayers = [
  {label: 'Front 구매 채널', cols: ['B2B Mall', '폐쇄몰 (Private)', '특판몰', '협력사 전용몰']},
  {
    label: 'BackOffice',
    cols: [
      '회원·거래처 관리',
      '계약단가·견적',
      '주문·승인 결재',
      '재고·상품 관리',
      '정산·여신 관리'
    ]
  },
  {
    label: 'Interface 연계규격',
    cols: ['REST API', 'EDI', '배치 파일 연계', 'Message Queue', 'Web Service (SOAP)']
  },
  {
    label: 'External 고객사 기간계 시스템',
    cols: ['ERP', 'SCM', 'WMS', '그룹웨어 결재', 'PG · 전자세금계산서']
  }
]
---

<Layout>
  <SubBanner
    title="e-Commerce"
    description={`Commerce Platform에 속도와 생산성을 높이다.<br/>"Front –BackOffice-Interface" 모듈화 된 e-Commerce 아키텍처! AI와 융합 및 빠른 구축과 확장성을 제공합니다.`}
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-E-COMMERCE-ID-2'} />
  <TitleMain
    title="B2B Commerce"
    description={`"기업 전용몰 구축부터 계약단가 · 승인결재 · 정산까지" 기업 구매 전 과정을 하나의 흐름으로 연결합니다.<br/>ERP · SCM · WMS와 실시간 연계되는 엔터프라이즈 커머스 플랫폼을 제공합니다.`}
  />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="process" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`기업 구매 <span class="mark">프로세스</span>`}
        description="구매 요청부터 정산까지 전 단계를 단일 플랫폼에서 처리합니다."
      />
      <div class="ec__box-grid ec__box-grid--6">
        {
          processSteps.map((item) => (
            <div class="ec__step-card">
              <Label type="type_1">{item.step}</Label>
              <p class="ec__step-title">{item.title}</p>
              <p class="ec__step-desc">{item.desc.join(' · ')}</p>
            </div>
          ))
        }
      </div>

      <TitleMiddle>M2M Global B2B Commerce Platform — 전 단계 단일 플랫폼 처리</TitleMiddle>

      <div class="ec__stat-grid">
        {
          processFeatures.map((f) => (
            <div class="ec__stat-card">
              {/* TODO: 아이콘 이미지 삽입 */}
              <span class="ec__stat-icon" aria-hidden="true" />
              <p class="ec__stat-title">{f.title}</p>
              <p class="ec__stat-desc" set:html={f.desc} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="cases" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`구축 <span class="mark">사례</span>`} />
      <div class="ec__case-grid">
        {
          cases.map((item) => (
            <div class="ec__case-card">
              {/* <!-- TODO: 이미지 삽입 --> */}
              <div class="ec__case-thumb ec__thumb-ph" aria-hidden="true" />
              <p class="ec__case-title">{item.title}</p>
              <span class="ec__case-date">{item.date}</span>
              <p class="ec__case-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="features" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`제공 <span class="mark">기술 및 특징</span>`} />
      <div class="ec__feature-grid">
        {
          featureCards.map((card) => (
            <div class="ec__feature-card">
              <div class="ec__feature-head">
                {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                <span class="ec__feature-icon" aria-hidden="true" />
                <p class="ec__feature-title">{card.title}</p>
              </div>
              <div>
                {card.items.map((lines) => (
                  <TextList>
                    {lines[0]}
                    <br />
                    {lines[1]}
                  </TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="system" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`시스템 <span class="mark">연계 구조</span>`}
        description="Front ↔ BackOffice ↔ Interface 3계층 프레임워크 위에서 기간계 시스템과 연동됩니다."
      />
      {
        systemLayers.map((layer) => (
          <div class="ec__matrix-row">
            <p class="ec__matrix-label">{layer.label}</p>
            <div class="ec__matrix-cols">
              {layer.cols.map((col) => (
                <div class="ec__matrix-col">
                  <p class="ec__matrix-col-title">{col}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
