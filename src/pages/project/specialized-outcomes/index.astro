import CaseStudySection from '~/components/common/CaseStudySection.astro'
import stepArrowUrl from '~/assets/images/step-arrow.svg'
import SYMBOL029 from '~/assets/images/common/symbol029.png'

const localNavigation = route.find((item) => item.href === '/project/reference')
const logoFiles = import.meta.glob<{default: ImageMetadata}>('/src/assets/images/clients/*.png', {
  eager: true
})
const logoSrc = (key?: string) => {
  if (!key) return undefined
  const entry = Object.entries(logoFiles).find(([path]) => path.includes(`ico_client_${key}`))
  return entry?.[1].default.src
}
const sectionTabs = [
  {id: 'overview', label: 'Specialized Outcomes'},
  {id: 'semimarket', label: 'Semimarket'},
  {id: 'sorin', label: 'SORIN'},
  {id: 'cj', label: 'CJ대한통운 로봇물류'}
]

// --- 개요: Why M2M GLOBAL? 특별한 성과가 차이를 만듭니다 (3개 대표 사례 카드) ---
