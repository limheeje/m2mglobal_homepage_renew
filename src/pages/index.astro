  <script src={`${PUBLIC_BUILD_URL}/js/jquery-3.1.1.min.js`} is:inline></script>
  <script src={`${PUBLIC_BUILD_URL}/js/jquery.fullpage.min.js`} is:inline></script>
  <script src={`${PUBLIC_BUILD_URL}/js/swiper.min.js.js`} is:inline></script>
  <script is:inline>
    // 공통 타입 분기 없이 슬라이드별로 각자 따로 선언한다 — 서로 옵션이 달라지기 시작하면(peek
    // 폭, offset 등) 분기 하나 고칠 때 다른 슬라이드까지 건드릴 위험이 있어서 유지보수상 분리한다.
    // PC(<1300px 아닐 때)는 fullPage.js가 섹션을 정확히 1화면(100vh)로 스냅하니 같은 그룹
    // 슬라이드끼리 높이가 같아야 자연스럽다(autoHeight 끔 = 원래 PC 동작 그대로). 모바일은
    // fullPage가 responsiveWidth로 꺼져서 문서가 보통 스크롤되니, 컨텐츠 길이가 짧은 슬라이드가
    // 가장 긴 슬라이드 높이에 맞춰 늘어나 하단에 의미 없는 빈 공간이 생기는 걸 막으려고
    // autoHeight로 "지금 보이는 슬라이드"의 실제 높이만큼만 차지하게 한다(min-height:100vh는
    // CSS가 그대로 보장).
    document.addEventListener('DOMContentLoaded', () => {
      // --- Section 1~4 공통: 세로 닷 페이지네이션 + loop + 4초 간격 자동 롤링.
      // disableOnInteraction: false로 둬서 사용자가 닷을 클릭해 수동으로 넘겨도 자동 롤링이
      // 멈추지 않고 그 시점부터 다시 4초 뒤 계속 넘어간다(메인 히어로 배너 관례 — 한 번 조작했다고
      // 자동재생이 영구히 꺼지면 안 됨). pauseOnMouseEnter는 마우스를 올린 동안만 잠깐 멈췄다가
      // 벗어나면 재개 — 텍스트 읽는 도중 다음 슬라이드로 훽 넘어가버리는 걸 방지.
      const AUTOPLAY = {delay: 7000, disableOnInteraction: false, pauseOnMouseEnter: false}

      // --- Section 1: Main slogan — 세로 닷 페이지네이션만, loop ---
      new Swiper('.section1-slide.js-swiper', {
        slidesPerView: 1,
        loop: true,
        autoHeight: true,
        autoplay: AUTOPLAY,
        pagination: {
          el: '.section1-slide .swiper-pagination',
          clickable: true
        },
        breakpoints: {
          1300: {autoHeight: false}
        }
      })

      // --- Section 2: 사업정보 — 세로 닷 페이지네이션만, loop ---
      new Swiper('.section2-slide.js-swiper', {
        slidesPerView: 1,
        loop: true,
        autoHeight: true,
        autoplay: AUTOPLAY,
        pagination: {
          el: '.section2-slide .swiper-pagination',
          clickable: true
        },
        breakpoints: {
          1300: {autoHeight: false}
        }
      })

      // --- Section 3: AI — 세로 닷 페이지네이션만, loop ---
      new Swiper('.section3-slide.js-swiper', {
        slidesPerView: 1,
        loop: true,
        autoHeight: true,
        autoplay: AUTOPLAY,
        pagination: {
          el: '.section3-slide .swiper-pagination',
          clickable: true
        },
        breakpoints: {
          1300: {autoHeight: false}
        }
      })

      // --- Section 4: Business — 세로 닷 페이지네이션만, loop ---
      new Swiper('.section4-slide.js-swiper', {
        slidesPerView: 1,
        loop: true,
        autoHeight: true,
        autoplay: AUTOPLAY,
        pagination: {
          el: '.section4-slide .swiper-pagination',
          clickable: true
        },
        breakpoints: {
          1300: {autoHeight: false}
        }
      })

      // --- Section 5: Solution 소개 카드(6종) — 화살표 버튼만.
      // width:'auto'+CSS 고정폭(425px) 대신 slidesPerView를 소수로 줘서(카드 몇 장 + 다음 장
      // 살짝 peek) Swiper가 컨테이너 실측 폭을 기준으로 카드 폭을 직접 계산하게 한다 — 화면이
      // 커질수록 카드가 커지는 게 아니라 "몇 장이 보이는지 + peek 정도"가 화면 폭에 비례해서
      // 일정해진다(CSS 쪽 .sp-solution-card는 flex-basis/width를 더는 고정하지 않음, 참고).
      // slidesOffsetBefore/After는 Figma 80px 거터 기준 raw px라 rem 축소를 안 따라간다 —
      // 모바일(<1300px, $breakpoint-md와 동일)에서는 오프셋 0(기본값)으로 두고, breakpoints로
      // 1300px 이상에서만 80px 인셋을 되살린다. slidesPerView도 같은 breakpoints로: 모바일은
      // 1장 + 살짝 peek, 1300px 이상은 4장 + 살짝 peek(넓은 화면일수록 다음 카드가 더 보임).
      new Swiper('#solution-swiper', {
        slidesPerView: 1.15,
        spaceBetween: 15,
        navigation: {
          prevEl: '#solution-swiper-nav-prev',
          nextEl: '#solution-swiper-nav-next'
        },
        breakpoints: {
          1300: {
            slidesPerView: 4.2,
            spaceBetween: 20,
            slidesOffsetBefore: 80,
            slidesOffsetAfter: 80
          }
        }
      })

      // --- Section 6: Why, M2MGLOBAL? — 화살표 버튼만, 케이스 1장씩 통째로 전환(peek 없음).
      // slidesPerView가 숫자(1)면 Swiper가 슬라이드 폭을 "스와이퍼 컨테이너 전체 폭"으로 계산해서
      // slidesOffsetBefore(스크롤 위치만 밀어줄 뿐 폭은 안 줄여줌)와 안 맞아 슬라이드가 풀블리드
      // 폭 그대로 넘쳐버렸다 — 'auto' + 슬라이드 자체 CSS width(.sp-why-body)로 폭을 직접
      // 지정해야 offset과 맞물려 정확히 들어맞는다(뒤쪽 여백도 .sp-why-body의 padding-right).
      // 모바일은 offset 없이(위 solution-swiper와 동일 이유) 슬라이드 1장이 폭 100%로 딱 차게 둔다
      // — 80px가 그대로 남아있으면 슬라이드 폭(100%) + 오프셋만큼 오른쪽으로 밀려 넘쳐 보였다.
      // spaceBetween도 offset과 같은 raw px라 좁은 화면에선 20이 상대적으로 크다 — 모바일 15,
      // 1300px 이상은 기존 20 그대로.
      new Swiper('#why-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 15,
        navigation: {
          prevEl: '#why-swiper-nav-prev',
          nextEl: '#why-swiper-nav-next'
        },
        breakpoints: {
          1300: {
            spaceBetween: 20,
            slidesOffsetBefore: 80
          }
        }
      })

      // --- Section 7: Project 구축사례(9종) — Solution과 동일 패턴(카드 폭 277px) ---
      new Swiper('#project-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 15,
        navigation: {
          prevEl: '#project-swiper-nav-prev',
          nextEl: '#project-swiper-nav-next'
        },
        breakpoints: {
          1300: {
            spaceBetween: 20,
            slidesOffsetBefore: 80,
            slidesOffsetAfter: 80
          }
        }
      })
    })

    $(function () {
      // Footer는 #fullpage 바깥(Layout.astro가 그 다음 형제로 렌더링)에 있는데, fullPage가
      // html/body에 overflow:hidden을 걸어 문서 스크롤 자체를 잠가버리기 때문에 마지막 섹션
      // 이후로는 원래 Footer까지 내려갈 방법이 없다 — 마지막 섹션(Partner)에 도달하면
      // setAutoScrolling(false)로 잠금을 풀어서 그 아래 Footer까지 자연스럽게 이어서
      // 스크롤되게 하고, 다시 위로 스크롤해 마지막 섹션 상단으로 돌아오면 스냅을 복구한다.
      // isAutoScrolling은 우리가 fullPage에 마지막으로 지시한 상태를 그대로 미러링하는 값 —
      // fullPage 2.9.7엔 현재 상태를 물어보는 getter가 없어서 직접 들고 있는다.
      // (PC 전용 동작 — responsiveWidth 아래(모바일)에서는 fullPage 자체가 스크롤을 안 건드리니
      // 이 로직도 자연히 관여하지 않는다.)
      let isAutoScrolling = true
      const $lastSection = $('.section-partner-slide')
      function setAutoScrolling(on) {
        $.fn.fullpage.setAutoScrolling(on)
        isAutoScrolling = on
      }

      const PC_BREAKPOINT = 1301 // 아래 responsiveWidth와 동일 값, 리사이즈 핸들러에서도 참조

      // fullPage 초기화를 함수로 빼둔다 — 최초 1회 호출은 물론, 아래 리사이즈 핸들러에서
      // "이전 사이즈가 모바일(반응형)이었던 경우" 통째로 destroy 후 재호출(재로드)하기 위함.
      function initFullpage() {
        $('#fullpage').fullpage({
          // $breakpoint-md(1300px)보다 좁으면 fullPage가 섹션 스냅/스크롤 잠금을 전부 놓고 평범한
          // 문서 스크롤로 넘어간다 — 우리 CSS 미디어쿼리(max-width:1300px)와 정확히 같은 지점에서
          // 전환되도록 1301(1300 이하는 전부 "미만"에 포함)로 잡는다. 모바일에서 컨텐츠가 100vh를
          // 넘는 섹션이 fullPage에 의해 잘리던 문제가 있었어서, PC는 fullPage 스냅을 그대로 두고
          // 모바일만 이걸로 빠져나가게 한 것 — PC 동작은 예전 그대로.
          responsiveWidth: PC_BREAKPOINT,
          anchors: [
            'main',
            'business-info',
            'ai',
            'business',
            'solution',
            'why',
            'project',
            'partner',
            'footer'
          ],
          //scrollingSpeed: 1000, //스크롤 이동 속도를 0.001초 단위로 설정
          //fitToSectionDelay: 1200, //설정된 1000분의 1초 단위로 맞춤을 지연
          //touchSensitivity: 20, // 슬라이드로 이동하는 데 필요한 스와이프 거리를 정의
          //scrollHorizontally: true, //슬라이더 안에서 마우스 휠 또는 트랙패드를 써서 수평으로 미끄러지듯 움직일지를 정의
          css3: true,

          //접근성
          keyboardScrolling: true,
          animateAnchor: true,
          recordHistory: true

          // 마지막 섹션(Partner)에 도착하면 스크롤 잠금을 풀어 그 아래 Footer로 자연스럽게
          // 이어지게 한다 — 위 setAutoScrolling(true) 복구 로직은 있었지만 정작 이걸 처음
          // 풀어주는 트리거가 빠져있어서 Footer에 끝까지 도달할 방법 자체가 없었다(버그).
        })
      }
      initFullpage()

      // --- 이전 사이즈가 모바일 폭(1300px 이하)이었다면, 리사이즈 후 fullPage를 통째로 재로드 ---
      // 실제 재현된 원인(사용자 리포트, Ctrl+휠 줌으로 확인): fullPage의 responsiveWidth 설정
      // 때문에 브라우저 확대/축소 중 1300px 밑으로 살짝이라도 스쳐 지나가면 fullPage가 반응형
      // 모드(스냅 잠금 해제)로 전환됐다가, 다시 커질 때 섹션 위치(translate3d) 재동기화가 깨끗하게
      // 안 맞아 화면이 두 섹션 사이에 걸쳐 보이는 상태로 남는다 — reBuild()/silentMoveTo() 같은
      // 부분 재계산으로는 안 잡혀서, 아예 destroy('all')로 fullPage가 건드린 마크업/상태를 전부
      // 원상 복구한 뒤 initFullpage()로 처음부터 다시 초기화한다(가장 확실한 재동기화 방법).
      // 리사이즈 이벤트가 짧은 시간에 여러 번 발생하므로(연속 줌 등) 300ms 디바운스로 리사이즈가
      // 일단락된 뒤에만 재로드한다.
      let resizeTimer
      let wasMobileWidth = window.innerWidth < PC_BREAKPOINT
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer)
        resizeTimer = setTimeout(function () {
          if (
            wasMobileWidth &&
            $.fn.fullpage &&
            $.fn.fullpage.destroy &&
            window.innerWidth > 1200
          ) {
            //$.fn.fullpage.destroy('all')
            //initFullpage()
            location.reload()
          }
          wasMobileWidth = window.innerWidth < PC_BREAKPOINT
        }, 300)
      })

      window.addEventListener('scroll', function () {
        if (isAutoScrolling) return
        // 마지막 섹션(Partner) 상단이 뷰포트 상단에 걸리거나 그 아래로 내려오면(=Footer를 벗어나
        // 다시 위로 올라옴) fullPage 스냅 스크롤을 복구한다.
        if ($lastSection.get(0).getBoundingClientRect().top >= 0) {
          setAutoScrolling(true)
        }
      })
    })
  </script>
</MainLayout>
