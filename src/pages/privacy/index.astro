---
// 개인정보처리방침 (/privacy)
// Figma "개인정보처리방침" — 버전별 정책 문서 리스트. 실제 PDF는 외부(m2mglobal.co.kr)에 있어
// "자세히보기"는 해당 안내 페이지로 연결한다.
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import Button from '~/components/common/Button.astro'

const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL
const policies = [
  {title: '개인정보 처리방침 (26.02.01)', href: '/etc/[보안관리] 개인정보 처리방침_260201.pdf'},
  {title: '개인정보 처리방침 (24.12.24)', href: '/etc/[보안관리] 개인정보 처리방침(24.12.24).pdf'},
  {title: '개인정보 처리방침 (21.11.12)', href: '/etc/[보안관리] 개인정보 처리방침(21.11.12).pdf'}
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner title="개인정보처리방침" />
    <TitleMain title="개인정보 처리방침" />

    <section class="g-section">
      <div class="innerWrap">
        <div class="privacy__list">
          {
            policies.map((item) => (
              <div class="privacy__row">
                <p class="privacy__title">{item.title}</p>
                <Button
                  href={PUBLIC_BUILD_URL + item.href}
                  variant="white"
                  size="sm"
                  useSuffixIcon="blank"
                  target="_blank"
                >
                  자세히보기
                </Button>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
