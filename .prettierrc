{
  "plugins": ["prettier-plugin-astro"],
  "semi": false,
  "singleQuote": true,
  "arrowParens": "always",
  "bracketSpacing": false,
  "endOfLine": "auto",
  "printWidth": 100,
  "proseWrap": "preserve",
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ]
}
