---
// Container — 페이지 콘텐츠 폭을 통일하는 레이아웃 컨테이너 (Bootstrap의 container 개념)
// 프로젝트 공통 가이드("Container 최대폭은 프로젝트 전체 1개로 고정")의 실제 구현체.
// Row/Col과 함께 쓴다.
//
// 사용 예:
//   <Container>
//     <Row>
//       <Col span={6}>왼쪽</Col>
//       <Col span={6}>오른쪽</Col>
//     </Row>
//   </Container>
//   <Container fluid>...</Container>       // max-width 캡 없이 좌우 거터만 (Footer류 풀블리드)
//   <Container maxWidth={1760}>...</Container>  // 기본 1280 대신 페이지 고유 max-width (Figma 실측 근거 있을 때만)

import {pxToRem} from '~/utils/rem'

export interface Props {
  /** true면 max-width 캡 없이 좌우 거터만 적용 */
  fluid?: boolean
  /** 기본 1280(공통 토큰) 대신 쓸 max-width(px). Figma에서 실측된 페이지별 예외에만 사용 — 임의 수치 금지 */
  maxWidth?: number
  class?: string
}

const {fluid = false, maxWidth, class: className} = Astro.props
const classes = ['container', fluid && 'container--fluid', className].filter(Boolean).join(' ')
// _layout-grid.scss의 `.container`가 --container-max-width를 min()으로 소비한다 — max-width를
// 직접 주면 안 된다(거터 padding과 이중으로 깎여서 실제 콘텐츠 폭이 의도한 값보다 좁아짐).
const style = maxWidth ? `--container-max-width:${pxToRem(maxWidth)}` : undefined
---

<div class={classes} style={style}>
  <slot />
</div>
