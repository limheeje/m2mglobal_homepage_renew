---
// 404 Not Found (/404) — Astro 예약 경로. 없는 경로 접속 시 astro dev/preview가 자동으로 이
// 페이지를 띄우고, 빌드하면 dist/404.html로 산출된다. base(PUBLIC_BUILD_URL) 서브패스 유무와
// 무관하게 이 파일은 항상 dist/404.html에 그대로 생성됨 — outDir은 base와 별개 설정이라 서브패스가
// 나중에 빠져도 코드 수정 불필요. 다만 "실제 404 요청 시 이 파일을 보여줄지"는 호스팅 서버
// (Nginx/Apache/IIS 등)의 오류 페이지 설정이 결정하는 영역이라 Astro 밖에서 별도 확인 필요.
//
// Figma에 대응 디자인이 없는 유틸리티 페이지(/page-list와 동일 성격)라 공용 컴포넌트만 조합해서
// 구성. 자동 리다이렉트 없이 안내 메시지 + "홈으로 가기" 버튼만 제공(사용자 확인 후 결정).
import Layout from '~/layouts/SubLayout.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import Button from '~/components/common/Button.astro'

const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL
---

<Layout>
  <div class="sub-wrap">
    <section class="g-section">
      <div class="innerWrap">
        <div class="error-page">
          <TitleMain
            title="페이지를 찾을 수 없습니다"
            description="요청하신 페이지의 주소가 잘못되었거나 삭제되어<br/>찾을 수 없습니다."
          />
          <div class="error-page__actions">
            <Button href={`${PUBLIC_BUILD_URL}/`} variant="primary">홈으로 가기</Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
