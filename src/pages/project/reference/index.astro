---
// Project > Reference (/project/reference)
// Figma "프로젝트"(node 1210:78024) — 12개 프로젝트 레퍼런스 리스트.
// 마크업 패턴은 /company/news의 리스트(company__news-row: 상단 2px 포인트 보더 + 행별 구분선 +
// "바로가기" Button)를 참고했다 — 이 페이지는 로고 썸네일(128x68) + 2줄 타이틀/설명이 추가된 변형.
// 로고는 이미 다운로드되어 있는 src/assets/images/clients/ico_client_*.png(ClientLogoGrid와 동일 자산)를
// 재사용한다 — 일치하는 로고가 없는 항목(서린상사)만 TODO 플레이스홀더로 남긴다.
import {route} from '@config/route'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import Navigation from '~/components/common/Navigation.astro'
import Button from '~/components/common/Button.astro'
import Label from '~/components/common/Label.astro'

const localNavigation = route.find((item) => item.href === '/project/reference')

const logoFiles = import.meta.glob<{default: ImageMetadata}>('/src/assets/images/clients/*.png', {
  eager: true
})
const logoSrc = (key?: string) => {
  if (!key) return undefined
  const entry = Object.entries(logoFiles).find(([path]) => path.includes(`ico_client_${key}`))
  return entry?.[1].default.src
}

