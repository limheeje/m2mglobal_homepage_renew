---
// Company > 위치 및 연락처 (/company/address)
// 참고: Figma "About us > 위치 및 연락처" 프레임(node 360:1450)
//
// 지도는 실제 지도 API(카카오맵 등)를 사용자가 직접 붙일 예정이라 정적 스크린샷 대신
// Figma 실측 비율의 빈 자리(.company__address-map)만 잡아둔다.
//
// 예전 구(舊) 컴포넌트(PageBanner/Title/Container) 참조로 깨져있던 페이지를 현재 공용
// 컴포넌트(SubBanner/Navigation/TitleMain)로 재구축 — 콘텐츠·에셋은 그대로 유지.
import {route} from '@config/route'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import Navigation from '~/components/common/Navigation.astro'
import logoUrl from '~/assets/images/m2m-global-logo-full.svg'

const localNavigation = route.find((item) => item.href === '/company/info')

const rows = [
  {label: '본사 주소', value: '서울특별시 영등포구 영등포로 150, B동 1509호 생각공장 당산'},
  {label: '전화 번호', value: 'T : 02) 6956-3955'},
  {label: '오시는 길', value: '2호선 문래역 4번출구 도보 5분'}
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>다년 간의 경험과 전문성을 겸비한 인력과 AI가 한 팀이 되어, 고객 비즈니스의 성공을 위해 끊임없이 실행하고 성장합니다."
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-6'} />
    <TitleMain title="위치 및 연락처" />

    <section class="g-section">
      <div class="innerWrap">
        <div class="company__address">
          <div
            id="daumRoughmapContainer1670476719947"
            class="root_daum_roughmap root_daum_roughmap_landing g-map map-area"
            style="width: 100%;"
            data-aos-delay="500"
            data-aos="fade-up"
          >
          </div>
          <script
            charset="UTF-8"
            class="daum_roughmap_loader_script"
            src="https://ssl.daumcdn.net/dmaps/map_js_init/roughmapLoader.js"></script>
          <script charset="UTF-8">
            new daum.roughmap.Lander({
              timestamp: '1670476719947',
              key: '2cwqk',
              mapHeight: '500'
            }).render()
          </script>

          <div class="company__address-info">
            <a href="/" class="company__address-logo">
              <img src={logoUrl.src} alt="M2M GLOBAL 엠투엠글로벌(주)" />
            </a>
            <div class="company__address-rows">
              {
                rows.map((row) => (
                  <div class="company__address-row">
                    <span class="company__address-row-label">{row.label}</span>
                    <span class="company__address-row-value">{row.value}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
