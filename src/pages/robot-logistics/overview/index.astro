// --- 구축사례 ---
// CJ 대한통운 APRIL 로봇통합플랫폼 구축사례 전체는 ~/components/common/CaseStudySection.astro에
// 기본값으로 내장되어 있다 — "프로젝트 전체" 등 다른 페이지에서도 완전히 같은 내용을 그대로 쓰므로
// 이 페이지에서는 데이터를 따로 선언하지 않고 <CaseStudySection /> 하나만 호출한다.
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Robot Logistics"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>모듈화 된 e-Commerce 아키텍처+AI를 결합하여 Commerce Platform에 속도와 생산성을 높입니다."
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-ROBOT-LOGISTICS-ID-1'} />
    <TitleMain title="로봇 물류 플랫폼" />

    <div class="innerWrap">
      <div class="bs-tab-group">
        {
          sectionTabs.map((tab, i) => (
            <a
              class="bs-tab tab__item"
              class:list={{'is-active': i === 0}}
              data-type="box"
              href={`#${tab.id}`}
            >
              {tab.label}
            </a>
          ))
        }
      </div>
    </div>

    <section id="overview" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`M2M-RLCK <span class="mark">개요</span>`}
          description={`Robot Logistics Control Knowledge는 물류창고 내 로봇 작업과 자원을 실시간으로 최적화하는 <span class="mark">WES(Warehouse Execution System)</span>와<br/>다양한 로봇의 연동·제어·경로 관리를 수행하는 <span class="mark">RCS(Robot Control System)</span> 기술을 기반으로 구축된 엠투엠글로벌의 로봇 물류 제어 기술체계입니다.`}
        />
        <div class="rl__overview-grid">
          <div class="rl__overview-card">
            <div class="rl__overview-head">
              <span class="rl__icon-circle" aria-hidden="true">
                {/* TODO: 아이콘 이미지 삽입 */}
                <Icon name={ICON_KEY_NAME['Business3-1']} />
              </span>
              <p class="rl__overview-title">RCS(Robot Control System)</p>
            </div>
            <div class="rl__chip-block">
              <div class="rl__chip-row">
                {rcsChips.inactive.map((label) => <span class="rl__chip">{label}</span>)}
              </div>
              <div class="rl__chip-row">
                {
                  rcsChips.active.map((label) => (
                    <span class="rl__chip rl__chip--active">{label}</span>
                  ))
                }
              </div>
            </div>
          </div>

          <p class="rl__overview-label">
            Robot Logistics
            <br />
            Control Knowledge
          </p>

          <div class="rl__overview-card">
            <div class="rl__overview-head">
              <span class="rl__icon-circle" aria-hidden="true">
                {/* TODO: 아이콘 이미지 삽입 */}
                <Icon name={ICON_KEY_NAME['Business3-2']} />
              </span>
              <p class="rl__overview-title">WES(Warehouse Execution System)</p>
            </div>
            <div class="rl__chip-block">
              <div class="rl__chip-row">
                {wesChips.inactive.map((label) => <span class="rl__chip">{label}</span>)}
              </div>
              <div class="rl__chip-row">
                {
                  wesChips.active.map((label) => (
                    <span class="rl__chip rl__chip--active">{label}</span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div class="rl__seamless-ban">
          <TitleMiddle>Seamless 물류 프로세스</TitleMiddle>
        </div>
        <div class="rl__seamless-flow">
          {
            processStages.map((stage, i) => (
              <>
                <div class="rl__seamless-stage" class:list={{'rl__seamless-stage--fluid': i === 1}}>
                  <p class="rl__seamless-stage-title">{stage.title}</p>
                  <div class="rl__seamless-chip-grid">
                    {stage.chips.map((chip) => (
                      <span class="rl__chip rl__chip--white">{chip}</span>
                    ))}
                  </div>
                </div>
                {i < processStages.length - 1 && (
                  <span class="rl__chevron rl__chevron--flow" aria-hidden="true" />
                )}
              </>
            ))
          }
        </div>
      </div>
    </section>
    <section id="control-tech" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`로봇물류 <span class="mark">제어기술</span>`}
          description="M2M-RLCK는 다양한 물류 로봇과 자동화 설비를 하나의 플랫폼으로 통합 제어하여 스마트 창고의 운영 효율을 극대화합니다.<br/>AS/RS, AMR, 셔틀카 등 이기종 로봇을 유기적으로 연계해 안정적인 물류 운영과 최적의 작업 환경을 제공합니다."
        />
        <div class="rl__tech-banne">
          <div class="innerWrap">
            <div class="inner">
              <div class="tit">M2M-RLCK 로봇물류제어기술</div>
            </div>
          </div>
        </div>
        <div class="rl__tech-grid">
          {
            controlTechCards.map((card) => (
              <div class="rl__tech-card">
                <div class="rl__tech-head">
                  {/* TODO: 아이콘 이미지 삽입 */}
                  <div class="rl__tech-thumb rl__thumb-ph" aria-hidden="true">
                    <img src={card.imgSrc} alt="" />
                  </div>
                  <p class="rl__tech-title">{card.title}</p>
                </div>
                <div class="rl__tech-body">
                  <div class="rl__tech-row">
                    <p class="rl__tech-row-label">업무과정</p>
                    <div class="rl__tech-steps">
                      {card.steps.map((step, i) => (
                        <>
                          <span class="rl__tech-step">{step}</span>
                          {i < card.steps.length - 1 && (
                            <span class="rl__chevron" aria-hidden="true" />
                          )}
                        </>
                      ))}
                    </div>
                  </div>
                  <div class="rl__tech-row">
                    <p class="rl__tech-row-label">특징</p>
                    <div class="rl__tech-features">
                      {card.features.map((feature) => (
                        <TextList>{feature}</TextList>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section id="robots" class="g-section">
      <div class="innerWrap">
        <TitleSub
          title={`RLCK <span class="mark">구현 로봇</span>`}
          description="RLCK(Robot Logistics Control Knowledge)는 메시지 스트리밍, 표준 인터페이스, 표준 프레임워크, 표준 UI 라이브러리 등 핵심 플랫폼 기술을 기반으로 구현된 로봇 물류 제어 플랫폼입니다."
        />
        {
          robotGroups.map((group) => (
            <div class="rl__robot-group">
              <TitleThird>{group.title}</TitleThird>
              <div class="rl__robot-group-content">
                {group.robots.map((robot) => {
                  const splitAt = robot.specSplit ?? Math.ceil(robot.specs.length / 2)
                  const specCols = [robot.specs.slice(0, splitAt), robot.specs.slice(splitAt)]
                  return (
                    <div class="rl__robot-card">
                      <p class="rl__robot-name">{robot.name}</p>
                      <div class="rl__robot-body">
                        {/* TODO: 로봇 이미지 삽입 */}
                        <div class="rl__robot-thumb " aria-hidden="true">
                          <img src={robot.imgSrc} alt="" />
                        </div>
                        <div class="rl__spec-columns">
                          {specCols.map((col) => (
                            <div class="rl__spec-col">
                              {col.map(([label, value]) => (
                                <div class="rl__spec-row">
                                  <span class="rl__spec-label">{label}</span>
                                  <span class="rl__spec-value">{value}</span>
                                </div>
                              ))}
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          ))
        }
      </div>
    </section>

