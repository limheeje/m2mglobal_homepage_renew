---
// Button 공통 컴포넌트
// 공식: Type(variant) + Size + State + Option — 이 4가지 조합으로만 사용한다.
// 임의로 색상을 바꾸거나 새 variant를 만들지 말고, 정말 필요하면 새 Option으로 추가할 것.
// 참고: https://comet-take-17267726.figma.site/button
//
// 사용 예:
//   <Button variant="primary" size="lg" icon="ico_download">회사소개서 다운로드</Button>
//   <Button variant="secondary" size="md" icon="ico_arrow_right" iconPosition="right">Read More</Button>
//   <Button variant="third" href="/company/info" icon="ico_external_link">바로가기</Button>

import Icon from '~/components/Icon.astro'

export interface Props {
  /** primary(채움/네이비) · secondary(아웃라인/연한 회색) · third(포인트 컬러) */
  variant?: 'primary' | 'secondary' | 'third'
  /** lg: 24/30px 패딩·18px 폰트 · md: 12/24px 패딩·16px 폰트 · sm: 8/16px 패딩·14px 폰트 */
  size?: 'lg' | 'md' | 'sm'
  /** src/assets/icons/{name}.svg */
  icon?: string
  /** 기본값(lg:24·md:20·sm:16)과 다른 Figma 실측 케이스가 있을 때만 개별 지정 — 남용 금지 */
  iconSize?: number
  iconPosition?: 'left' | 'right'
  fullWidth?: boolean
  disabled?: boolean
  /** 지정 시 <a>, 아니면 <button> 으로 렌더링 */
  href?: string
  /** href와 함께 쓰는 <a> target 속성 (예: '_blank'로 외부 링크 새 탭 열기) */
  target?: string
  /** <button> 렌더링일 때만 사용되는 HTML type 속성 */
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconSize,
  iconPosition = 'right',
  fullWidth = false,
  disabled = false,
  href,
  target,
  type = 'button',
  class: className
} = Astro.props

const resolvedIconSize = iconSize ?? (size === 'lg' ? 24 : size === 'md' ? 20 : 16)

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth && 'btn--full',
  icon && `btn--icon-${iconPosition}`,
  className
]
  .filter(Boolean)
  .join(' ')

const Tag = href ? 'a' : 'button'
---

<Tag
  class={classes}
  href={href}
  target={href ? target : undefined}
  rel={href && target === '_blank' ? 'noopener noreferrer' : undefined}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  {
    icon && iconPosition === 'left' && (
      <Icon name={icon} size={resolvedIconSize} class="btn__icon" />
    )
  }
  <span class="btn__label"><slot /></span>
  {
    icon && iconPosition === 'right' && (
      <Icon name={icon} size={resolvedIconSize} class="btn__icon" />
    )
  }
</Tag>
