---
// Robot Logistics > 스마트 팩토리 (/robot-logistics/smart-factory)
// Figma "Robot Logistics > 스마트 팩토리" 3개 프레임(M2M-MES 특장점 / 시스템구성 / 구축사례) — 전부
// 같은 Tap_box_series 앵커 탭의 상태라 한 페이지로 합쳤다 (/robot-logistics/overview와 동일 패턴).
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import CaseCardGrid from '~/components/common/CaseCardGrid.astro'
import stepArrowUrl from '~/assets/images/step-arrow.svg'
import SYMBOL013 from '~/assets/images/common/symbol013.png'
import SYMBOL014 from '~/assets/images/common/symbol014.png'
import {ICON_KEY_NAME} from '~/constants/Icon'
import Icon from '~/components/common/Icon.astro'

const localNavigation = route.find((item) => item.href === '/robot-logistics/overview')
const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL

const sectionTabs = [
  {id: 'benefits', label: 'M2M-MES 특장점'},
  {id: 'system', label: '시스템구성'},
  {id: 'cases', label: '구축사례'}
]

const benefitCards = [
  {
    icon: ICON_KEY_NAME['Business8-1'],
    title: '생산성 증가',
    top: '정확한 생산 데이터 기반 원료, 재고 상황 확인 가능',
    bottom: '최적의 생산계획 수립에 따른 생산성 증가 효과'
  },
  {
    icon: ICON_KEY_NAME['Business8-2'],
    title: '비용 절감',
    top: '스마트한 MES 시스템 도입 Downtime 감소',
    bottom: '생산성 향상, 품질 향상 비용 절감, 매출 증진 고객 만족도 증진'
  },
  {
    icon: ICON_KEY_NAME['Business8-3'],
    title: '설비 운영 효율화',
    top: '자원의 상세 인력 & 설비 현황 실시간 제공',
    bottom: '설비의 오작동에 즉각 대응 및 효율적인 설비 운영 가능, 생산성/매출 증대 기대'
  },
  {
    icon: ICON_KEY_NAME['Business8-4'],
    title: '현장 사고 예방',
    top: '실시간 현장 모니터링, 제조활동 모니터링',
    bottom: '긴급 상황 예방, 사고 시 긴급 대처에 따른 사고 건수 절감 및 글로벌 품질 역량 강화'
  },
  {
    icon: ICON_KEY_NAME['Business8-5'],
    title: '분석 통합 레포팅',
    top: '업무 공정을 체계적으로 데이터화',
    bottom: '업무 ROSS 제로화 재고관리, 생산성 증대 문서관리의 편리성 제공'
  }
]

const cases = [
  {
    imageSrc: `${PUBLIC_BUILD_URL}/images/banner/banner005.png`,
    title: '금호폴리캠 MES 시스템 구축',
    date: '2019.06 ~ 2019.12',
    desc: '품질영량재고 및 생산현장 가시성 확보를 위한 MES 시스템 구축'
  },
  {
    imageSrc: `${PUBLIC_BUILD_URL}/images/banner/banner006.png`,
    title: '씨에스윈드 MES 시스템 구축',
    date: '2018.06 ~ 2018.09',
    desc: '씨에스윈드 국내 MES와 해외 MES 시스템 통합 구현'
  },
  {
    imageSrc: `${PUBLIC_BUILD_URL}/images/banner/banner007.png`,
    title: '디에이치라이팅 MES 시스템 구축',
    date: '1차 2017.07, 2차 2018.03',
    desc: 'Smart Jactory 구현을 위한 MES 시스템 구축 및 고도화'
  }
]
---

<Layout>
  <SubBanner
    title="Robot Logistics"
    description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>모듈화 된 e-Commerce 아키텍처+AI를 결합하여 Commerce Platform에 속도와 생산성을 높입니다."
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-ROBOT-LOGISTICS-ID-2'} />
  <TitleMain title="스마트 팩토리" />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="benefits" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`제공 <span class="mark">기술 및 특징</span>`} />
      <div class="">
        <img src={SYMBOL014.src} alt="" />
      </div>
      <div class="rl__mes-banner">
        <TitleMiddle>
          M2M-MES <span class="mark">Manufacturing Execution System</span>
        </TitleMiddle>
      </div>

      <div class="rl__benefit-grid">
        {
          benefitCards.map((card) => (
            <div class="rl__benefit-card">
              <div class="rl__benefit-head">
                <span class="rl__icon-circle" aria-hidden="true">
                  {/* TODO: 아이콘 이미지 삽입 */}
                  <Icon name={card.icon} />
                </span>
                <p class="rl__benefit-title">{card.title}</p>
              </div>
              <div class="rl__benefit-body">
                <TextList>{card.top}</TextList>
                <span class="rl__benefit-arrow" aria-hidden="true">
                  <img src={stepArrowUrl.src} alt="" />
                </span>
                <TextList>{card.bottom}</TextList>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="system" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`시스템 <span class="mark">구성도</span>`} />
      <!-- TODO: 시스템구성도 이미지 삽입 -->
      <div class="rl__diagram-placeholder" aria-hidden="true">
        <img src={SYMBOL013.src} alt="" />
      </div>
    </div>
  </section>

  <CaseCardGrid id="cases" columns={3} cases={cases} />
</Layout>
