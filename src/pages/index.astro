          </div>
        </div>
      </div>

      <div class="section-item biz-item biz-item--factory">
        <!-- TODO: 배경 이미지 삽입 -->
        <div class="biz-bg-ph" aria-hidden="true"></div>
        <p class="biz-eyebrow">Business</p>
        <div class="biz-body">
          <div class="biz-head">
            <div class="biz-title-row">
              <p class="biz-title">{smartFactorySlide.title}</p>
              <!-- TODO: 화살표 아이콘 이미지 삽입 -->
              <span class="biz-arrow-ph" aria-hidden="true"></span>
            </div>
            <p class="biz-desc" set:html={smartFactorySlide.desc} />
          </div>
          <div class="biz-cols biz-cols--factory">
            <div class="biz-dataflow-col">
              <div class="biz-dataflow-row">
                {
                  smartFactorySlide.dataFlow.map((text) => (
                    <div class="biz-datacircle">
                      {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                      <span class="biz-datacircle-icon-ph" aria-hidden="true" />
                      <p>{text}</p>
                    </div>
                  ))
                }
              </div>
              <div class="biz-flow-row">
                {
                  smartFactorySlide.processTags.map((text) => (
                    <div class="biz-flow-tag">
                      <span class="biz-flow-line" aria-hidden="true" />
                      <p>{text}</p>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="biz-device-grid">
              {
                smartFactorySlide.devices.map((text) => (
                  <div class="biz-device-pill">
                    <p>{text}</p>
                  </div>
                ))
              }
            </div>
            <!-- TODO: 흐름 화살표 그래픽 이미지 삽입 -->
            <div class="biz-center-ph" aria-hidden="true"></div>
            <div class="biz-side-list biz-side-list--plain">
              {
                smartFactorySlide.rightList.map((text) => (
                  <p class="biz-side-item" set:html={text} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 5: Solution_Project — Solution 소개 / Why,M2MGLOBAL? 케이스 하이라이트 / Project 구축사례 -->
    <div class="section5-slide">
      <!-- 5-1. Solution -->
      <div class="section-item">
        <p class="sp-eyebrow">Solution</p>
        <div class="sp-head">
          <div>
            <p class="sp-title">
              {solutionOverview.title}
              <!-- TODO: 화살표 아이콘 이미지 삽입 -->
              <span class="sp-arrow-ph" aria-hidden="true"></span>
            </p>
            <p class="sp-desc">{solutionOverview.desc}</p>
          </div>
          <div class="sp-nav">
            <!-- TODO: 이전/다음 화살표 아이콘 이미지 삽입 -->
            <button class="sp-nav-btn" aria-label="이전"></button>
            <button class="sp-nav-btn" aria-label="다음"></button>
          </div>
        </div>
        <div class="sp-solution-grid">
          {
            solutionOverview.cards.map((card) => (
              <div class="sp-solution-card">
                {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                <span class="sp-solution-icon-ph" aria-hidden="true" />
                <p class="sp-solution-title">{card.title}</p>
                <div class="sp-solution-list">
                  {card.list.map((text) => (
                    <div class="sp-solution-item">
                      {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                      <span class="sp-solution-item-icon-ph" aria-hidden="true" />
                      <p>{text}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 5-2. Why, M2MGLOBAL? (농협/수협/세미마켓/서린닷컴 케이스 4건) -->
      {
        whyM2mCases.map((item) => (
          <div class="section-item">
            <p class="sp-eyebrow">Why, M2MGLOBAL?</p>
            <div class="sp-head">
              <div>
                <p class="sp-title">
                  {whyM2mIntro.title}
                  {/* <!-- TODO: 화살표 아이콘 이미지 삽입 --> */}
                  <span class="sp-arrow-ph" aria-hidden="true" />
                </p>
                <p class="sp-desc">{whyM2mIntro.desc}</p>
              </div>
              <div class="sp-nav">
                {/* <!-- TODO: 이전/다음 화살표 아이콘 이미지 삽입 --> */}
                <button class="sp-nav-btn" aria-label="이전" />
                <button class="sp-nav-btn" aria-label="다음" />
              </div>
            </div>
            <div class="sp-why-body">
              <div class="sp-why-main">
                <div class="sp-why-head">
                  {/* <!-- TODO: 로고 이미지 삽입 --> */}
                  <span class="sp-why-logo-ph" aria-hidden="true" />
                  <p class="sp-why-subtitle">Why, M2MGlobal?</p>
                  <p class="sp-why-case-desc" set:html={item.desc} />
                </div>
                <div class="sp-why-features">
                  {whyM2mFeatureCols.map((col) => (
                    <div class="sp-why-feature">
