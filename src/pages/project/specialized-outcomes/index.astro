---
// Project > Specialized Outcomes (/project/specialized-outcomes)
// Figma "프로젝트 전체" 섹션의 4개 프레임(Specialized Outcomes 개요 / Semimarket / SORIN /
// CJ대한통운 로봇물류)을 한 페이지 앵커탭으로 통합 — 사용자가 AskUserQuestion에서
// "한 페이지 안 앵커탭" 구조를 선택했고, 다른 멀티탭 페이지들과 동일한 패턴이다.
//
// 참고: 개요 탭 상단의 원형/네트워크 그래픽, Semimarket/SORIN의 화면 스크린샷 갤러리,
// CJ대한통운의 "동작 구현 화면" 대형 이미지·PC/Tablet 화면 스크린샷은 전부 이미지라
// 사용자 지시에 따라 빈 자리만 남기고 코딩하지 않았다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
