              description="사이즈 sm + tight"
              size="sm"
              tight
            />
          </Box>
        </DemoBlock>
        <DemoBlock label={`/ai-engine/ai-commerce Level 카드 — Box + BoxTitleCase4(tight)`}>
          <Box>
            <BoxTitleCase4 label="Level" title="1" tight />
          </Box>
        </DemoBlock>
      </div>
    </div>

    <div class="sg-block">
      <h3 class="sg-block__title">
        ④ UiBoxCase1~3 — Box+BoxTitleCase 조합을 아예 하나로 묶은 래퍼
      </h3>
      <p class="sg-block__desc">
        위 ③에서 페이지마다 매번 <code>&lt;Box&gt;&lt;BoxTitleCaseN /&gt;...&lt;/Box&gt;</code>를
        직접 조립하는 대신, 자주 쓰는 조합은 아예 컴포넌트로 미리 묶어둔 것이 <code
          >UiBoxCase1~3</code
        >입니다 — 결국 안에서 똑같이 <code>Box</code> + <code>BoxTitleCaseN</code>을 렌더합니다(소스
        참고).
        <code>UiBoxCase1</code>은 <code>BoxTitleCase1</code>과 마찬가지로 실사용 페이지가 없는 죽은
        코드입니다.
      </p>
      <SourceBlock title="UiBoxCase1" code={uiBoxCase1Usage} />
      <SourceBlock title="UiBoxCase2" code={uiBoxCase2Usage} />
      <SourceBlock title="UiBoxCase3" code={uiBoxCase3Usage} />
      <div class="sgd__grid sgd__grid--wide">
        <DemoBlock label="UiBoxCase1 (⚠️ 미사용) — Box + BoxTitleCase1 조합">
          <UiBoxCase1 icon={sampleIcon} label="Label" title="Box+BoxTitleCase1 조합">
            본문 슬롯
          </UiBoxCase1>
        </DemoBlock>
        <DemoBlock label="UiBoxCase2 — Box + BoxTitleCase2 조합 (useBackground)">
          <UiBoxCase2 label="Label" title="Box+BoxTitleCase2 조합" useBackground>
            본문 슬롯
          </UiBoxCase2>
        </DemoBlock>
        <DemoBlock label="UiBoxCase3 — Box + 슬롯 3분할(slotHead/기본/slotFoot)">
          <UiBoxCase3>
            <Fragment slot="slotHead">
              <p>slotHead 영역</p>
            </Fragment>
            본문 슬롯(기본)
            <Fragment slot="slotFoot">
              <p>slotFoot — 넘기면 자동으로 useSlotFoot 켜짐</p>
            </Fragment>
          </UiBoxCase3>
        </DemoBlock>
      </div>
    </div>
  </section>

  <section id="icontitle" class="sg-section">
