---
// Title 공통 컴포넌트 — 페이지/섹션 타이틀 3종
// 참고: https://comet-take-17267726.figma.site/data-display ("Title" 섹션)
//
// hero: 페이지 최상단 대형 타이틀(48px, 중앙 정렬) — 서브 설명 유무 선택
// section: 좌측 컬러바 + "prefix + highlight" 형태 섹션 소제목(30px)
// banner: 어두운 배경(Secondary color) 강조 배너 바 — 진행 중인 프로젝트/서비스명 등에 사용
//
// 사용 예:
//   <Title variant="hero" title="e-Commerce" subtitle={['Service에 Commerce Platform을 더하다!', '다수의 커머스 플랫폼 수행 경험을 바탕으로...']} />
//   <Title variant="section" prefix="General " highlight="Overview" subtitle="추천 시스템은 ..." />
//   <Title variant="banner" title="M2M-MES" caption="Manufacturing Execution System" />

export interface Props {
  variant?: 'hero' | 'section' | 'banner'
  title?: string
  /** hero: 줄 단위 배열(2줄) · banner: 미사용 */
  subtitle?: string[]
  /** section 전용: 컬러 처리되지 않는 앞부분 (예: 'General ') */
  prefix?: string
  /** section 전용: primary 색으로 강조되는 부분 (예: 'Overview') */
  highlight?: string
  /** banner 전용: 타이틀 옆에 붙는 작은 설명 */
  caption?: string
  class?: string
}

const {
  variant = 'hero',
  title,
  subtitle = [],
  prefix,
  highlight,
  caption,
  class: className
} = Astro.props

const classes = ['title', `title--${variant}`, className].filter(Boolean).join(' ')
---

<div class={classes}>
  {
    variant === 'hero' && (
      <>
        <p class="title__main">{title}</p>
        {subtitle.length > 0 && (
          <div class="title__sub">
            {subtitle.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        )}
      </>
    )
  }

  {
    variant === 'section' && (
      <>
        <div class="title__row">
          <span class="title__bar" aria-hidden="true" />
          <p class="title__heading">
            {prefix}
            <span class="title__highlight">{highlight}</span>
          </p>
        </div>
        {subtitle.length > 0 && (
          <div class="title__sub">
            {subtitle.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        )}
      </>
    )
  }

  {
    variant === 'banner' && (
      <>
        <p class="title__banner-text">{title}</p>
        {caption && <p class="title__banner-caption">{caption}</p>}
      </>
    )
  }
</div>
