---
// Project > Specialized Outcomes (/project/specialized-outcomes)
// Figma "프로젝트 전체" 섹션의 4개 프레임(Specialized Outcomes 개요 / Semimarket / SORIN /
// CJ대한통운 로봇물류)을 한 페이지 앵커탭으로 통합 — 사용자가 AskUserQuestion에서
// "한 페이지 안 앵커탭" 구조를 선택했고, 다른 멀티탭 페이지들과 동일한 패턴이다.
//
// 참고: 개요 탭 상단의 원형/네트워크 그래픽, Semimarket/SORIN의 "특별한 성과" 화면 스크린샷은
// 이미지라 자리만 남기고, 그 아래 TitleThird 캡션(Figma 실측: 이미지+캡션 상하 조합)만 구현했다.
// "CJ대한통운 로봇물류" 탭은 /robot-logistics/overview#cases와 완전히 동일한 내용이라
// 컴포넌트화된 <CaseStudySection/>을 그대로 재사용한다(id만 이 페이지의 탭 앵커에 맞게 덮어씀).
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleThird from '~/components/common/TitleThird.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import EL_SOLUT_MR007 from '~/assets/images/common/el_solut_mr007.png'
import EL_SOLUT_MR008 from '~/assets/images/common/el_solut_mr008.png'
import EL_SOLUT_MR009 from '~/assets/images/common/el_solut_mr009.png'
import EL_SOLUT_MR010 from '~/assets/images/common/el_solut_mr010.png'
import EL_SOLUT_MR011 from '~/assets/images/common/el_solut_mr011.png'
import EL_SOLUT_MR012 from '~/assets/images/common/el_solut_mr012.png'
import EL_SOLUT_MR013 from '~/assets/images/common/el_solut_mr013.png'
