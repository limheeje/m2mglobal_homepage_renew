---
// Box 공통 컴포넌트 — 포인트 카드 (아이콘/번호 + 라벨 + 타이틀 + 설명)
// 참고: https://comet-take-17267726.figma.site/card-list ("Box" 섹션)
//
// bordered: 흰 배경 + 테두리, 보통 아이콘과 함께 사용
// filled: 연회색(#f1f1f1) 배경, 보통 번호(01, 02..)와 함께 사용
//
// description은 Figma 원본처럼 특정 단어만 강조색으로 표시하고 싶으면 default slot에
// <mark>로 직접 마크업하고(=> primary 색으로 표시됨), 단순 텍스트만 필요하면 description prop만 써도 된다.
//
// 사용 예:
//   <Box icon="ico_download" label="POINT 1" title={['플랫폼 전문', '구축 역량']}>
//     <mark>이커머스, 물류, 클라우드, AI, 모바일</mark> 등 다양한 산업 분야에서
//     <mark>20년 이상 축적</mark>된 노하우와 성과를 보유한 전문 기업
//   </Box>
//   <Box variant="filled" number="01" label="POINT 1" title={['플랫폼 전문', '구축 역량']} description="..." />

import Label from '~/components/Label.astro'
import IconCircle from '~/components/IconCircle.astro'

export interface Props {
  variant?: 'bordered' | 'filled'
  /** src/assets/icons/{name}.svg — 100px 원형 배경(blue-10) 안에 표시 */
  icon?: string
  /** filled variant에서 아이콘 대신 쓰는 순번 표기 (예: '01') */
  number?: string
  label?: string
  /** 2줄까지 지원 (Figma 원본이 2줄 고정 레이아웃) */
  title: string[] | string
  /** 강조 스타일 없이 단순 텍스트만 필요할 때. 강조가 필요하면 default slot에 <mark> 사용 */
  description?: string
  class?: string
}

const {
  variant = 'bordered',
  icon,
  number,
  label,
  title,
  description,
  class: className
} = Astro.props

const titleLines = Array.isArray(title) ? title : [title]
const classes = ['box', `box--${variant}`, className].filter(Boolean).join(' ')
const hasDescriptionSlot = Astro.slots.has('default')
---

<div class={classes}>
  {icon && <IconCircle icon={icon} />}
  {number && <p class="box__number">{number}</p>}

  <div class="box__head">
    {label && <Label class="box__label">{label}</Label>}
    <p class="box__title">
      {
        titleLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
  </div>

  {
    (description || hasDescriptionSlot) && (
      <p class="box__desc">{hasDescriptionSlot ? <slot /> : description}</p>
    )
  }
</div>
