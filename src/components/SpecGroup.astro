---
// SpecGroup 공통 컴포넌트 — pill 타이틀 + label:value 행 목록
// 원래 /ai-engine/machine-learning 페이지에서 "ai-ml__spec-group"라는 페이지 전용 클래스로
// 중복 구현되던 마크업(구축 가능 분야 / 주요 기술 스택)을 공용 컴포넌트로 분리한 것 — 스타일은
// 그 당시 ai-ml__spec-group 기준을 그대로 유지한다.
//
// 참고: Robot Logistics/e-Commerce/Company에도 label:value 행을 보여주는 비슷한 페이지 전용
// 클래스(rl__spec-row, ec__spec-row, company-info__spec-row)가 있지만, pill 타이틀 유무·정렬
// 방식(space-between vs 좌측 정렬)·그리드 구조(Row/Col vs flex)가 서로 달라 이 컴포넌트로
// 임의 통합하지 않았다 — 필요해지면 그때 Figma 재확인 후 통합 여부를 판단할 것.
//
// 사용 예:
//   <SpecGroup
//     title="구축 가능 분야"
//     rows={[{label: 'AI 추천 플랫폼', value: '개인화 추천·연관 추천 제공'}]}
//   />

export interface Props {
  /** 그룹 상단 pill 라벨 (예: '구축 가능 분야') */
  title: string
  rows: {label: string; value: string}[]
  class?: string
}

const {title, rows, class: className} = Astro.props
const classes = ['spec-group', className].filter(Boolean).join(' ')
---

<div class={classes}>
  <p class="spec-group__pill">{title}</p>
  <div class="spec-group__list">
    {
      rows.map((row) => (
        <div class="spec-group__row">
          <span class="spec-group__label">{row.label}</span>
          <span class="spec-group__value">{row.value}</span>
        </div>
      ))
    }
  </div>
</div>
