---
// TextList 공통 컴포넌트 — 체크 아이콘 + 텍스트 리스트 아이템
// 참고: https://comet-take-17267726.figma.site/data-display ("Text List" 섹션)
//
// default: 배경 없이 텍스트만 · highlighted: 연회색 배경 박스로 강조(선택/hover 표현용)
//
// 사용 예:
//   <ul>
//     <li><TextList>Text List</TextList></li>
//     <li><TextList highlighted>Text List</TextList></li>
//   </ul>

import Icon from '~/components/Icon.astro'

export interface Props {
  highlighted?: boolean
  class?: string
}

const {highlighted = false, class: className} = Astro.props
const classes = ['text-list', highlighted && 'text-list--highlighted', className]
  .filter(Boolean)
  .join(' ')
---

<div class={classes}>
  <Icon name="ico_check_circle" size={18} class="text-list__icon" />
  <p class="text-list__text"><slot /></p>
</div>
