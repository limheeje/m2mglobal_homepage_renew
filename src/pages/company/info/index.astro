---
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleThird from '~/components/common/TitleThird.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import UiBoxCase1 from '~/components/ui/box/UiBoxCase1.astro'
import UiBoxCase2 from '~/components/ui/box/UiBoxCase2.astro'
import UiBoxCase3 from '~/components/ui/box/UiBoxCase3.astro'
import UiNoti from '~/components/ui/box/UiNoti.astro'
import UiTags from '~/components/ui/box/UiTags.astro'
import BoxTitleCase3 from '~/components/ui/box/boxTitleCase/BoxTitleCase3.astro'
import BoxTitleCase4 from '~/components/ui/box/boxTitleCase/BoxTitleCase4.astro'
import BoxTitleCase5 from '~/components/ui/box/boxTitleCase/BoxTitleCase5.astro'
import Label from '~/components/common/Label.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'

const localNavigation = route.find((item) => item.href === '/company/info')
---

<Layout>
  <SubBanner
    title="Company"
    description="Where AI Transformation Begins—Turning Market Change into Speed and Direction<br/>24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner"
  />
  <TitleMain
    pageName="나다"
    title="Company"
    description="Where AI Transformation Begins—Turning Market Change into Speed and Direction<br/>24 Years of Proven Success, Now Powered by AI. Your AI-Driven e-Commerce Technology Partner"
  />
  <TitleSub title={`Company<span class="mark">Company</span>`} description="Where " />
  <TitleThird>메인화면</TitleThird>
  <TitleMiddle>메인화면<span class="mark">asdfasdf</span></TitleMiddle>
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-1'} />
  <UiBoxCase1 label="laellll" title="titletitle" icon={ICON_KEY_NAME['AI & Machine Learning2-3']}>
    이커머스, 물류, 클라우드, AI, 모바일 등 다양한 산업 분야에서 20년 이상 축적된 노하우와 성과를
    보유한 전문 기업
  </UiBoxCase1>
  <UiBoxCase2 label="laellll" title="titletitle">
    이커머스, 물류, 클라우드, AI, 모바일 등 다양한 산업 분야에서 20년 이상 축적된 노하우와 성과를
    보유한 전문 기업
  </UiBoxCase2>
  <UiBoxCase3>
    <Fragment slot="slotHead">
      <BoxTitleCase3 title="titletitle" icon={ICON_KEY_NAME['AI & Machine Learning2-3']} />
    </Fragment>
    이커머스, 물류, 클라우드, AI, 모바일 등 다양한 산업 분야에서 20년 이상 축적된 노하우와 성과를 보유한
    전문 기업
  </UiBoxCase3>
  <UiBoxCase3 title="titletitle" icon={ICON_KEY_NAME['AI & Machine Learning2-3']}>
    <Fragment slot="slotHead">
      <BoxTitleCase4 title="titletitle" label="labelelelelelel" prefix="1차/2차" />
    </Fragment>
    이커머스, 물류, 클라우드, AI, 모바일 등 다양한 산업 분야에서 20년 이상 축적된 노하우와 성과를 보유한
    전문 기업
  </UiBoxCase3>
  <UiBoxCase3 title="titletitle" icon={ICON_KEY_NAME['AI & Machine Learning2-3']}>
    <Fragment slot="slotHead">
      <BoxTitleCase5
        icon={ICON_KEY_NAME['AI & Machine Learning2-3']}
        title="titletitle"
        description="descriptiondescriptiondescriptiondescription"
      />
    </Fragment>
    이커머스, 물류, 클라우드, AI, 모바일 등 다양한 산업 분야에서 20년 이상 축적된 노하우와 성과를 보유한
    전문 기업
    <UiTags items={[{codeId: 1, codeName: '#sdfsdfsdf'}]} />
    asdfasdf
    <UiNoti />
    asdfasdf
    <Fragment slot="slotFoot"> slotFoot </Fragment>
  </UiBoxCase3>
  <Label type="type_1">LabelLabelLabel</Label>
  <TextList>asdfsdf</TextList>
  <TextList type="type_2">asdfsdf</TextList>
</Layout>
