---
const {title = '', description = ''} = Astro.props
---

<div class="bs-main-title">
  <div class="innerWrap">
    {
      description ? (
        <div class="bms-texts">
          <div class="bm-title" set:html={title} />
          <div class="bm-description" set:html={description} />
        </div>
      ) : (
        <div class="bm-page-name" set:html={title} />
      )
    }
  </div>
</div>
