---
import Box from '~/components/common/Box.astro'

const useSlotFoot = Astro.slots.has('slotFoot')
---

<Box useSlotFoot={useSlotFoot}>
  <slot name="slotHead" />
  <div class="bs-gl-content">
    <slot />
  </div>
  {
    useSlotFoot && (
      <div class="bs-gl-bottom">
        <slot name="slotFoot" />
      </div>
    )
  }
</Box>
