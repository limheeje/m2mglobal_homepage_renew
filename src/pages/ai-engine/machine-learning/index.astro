---
// AI Engine > AI & Machine Learning (/ai-engine/machine-learning)
// Figma "AI > AI & Machine Learning" 5개 프레임(서비스 특징 / 핵심기능 / 비즈니스 구성도 /
// 구축분야 및 기술 스택 / 구축사례) — 전부 같은 Tap_box_series 앵커 탭의 상태라 한 페이지로 합쳤다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleThird from '~/components/common/TitleThird.astro'
import TitleMiddle from '~/components/common/TitleMiddle.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import stepArrowUrl from '~/assets/images/step-arrow.svg'
import {ICON_KEY_NAME} from '~/constants/Icon'
import Icon from '~/components/common/Icon.astro'
import CaseCardGrid from '~/components/common/CaseCardGrid.astro'

const localNavigation = route.find((item) => item.href === '/ai-engine/machine-learning')
const PUBLIC_BUILD_URL = import.meta.env.PUBLIC_BUILD_URL

const sectionTabs = [
  {id: 'features', label: '서비스 특징'},
  {id: 'core', label: '핵심기능'},
  {id: 'architecture', label: '비즈니스구성도'},
  {id: 'stack', label: '구축분야 및 기술 스택'},
  {id: 'cases', label: '구축 사례'}
]

// --- 서비스 특징: 아이콘+타이틀+체크리스트 카드 4개 ---
const features = [
  {
    icon: ICON_KEY_NAME['AI & Machine Learning1-1'],
    title: '개인화 추천 시스템',
    items: [
      'Collaborative Filtering',
      'Content-Based Recommendation',
      'Learning-to-Rank',
      'Hybrid Recommendation',
      'Real-time Re-ranking'
    ]
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning1-2'],
    title: '사용자 행동 분석',
    items: [
      'KMeans Clustering',
      'Similarity Analysis',
      'Feature Engineering',
      'User Segmentation',
      '이탈 위험 탐지'
    ]
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning1-3'],
    title: 'AI 기반 이미지 분석',
    items: [
      'YOLO 기반 객체 탐지',
      'ONNX Runtime 최적화',
      '경량 AI 모델 운영',
      '실시간 이미지 검증',
      '자동 품질 검사'
    ]
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning1-4'],
    title: '운영 환경 최적화',
    items: [
      'On-Premise / Cloud',
      'GPU / Non-GPU 환경',
      '대용량 데이터 처리',
      'Docker 컨테이너 기반',
      'MSA 아키텍처'
    ]
  }
]

// --- 핵심기능: 아이콘+타이틀+설명 카드 6개 ---
const coreFeatures = [
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-1'],
    title: '데이터 수집',
    desc: '이벤트/로그/CSV 등<br/>다양한 소스 수집 파이프라인'
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-2'],
    title: '실시간 이벤트 처리',
    desc: 'Kafka 기반 스트리밍 이벤트 수집 및 처리'
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-3'],
    title: '배치 학습 시스템',
    desc: '주기적 모델 재학습 및 성능 평가'
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-4'],
    title: '추천 API 서버',
    desc: 'FastAPI/Spring Boot 기반 지연 추천 서비스'
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-5'],
    title: '정보 조회',
    desc: '모델 운영관리/A/B 비교·롤백'
  },
  {
    icon: ICON_KEY_NAME['AI & Machine Learning2-6'],
    title: '정보 조회',
    desc: '운영 지표 모니터링 및 성능 분석'
  }
]

// --- 비즈니스 구성도: End-to-End 플로우 5단계 ---
const flowStages = [
  {title: 'Data Source', items: ['사용자 이벤트', '클릭·구매·열람 로그']},
  {title: 'Data Pipeline', items: ['실시간 스트리밍', 'Kafka 이벤트 처리']},
  {title: 'ML Engine', items: ['배치 학습', 'PyTorch·LightGBM', 'Scikit-learn']},
  {title: 'Serving', items: ['추천 API', 'FastAPI / Spring Boot']},
  {title: 'Operation', items: ['모델 버전 관리', 'A/B 비교·롤백']}
]

// --- 구축분야 및 기술 스택 ---
const buildFields = [
  {title: 'AI 추천 플랫폼', desc: '개인화 추천·웹장·유지경 제공'},
  {title: 'AI 커머스 플랫폼', desc: '행동 분석 기반 카테고리 최적화'},
  {title: '스마트 물류 시스템', desc: '수요 예측, 재고 최적화'},
  {title: '수요 예측 시스템', desc: '시계열 데이터 분석'},
  {title: '고객 행동 분석', desc: '세그먼트 정의 및 분류'},
  {title: 'AI 이미지 분석', desc: '제품 탐지 및 품질 검사'}
]
const techStack = [
  {title: 'Backend', desc: 'Java · Spring Boot · Python · FastAPI'},
  {title: 'AI / ML', desc: 'PyTorch · Scikit-learn · LightGBM · ONNX Runtime'},
  {title: 'Data', desc: 'MySQL · MSSQL · Redis · Kafka'},
  {title: 'Infra', desc: 'AWS · Docker · Linux · Nginx'}
]

// --- 구축 사례 ---
const cases = [
  {
    imageSrc: `${PUBLIC_BUILD_URL}/images/banner/banner001.png`,
    title: '수협중앙회 쇼핑몰 재구축',
    date: '2025.03 ~ 2026.03',
    desc: 'AI 데이터 분석 기법을 활용한 고객 맞춤형 상품 자동 추천 기능'
  },
  {
    imageSrc: `${PUBLIC_BUILD_URL}/images/banner/banner002.png`,
    title: '서플러스글로벌 반도체장비 마켓플레이스 구축',
    date: '2025.08 ~ 2026.01',
    desc: 'AI 기반 자동화 상품추천'
  }
]
---

<Layout>
  <SubBanner
    title="AI Engine"
    description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>모듈화 된 e-Commerce 아키텍처+AI를 결합하여 Commerce Platform에 속도와 생산성을 높입니다."
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-AI-ENGINE-ID-1'} />
  <TitleMain
    title="AI & Machine Learning"
    description="데이터 기반 AI 추천 및 예측 플랫폼으로 비즈니스 성과를 극대화하는<br/>End-to-End AI/ML 솔루션을 제공합니다."
  />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="features" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`서비스 <span class="mark">특징</span>`}
        description="M2M-AI/ML 솔루션은 데이터 수집부터 모델 학습, 실시간 추론, 운영 모니터링까지 전 주기를 지원하며, End-to-End AI 파이프라인을 제공하여 다양한 사업 환경에 맞춘 AI 서비스를 효율적으로 제공합니다."
      />
      <div class="ai__feature-grid">
        {
          features.map((feature) => (
            <div class="ai__feature-card">
              <div class="ai__feature-head">
                {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                <span class="ai__feature-icon" aria-hidden="true">
                  <Icon name={feature.icon} />
                </span>
                <p class="ai__feature-title">{feature.title}</p>
              </div>
              <div>
                {feature.items.map((item) => (
                  <TextList>{item}</TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="core" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`M2M-AI/ML <span class="mark">핵심 기능</span>`}
        description="AI 모델 학습부터 실시간 추론, 운영 모니터링까지 전 주기를 지원합니다."
      />
      <div class="ai__stat-grid">
        {
          coreFeatures.map((feature) => (
            <div class="ai__stat-card">
              {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
              <span class="ai__stat-icon" aria-hidden="true">
                <Icon name={feature.icon} />
              </span>
              <p class="ai__stat-title">{feature.title}</p>
              <p class="ai__stat-desc" set:html={feature.desc} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="architecture" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`M2M-AI/ML <span class="mark">비즈니스 구성도</span>`}
        description="데이터 수집 → 확충 → 서빙 → 모니터링까지의 End-to-End AI 플랫폼 아키텍처"
      />
      <div class="ai__flow">
        {
          flowStages.map((stage, i) => (
            <>
              <div class="ai__flow-box">
                <p class="ai__flow-title">{stage.title}</p>
                {stage.items.map((item) => (
                  <TextList>{item}</TextList>
                ))}
              </div>
              {i < flowStages.length - 1 && (
                <span class="ai__flow-arrow" aria-hidden="true">
                  <img src={stepArrowUrl.src} alt="" />
                </span>
              )}
            </>
          ))
        }
      </div>
      <TitleMiddle>
        Deployment Infrastructure: AWS / On-Premise · Docker · Linux · Nginx · GPU/Non-GPU 환경 지원
      </TitleMiddle>
    </div>
  </section>

  <section id="stack" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`구축 가능 분야 및 <span class="mark">기술 스택</span>`}
        description="다양한 산업 도메인에 적용 가능한 AI 솔루션과 검증된 기술 스택을 제공합니다."
      />

      <div class="ai__spec-group">
        <TitleThird>구축 가능 분야</TitleThird>
        <div class="ai__spec-rows">
          {
            buildFields.map((field) => (
              <div class="ai__spec-row">
                <span class="ai__spec-label">{field.title}</span>
                <span class="ai__spec-value">{field.desc}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="ai__spec-group">
        <TitleThird>주요 기술 스택</TitleThird>
        <div class="ai__spec-rows">
          {
            techStack.map((stack) => (
              <div class="ai__spec-row">
                <span class="ai__spec-label">{stack.title}</span>
                <span class="ai__spec-value">{stack.desc}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CaseCardGrid id="cases" columns={2} cases={cases} />
</Layout>
