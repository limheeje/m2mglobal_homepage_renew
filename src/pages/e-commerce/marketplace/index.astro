---
// e-Commerce > Marketplace (/e-commerce/marketplace)
// Figma "e-Commerce > Marketplace" 3개 프레임(거래 중개 구조 / 제공기술 및 특징 /
// Auction Platform (eLivestock)) — 전부 같은 Tap_series(box 스타일) 앵커 탭의 상태라 한 페이지로 합쳤다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import Label from '~/components/common/Label.astro'

const localNavigation = route.find((item) => item.href === '/e-commerce/commerce-technology')

const sectionTabs = [
  {id: 'structure', label: '거래 중개 구조'},
  {id: 'features', label: '제공기술 및 특징'},
  {id: 'auction', label: 'Auction Platform (eLivestock)'}
]

// --- 거래 중개 구조: SELLER / MARKETPLACE / BUYER ---
const roles = [
  {
    label: 'SELLER',
    title: '판매자',
    items: ['입점 신청 · 심사', '상품 · 재고 등록', '주문 처리 · 발송', '정산 내역 조회']
  },
  {
    label: 'MARKETPLACE',
    title: '거래 중개 플랫폼',
    accent: true,
    items: [
      '상품 노출 · 검색',
      '가격 · 경매 매칭',
      '안전 결제(에스크로)',
      '주문 분할 · 배송 추적',
      '수수료 산정 · 정산',
      '클레임 중재'
    ]
  },
  {
    label: 'BUYER',
    title: '구매자',
    items: ['상품 검색 · 비교', '주문 · 입찰', '결제 · 수령 확인', '리뷰 · 클레임']
  }
]
const operationSteps = [
  '입점 심사 · 계약',
  '판매자 등급 · 평가',
  '상품 검수 · 노출 정책',
  '수수료 정책 관리',
  '정산 · 지급 대행'
]

// --- 제공기술 및 특징 (3개) ---
const featureCards = [
  {
    title: '플랫폼',
    items: [
      ['오픈마켓 (Open Marketplace)', '누구나 입점·판매 가능한 개방형 거래 채널'],
      ['Multi Seller Platform', '다수 판매자의 상품·가격·재고 독립 운영'],
      ['거래 중개 플랫폼', '구매자–판매자 매칭 및 안전거래 중개']
    ]
  },
  {
    title: '판매자 운영',
    items: [
      ['Seller Center', '상품 등록·주문 처리·정산 조회 전용 포털'],
      ['Vendor Management', '입점 심사·등급·평가·제재 정책 관리']
    ]
  },
  {
    title: '거래 완결',
    items: [
      ['Auction Platform (eLivestock)', '실시간 온라인 경매 · 입찰 · 낙찰 처리'],
      ['수수료 및 정산 시스템', '판매자별 수수료율 자동 산정 및 지급'],
      ['주문 · 배송 통합 관리', '다중 판매자 주문 분할·합배송·클레임 관리']
    ]
  }
]

// --- Auction Platform (eLivestock) ---
const auctionFeatures = [
  {
    title: '실시간 모바일 경매',
    desc: '상장된 경매 상품의 진행 현황과 입찰 상태를 실시간 확인 및 참여'
  },
  {
    title: '개체,부분육경매지원',
    desc: '축종 별(한우, 돼지) 개체 및 부분육 경매 지원, 다양한 거래 방식 제공'
  },
  {
    title: '실시간 응찰, 낙찰관리',
    desc: '실시간 응찰 참여 - 낙찰(결과)확인 및 관련 업무 기능 제공'
  },
  {
    title: '배송지시, 출고 관리',
    desc: '낙찰 상품 배소 지시 및 출고까지 거래 이후 업무를 체계적으로 관리'
  },
  {title: '정산, 증명서 발급', desc: '정산 처리 및 거래 증명서 발급으로 업무 간소화'},
  {title: '경매 정보, 시세 조회', desc: '경매 정보, 부위별 시세를 조회하여 합리적인 의사 결정 지원'}
]
const auctionUsers = [
  {title: '중도매인', desc: '실시간 응찰, 낙찰, 거래 관리'},
  {title: '상장업체', desc: '경매 등록, 출고, 정산 관리, 컨텐츠 관리'},
  {title: '관리자', desc: '회원(계정)관리, 경매관리, 거래운영 및 통계관리, 시스템관리'}
]
const auctionScope = [
  {title: '축종', desc: '한우, 돼지'},
  {title: '거래단위', desc: '개체, 지육/ 부분육'},
  {title: '채널', desc: '모비일앱, 관리자 웹, 상장업체웹, 중도매인 웹'}
]
const auctionFlow = ['상장', '실시간 경매 / 응찰하기', '낙찰(결과)', '배송지시', '정산']
---

<Layout>
  <SubBanner
    title="e-Commerce"
    description={`Commerce Platform에 속도와 생산성을 높이다.<br/>"Front –BackOffice-Interface" 모듈화 된 e-Commerce 아키텍처! AI와 융합 및 빠른 구축과 확장성을 제공합니다.`}
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-E-COMMERCE-ID-3'} />
  <TitleMain
    title="Marketplace"
    description={`"오픈마켓 · 멀티셀러 · 실시간 경매" 다수의 판매자와 구매자를 연결하는 중개 거래 플랫폼을 제공합니다.<br/>입점 관리부터 수수료 정산 · 주문 · 배송 통합 관리까지 마켓 운영 전 주기를 지원합니다.`}
  />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="structure" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`거래 <span class="mark">중개 구조</span>`} />
      <div class="ec__role-grid">
        {
          roles.map((role) => (
            <div class:list={['ec__role-card', {'ec__role-card--accent': role.accent}]}>
              <div class="ec__role-head">
                <Label type="type_2">{role.label}</Label>
                <p class="ec__role-title">{role.title}</p>
              </div>
              <div>
                {role.items.map((text) => (
                  <TextList>{text}</TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <TitleSub title={`플랫폼 <span class="mark">운영</span>`} />
      <div class="ec__box-grid ec__box-grid--5">
        {
          operationSteps.map((title) => (
            <div class="ec__stat-card">
              {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
              <span class="ec__stat-icon" aria-hidden="true" />
              <p class="ec__stat-title">{title}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="features" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`제공 <span class="mark">기술 및 특징</span>`} />
      <div class="ec__feature-grid">
        {
          featureCards.map((card) => (
            <div class="ec__feature-card">
              <div class="ec__feature-head">
                {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
                <span class="ec__feature-icon" aria-hidden="true" />
                <p class="ec__feature-title">{card.title}</p>
              </div>
              <div>
                {card.items.map((lines) => (
                  <TextList>
                    {lines[0]}
                    <br />
                    {lines[1]}
                  </TextList>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="auction" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`Auction Platform <span class="mark">(eLivestock)</span>`}
        description={`M2M-eLivestock은 "eLiveBid ↔ BackOffice ↔ Interface" 기반으로 축산전문경매플랫폼으로 상장부터 경매, 낙찰, 정산, 출고까지 축산물 거래 전 과정을 디지털화하여 신속하고 투명한 경매 플랫폼입니다.`}
      />

      <p class="ec__layer-label">주요 기능</p>
      <div>
        {
          auctionFeatures.map((item) => (
            <div class="ec__pair-row">
              <p class="ec__pair-title">{item.title}</p>
              <p class="ec__pair-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <p class="ec__layer-label ec__block">이용 대상</p>
      <div>
        {
          auctionUsers.map((item) => (
            <div class="ec__pair-row">
              <p class="ec__pair-title">{item.title}</p>
              <p class="ec__pair-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <p class="ec__layer-label ec__block">지원 범위</p>
      <div>
        {
          auctionScope.map((item) => (
            <div class="ec__pair-row">
              <p class="ec__pair-title">{item.title}</p>
              <p class="ec__pair-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="ec__block">
        <TitleSub title={`경매 <span class="mark">절차</span>`} />
      </div>
      <div class="ec__flow">
        {
          auctionFlow.map((stage, i) => (
            <>
              <div class="ec__flow-item">
                <div class="rl__process-stage">
                  <p class="rl__process-stage-title">{stage}</p>
                </div>
              </div>
              {i < auctionFlow.length - 1 && (
                <span class="ec__flow-arrow" aria-hidden="true">
                  ›
                </span>
              )}
            </>
          ))
        }
      </div>
      <p class="ec__flow-note">유찰 시 재경매 회차 편성</p>
    </div>
  </section>
</Layout>
