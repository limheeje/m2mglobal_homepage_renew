---
// 구축사례 섹션 (재사용 컴포넌트) — 최초 /robot-logistics/overview#cases에서 추출.
// "프로젝트 전체" 등 다른 라우트에서도 완전히 동일한 내용(CJ 대한통운 APRIL 로봇통합플랫폼 구축사례)을
// 그대로 재사용하는 용도라, 모든 데이터를 컴포넌트 안에 기본값으로 내장해뒀다 — 그냥 <CaseStudySection />
// 만 써도 지금과 완전히 같은 내용이 렌더링된다. props는 나중에 다른 곳에서 진짜 다른 내용이 필요할 때만
// 있는 그대로 개별적으로 덮어쓰라고 열어둔 탈출구일 뿐, 평소엔 하나도 안 넘겨도 된다.
// 페이지 전용 scss(rl__*, ec__* 등)에 기대지 않고 자체 스타일(cs__*)만 사용한다.
// 모든 서브섹션(타임라인/구현기능/연동 제조사/다이어그램/시스템 업무 구성/디바이스 패널)은
// null을 넘기면 렌더링되지 않는 선택적(optional) 블록이다.
// Figma 실측: "시스템 업무 구성"/"주요 기능 소개"는 왼쪽 타이틀+설명(425px 고정) / 오른쪽 콘텐츠(가변)
// 좌우 배치이고, 그 외(구현기능/연동 제조사/다이어그램)는 타이틀이 전체 너비로 위에 오는 상하 배치다.
// 블록 사이 간격은 전부 80px(Figma 실측 Y좌표 차)로 고정.
import TitleSub from './TitleSub.astro'
import TitleThird from './TitleThird.astro'
import TextList from './TextList.astro'
import Icon from './Icon.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'
import SYMBOL010 from '~/assets/images/common/symbol010.png'
import SYMBOL011 from '~/assets/images/common/symbol011.png'
import SYMBOL012 from '~/assets/images/common/symbol012.png'
import IconClientCjApril from '~/assets/images/clients/ico_client_12-cjapril.png'

type TimelineData = {
  periods: {range: string; label: string; span: number}[]
  phases: {name: string; desc: string}[]
}
type FunctionsData = {
  title: string
  items: {number: string; title: string; desc: string}[]
}
type VendorTablesData = {
  title: string
  tables: string[][][] // [표][행][셀]
}
type DiagramData = {
  title: string // set:html
  thirdTitle?: string
  width: number
  height: number
}
type SystemFeaturesData = {
  title: string
  description?: string
  items: {icon?: string; title: string; items: string[]}[]
}
type DevicePanelsData = {
  title: string
  description?: string
  panels: {icon?: string; title: string; items: string[]; imgSrc?: string}[]
}

export interface Props {
  id?: string
  title?: string // <span class="mark">...</span> 포함 가능 (set:html)
  partnerLogos?: boolean // 타이틀 옆 파트너 로고 placeholder 노출 여부
  timeline?: TimelineData | null
  functions?: FunctionsData | null
  vendorTables?: VendorTablesData | null
  diagram?: DiagramData | null
  systemFeatures?: SystemFeaturesData | null
  devicePanels?: DevicePanelsData | null
}

// --- 기본값: CJ 대한통운 APRIL 로봇통합플랫폼 구축사례 (Figma 실측 그대로) ---
const DEFAULT_TITLE = `로봇기반 통합관제시스템 <span class="mark">구축 사례</span>`
const DEFAULT_TIMELINE: TimelineData = {
  periods: [
    {range: '2022.07 - 2024.12', label: '로봇물류플랫폼 기술확보', span: 3},
    {
      range: '2024.12 - 2025.12',
      label: '현장 센터 시범적용 & 운용 (국내 1위 물류 업체 협업)',
      span: 1
    }
  ],
  phases: [
    {name: '1단계(2022.07-2023.03)', desc: '이기종무인운반차(AGV) 로봇통합관제플랫폼 개발'},
    {name: '2단계(2023.05-2024.03)', desc: '이기종자율이동로봇(AMR) 로봇통합관제플랫폼개발'},
    {
      name: '3단계(2024.07-2024.12)',
      desc: '로봇(셔틀및소형AGV), 기타IT 디바이스를 통해 이커머스 택배에서 활용가능 한 로봇 운영(피킹,보관) 플랫폼 개발'
    },
    {name: '1차(2024.12-2025.03)', desc: 'AMR 25대적용(이천물류센터)'}
  ]
}
const DEFAULT_FUNCTIONS: FunctionsData = {
  title: `구현 <span class="mark">기능</span>`,
  items: [
    {number: '01', title: 'AGV 제어', desc: 'Root-Planning'},
    {number: '02', title: '해당 기종', desc: '로봇 트래픽 제어'},
    {number: '03', title: '작업자 배치 ·', desc: '주문 배치/할당 알고리즘'},
    {number: '04', title: '비동기', desc: '메시지 제어'},
    {number: '05', title: '3D Map', desc: '구현/제어'},
    {number: '06', title: 'MSA', desc: '(Micro Service Architecture)'},
    {number: '07', title: '하드웨어 제어 ·', desc: '빅데이터 수집/가공'}
  ]
}
const DEFAULT_VENDOR_TABLES: VendorTablesData = {
  title: `연동 제조사 <span class="mark">AMR / AGV</span>`,
  tables: [
    [
      ['LG', 'Cloi', 'AMR', '피킹'],
      ['ForwardX', 'Flex Series', 'AMR', '피킹'],
      ['Omron', 'LD/MD/HD', 'AMR', '피킹']
    ],
    [
      ['Geek+', 'P500R', 'AGV', '보충/피킹'],
      ['Hik', 'Q7-1000E', 'AMR', '보충/피킹'],
      ['Hik', 'F0-50DCH', 'AGV', '보충/피킹']
    ]
  ]
}
const DEFAULT_DIAGRAM: DiagramData = {
  title: `CJ 대한통운 APRIL 로봇통합플랫폼 : <span class="mark">동작 구현 화면</span>`,
  thirdTitle: 'Multi (Mobile) Device 를 활용한 CJ 대한통운 APRIL 로봇통합플랫폼 제어',
  width: 1156,
  height: 580
}
const DEFAULT_SYSTEM_FEATURES: SystemFeaturesData = {
  title: `시스템 <span class="mark">업무 구성</span>`,
  description:
    '플랫폼 통합관제, 통합정보관리, 작업관리, 사용자 시스템을 통합 구현하여 로봇 운영과 물류 업무를 하나의 플랫폼에서 효율적으로 관리할 수 있는 환경을 제공합니다.',
  items: [
    {
      icon: ICON_KEY_NAME['Business7-1'],
      title: '정보 조회',
      items: ['로봇 모니터링', '보충 작업 내역', '피킹 작업 내역']
    },
    {
      icon: ICON_KEY_NAME['Business7-2'],
      title: '센터 관리',
      items: [
        '센터 정보 관리',
        '구역 정보 관리',
        '렉 관리',
        '스테이션 관리',
        '설비관리',
        '맵 관리',
        '화주 관리'
      ]
    },
    {icon: ICON_KEY_NAME['Business7-3'], title: 'SKU 정보관리', items: []},
    {icon: ICON_KEY_NAME['Business7-4'], title: '주문관리', items: ['보충 주문', '피킹 주문']},
    {
      icon: ICON_KEY_NAME['Business7-5'],
      title: '재고관리',
      items: ['재고 조회', '재고 조사', '이상 재고 관리', '상품 점유 내역', '과잉/부족 관리']
    },
    {
      icon: ICON_KEY_NAME['Business7-6'],
      title: '시스템관리',
      items: ['권한그룹 관리', '사용자 관리', '메뉴 관리', '공통 코드 관리', '로그 관리']
    },
    {
      icon: ICON_KEY_NAME['Business7-7'],
      title: '통계',
      items: ['주문통계', '보관량 통계', '로봇 가동 통계', '작업 통계']
    },
    {
      icon: ICON_KEY_NAME['Business7-8'],
      title: '작업자',
      items: ['보충 작업', '피킹 작업', '반출 피킹', '재고 조사']
    }
  ]
}
const DEFAULT_DEVICE_PANELS: DevicePanelsData = {
  title: `주요 <span class="mark">기능 소개</span>`,
  description:
    'PC는 보충주문, 일반 피킹, 반출 피킹, 재고조사 등 운영 관리 기능을 제공하고, 태블릿은 대시보드,<br/>오더 피킹, 맵 조회, 실시간 위치 확인 등 현장 중심의 작업 지원 기능을 제공합니다.',
  panels: [
    {
      icon: ICON_KEY_NAME['pc'],
      title: 'PC',
      items: ['보충주문', '일반 피킹', '반출 피킹', '재고조사'],
      imgSrc: SYMBOL011.src
    },
    {
      icon: ICON_KEY_NAME['tablet'],
      title: 'Tablet',
      items: ['대시보드', '오더피킹', '맵 조회', '실시간 위치'],
      imgSrc: SYMBOL012.src
    }
  ]
}

const {
  id = 'cases',
  title = DEFAULT_TITLE,
  partnerLogos = true,
  timeline = DEFAULT_TIMELINE,
  functions: functionsData = DEFAULT_FUNCTIONS,
  vendorTables = DEFAULT_VENDOR_TABLES,
  diagram = DEFAULT_DIAGRAM,
  systemFeatures = DEFAULT_SYSTEM_FEATURES,
  devicePanels = DEFAULT_DEVICE_PANELS
} = Astro.props
---

<section id={id} class="g-section">
  <div class="innerWrap">
    <div class="cs__block cs__head">
      <TitleSub title={title} />
      {
        partnerLogos && (
          <div class="cs__partner-logos " aria-hidden="true">
            <img src={IconClientCjApril.src} alt="" />
          </div>
        )
      }
    </div>

    {
      timeline && (
        <div class="cs__block cs__timeline">
          <div class="cs__timeline-header">
            {timeline.periods.map((period) => (
              <div class="cs__timeline-period-group" style={`grid-column: span ${period.span};`}>
                <p class="cs__timeline-range">{period.range}</p>
                {period.span === 3 ? (
                  <p class="cs__timeline-label" style="width: 33.33%;">
                    {period.label}
                  </p>
                ) : (
                  <p class="cs__timeline-label">{period.label}</p>
                )}
              </div>
            ))}
          </div>
          <div class="cs__timeline-track">
            {timeline.phases.map((phase) => (
              <div class="cs__timeline-phase">
                <p class="cs__timeline-name">{phase.name}</p>
                <p class="cs__timeline-desc">{phase.desc}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      functionsData && (
        <div class="cs__block">
          <TitleSub title={functionsData.title} />
          <div class="cs__number-grid">
            {functionsData.items.map((fn) => (
              <div class="cs__number-card">
                <p class="cs__number-badge">{fn.number}</p>
                <p class="cs__number-text">
                  {fn.title}
                  <br />
                  {fn.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      vendorTables && (
        <div class="cs__block">
          <TitleSub title={vendorTables.title} />
          <div class="cs__vendor-tables">
            {vendorTables.tables.map((rows) => (
              <div class="cs__vendor-table">
                <div class="cs__vendor-row cs__vendor-row--head">
                  <span class="cs__vendor-cell">제조사</span>
                  <span class="cs__vendor-cell">모델</span>
                  <span class="cs__vendor-cell">유형</span>
                  <span class="cs__vendor-cell">용도</span>
                </div>
                {rows.map((row) => (
                  <div class="cs__vendor-row">
                    {row.map((cell) => (
                      <span class="cs__vendor-cell">{cell}</span>
                    ))}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      diagram && (
        <div class="cs__block">
          <TitleSub title={diagram.title} />
          {diagram.thirdTitle && <TitleThird>{diagram.thirdTitle}</TitleThird>}
          {/* TODO: 다이어그램/화면 이미지 삽입 (담당자 작업 예정) */}
          <div class="cs__diagram-box" class:list={{'cs__diagram-box--top': diagram.thirdTitle}}>
            <div class="cs__diagram-img ">
              <img src={SYMBOL010.src} alt="" />
            </div>
          </div>
        </div>
      )
    }

    {
      systemFeatures && (
        <div class="cs__block cs__split">
          <div class="cs__split-title">
            <TitleSub title={systemFeatures.title} description={systemFeatures.description} />
          </div>
          <div class="cs__split-content">
            <div class="cs__feature-grid">
              {systemFeatures.items.map((fn) => (
                <div class="cs__feature-card">
                  <span class="cs__icon-circle" aria-hidden="true">
                    <Icon name={fn.icon} />
                  </span>
                  <p class="cs__feature-title">{fn.title}</p>
                  {fn.items.length > 0 && (
                    <div class="cs__feature-list">
                      {fn.items.map((item) => (
                        <p>{item}</p>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      devicePanels && (
        <div class="cs__block cs__split">
          <div class="cs__split-title">
            <TitleSub title={devicePanels.title} description={devicePanels.description} />
          </div>
          <div class="cs__split-content">
            <div class="cs__device-box">
              <div class="cs__device-panel">
                {devicePanels.panels.map((panel, i) => (
                  <>
                    <div class="cs__device-card">
                      <div class="cs__device-head">
                        <span class="cs__icon-circle" aria-hidden="true">
                          <Icon name={panel.icon} />
                        </span>
                        <p class="cs__device-title">{panel.title}</p>
                      </div>
                      <div class="cs__device-list">
                        {panel.items.map((item) => (
                          <TextList type="type_2">{item}</TextList>
                        ))}
                      </div>
                      {panel.imgSrc ? (
                        <img class="cs__device-image" src={panel.imgSrc} alt="" />
                      ) : (
                        <>
                          {/* TODO: 화면 이미지 삽입 */}
                          <div class="cs__device-image cs__thumb-ph" aria-hidden="true" />
                        </>
                      )}
                    </div>
                    {i === 0 && devicePanels.panels.length > 1 && (
                      <span class="cs__device-connector" aria-hidden="true" />
                    )}
                  </>
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
