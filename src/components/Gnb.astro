---
// GNB (Global Navigation Bar) 공통 컴포넌트
// 참고: https://comet-take-17267726.figma.site/navigation ("GNB" 섹션)
//
// - 데스크탑(lg 이상): 가로 메뉴 + 메가메뉴 드롭다운. 드롭다운 열기는 CSS(:hover/:focus-within)만으로 처리.
// - 모바일(lg 미만): 햄버거 버튼만 노출. 실제 모바일 드로어 열고닫기 인터랙션은 스크립트 단계에서 추가 예정(TODO).
//
// 메뉴 구조를 바꿀 땐 이 파일의 `menu` 배열만 수정하면 된다 — 마크업 구조를 건드릴 필요 없음.

import logoUrl from '~/assets/images/m2m-global-logo.svg'
import Icon from '~/components/Icon.astro'

type MenuItem = {
  label: string
  href: string
  children?: {label: string; href: string}[]
}

// 참고: routeMap상 1Depth 경로(`/company`, `/ai-engine` 등) 자체는 old 사이트에 대응 페이지가 없던
// 순수 네비게이션 그룹핑 라벨이라 콘텐츠 페이지를 만들지 않았다(빈 `<Layout />` placeholder였던 걸
// 전부 삭제함). 그래서 1Depth 라벨의 href는 부모 경로가 아니라 항상 "첫 번째 2Depth 자식"으로 보낸다 —
// 데스크탑에서는 어차피 hover 시 메가메뉴가 열리지만, 클릭·모바일·키보드 접근성을 위해 실제로 존재하는
// 페이지로 이동해야 한다.
const menu: MenuItem[] = [
  {
    label: 'Company',
    href: '/company/info',
    children: [
      {label: 'Company Info', href: '/company/info'},
      {label: "CEO's Message", href: '/company/ceo-message'},
      {label: 'History', href: '/company/history'},
      {label: 'Careers', href: '/company/careers'},
      {label: 'News', href: '/company/news'},
      {label: 'Address', href: '/company/address'},
      {label: 'Contact us', href: '/company/contact-us'}
    ]
  },
  {
    label: 'AI Engine',
    href: '/ai-engine/machine-learning',
    children: [
      {label: 'AI & Machine Learning', href: '/ai-engine/machine-learning'},
      {label: 'AI Commerce', href: '/ai-engine/ai-commerce'}
    ]
  },
  {
    label: 'Robot Logistics',
    href: '/robot-logistics/overview',
    children: [
      {label: 'Robot Logistics', href: '/robot-logistics/overview'},
      {label: 'Smart Factory', href: '/robot-logistics/smart-factory'}
    ]
  },
  {
    label: 'e-Commerce',
    href: '/e-commerce/commerce-technology',
    children: [
      {label: 'Commerce Technology', href: '/e-commerce/commerce-technology'},
      {label: 'B2B Commerce', href: '/e-commerce/b2b-commerce'},
      {label: 'Marketplace', href: '/e-commerce/marketplace'}
    ]
  },
  {
    label: 'Solutions',
    href: '/solutions/commerce-platform',
    children: [
      {label: 'Commerce Platform', href: '/solutions/commerce-platform'},
      {label: 'Logistics Platform', href: '/solutions/logistics-platform'},
      {label: 'Trade Platform', href: '/solutions/trade-platform'},
      {label: 'eLiveStock Platform', href: '/solutions/elivestock-platform'}
    ]
  },
  {
    label: 'Project',
    href: '/project/reference',
    children: [
      {label: 'Reference', href: '/project/reference'},
      {label: 'Specialized Outcomes', href: '/project/specialized-outcomes'}
    ]
  }
]
---

<header class="gnb">
  <div class="gnb__bar">
    <a href="/" class="gnb__logo">
      <img src={logoUrl.src} width="152" height="40" alt="M2M GLOBAL" />
    </a>

    <nav class="gnb__nav" aria-label="주 메뉴">
      <ul class="gnb__menu">
        {
          menu.map((item) => (
            <li class="gnb__menu-item">
              <a href={item.href} class="gnb__menu-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!--
        Figma 원본 구조: 1Depth 중 아무거나 hover하면 6개 컬럼(2Depth 전체)이
        하나의 패널로 한꺼번에 열린다 (항목별 개별 드롭다운이 아님).
        참고: https://comet-take-17267726.figma.site/navigation
      -->
      <div class="gnb__mega">
        <div class="gnb__mega-inner">
          {
            menu.map((item) => (
              <div class="gnb__mega-col">
                {item.children?.map((child) => (
                  <a href={child.href} class="gnb__mega-link">
                    {child.label}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </nav>

    <!--
      Figma 실측: 이 버튼은 모바일 전용 드로어 토글이 아니라 PC 포함 전 화면 폭에서 항상 보이는
      "전체메뉴" 버튼(로고 왼쪽 고정 / 메뉴 가운데 정렬 / 이 버튼 오른쪽 고정 3분할 배치).
      TODO(script 단계): 클릭 시 전체메뉴(사이트맵) 레이어 열기/닫기 연결.
    -->
    <button type="button" class="gnb__toggle" aria-label="전체메뉴 열기" aria-expanded="false">
      <Icon name="ico_menu" size={24} />
    </button>
  </div>
</header>
