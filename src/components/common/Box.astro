---
const {
  useBackground = false,
  useSlotFoot = false,
  useLightBorder = false,
  useAccentBorder = false,
  class: className
} = Astro.props
---

<div
  class="bs-box"
  class:list={[
    className,
    {
      'use-background': useBackground,
      'use-slotfoot': useSlotFoot,
      'use-light-border': useLightBorder,
      'use-accent-border': useAccentBorder
    }
  ]}
>
  <div class="b-inner">
    <slot />
  </div>
</div>
