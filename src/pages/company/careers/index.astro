---
// Company > 인재 채용 (/company/careers)
// 참고: Figma "About us > 인재채용" 프레임(node 360:1185)
// 예전 구(舊) 컴포넌트(PageBanner/Title/Container/Box/IconCircle/TextList) 참조로 깨져있던 페이지를
// 현재 공용 컴포넌트(SubBanner/Navigation/TitleMain/TitleSub/TextList)로 재구축 — 콘텐츠는 그대로 유지.
import {route} from '@config/route'
import Layout from '~/layouts/SubLayout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import Icon from '~/components/common/Icon.astro'
import Box from '~/components/common/Box.astro'
import BoxTitleCase5 from '~/components/ui/box/boxTitleCase/BoxTitleCase5.astro'
import BoxTitleCase6 from '~/components/ui/box/boxTitleCase/BoxTitleCase6.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'

const localNavigation = route.find((item) => item.href === '/company/info')

const benefits = [
  {
    icon: ICON_KEY_NAME['인재채용1'],
    title: '임직원 건강검진 시행',
    desc: '국내 최고의 검진 기관을 통해<br/>임직원, 가족의 검진 비용 지원'
  },
  {
    icon: ICON_KEY_NAME['인재채용2'],
    title: '문화 외식비 지원',
    desc: '임직원의 문화 생활을 위한<br/>분기별 문화 회식비 지원'
  },
  {
    icon: ICON_KEY_NAME['인재채용3'],
    title: '장기근속자 포상제도 시행',
    desc: '장기 근속 임직원에 대한<br/>근속년수 5년 단위 포상 제공'
  },
  {
    icon: ICON_KEY_NAME['인재채용4'],
    title: '인재 추천',
    desc: '정 직원 추천 및 채용 후 특정 기간 근속 시 추천 직원에게 포상금액 지급'
  },
  {
    icon: ICON_KEY_NAME['인재채용5'],
    title: '직무교육 지원',
    desc: '직무교육, 세미나, 컨퍼런스,<br/>온라인 강의 지원'
  },
  {
    icon: ICON_KEY_NAME['인재채용9'],
    title: '자격증 취득 지원',
    desc: '자격증 취득, 전문 교육과정 등<br/>자기성장교육 지원'
  },
  {
    icon: ICON_KEY_NAME['인재채용6'],
    title: '경조비 지원',
    desc: '임직원 본인 및 가족 경조사에 대한<br/>경조금 지급'
  },
  {
    icon: ICON_KEY_NAME['인재채용7'],
    title: '명절 귀향비 지급',
    desc: '즐거운 명절을 위한<br/>명절 귀향비 지급'
  }
]

const fields = [
  {title: '플랫폼 전문<br/>구축 역량', desc: 'PMO, QA, AA, TA, DA,<br/>AI, Cloud, 영업지원'},
  {title: '이커머스 플랫폼', desc: '다이소, 농협몰, 수협몰 등<br/>이커머스 플랫폼 구축'},
  {title: '물류 플랫폼', desc: 'CJ, 로봇, 무역에 관련<br/>물류 플랫폼 구축'},
  {title: 'AI, 클라우드', desc: 'Appreneur, Microsoft AZURE,<br/>IBM, AWS'},
  {title: '모바일 플랫폼', desc: 'Android, IOS 구축'},
  {title: 'UI/UX', desc: '기획, 디자인, 퍼블<br/>전문 팀 구성'}
]
---

<Layout>
  <div class="sub-wrap">
    <SubBanner
      title="Company"
      description="AI Transformation의 시작점. 이제, 속도와 방향을 다시 설계합니다.<br/>다년 간의 경험과 전문성을 겸비한 인력과 AI가 한 팀이 되어, 고객 비즈니스의 성공을 위해 끊임없이 실행하고 성장합니다."
    />
    <Navigation items={localNavigation?.children} activeMenuId={'MAP-COMPANY-ID-4'} />
    <TitleMain
      title="인재 채용"
      description="미래를 함께 만들어가며, 성장과 성취를 함께할 창의적이고 도전적인 인재를 기다립니다.<br/>엠투엠글로벌은 함께 나누고 성장하기 위해 다양한 복지제도를 운영하고 있습니다."
    />

    <section class="g-section">
      <div class="innerWrap">
        <div class="company__careers-benefits">
          <TitleSub title={`M2M GLOBAL <br/><span class="mark">복지 제도</span>`} />
          <div class="company__careers-grid">
            {
              benefits.map((benefit) => (
                <Box>
                  <BoxTitleCase5
                    icon={benefit.icon}
                    title={benefit.title}
                    description={benefit.desc}
                    size="sm"
                    tight
                  />
                </Box>
              ))
            }
          </div>
        </div>

        <TitleSub title={`인재 채용 <span class="mark">분야 / 안내</span>`} />
        <div class="company__careers-fields">
          {
            fields.map((field) => (
              <Box useBackground>
                <BoxTitleCase6 title={field.title} description={field.desc} />
              </Box>
            ))
          }
        </div>

        <div class="company__careers-process">
          <!-- TODO: 아이콘 이미지 삽입 -->
          <span class="company__icon-ph company__icon-ph--lg" aria-hidden="true">
            <Icon name={ICON_KEY_NAME['인재채용8']} />
          </span>
          <div class="company__careers-process-body">
            <TitleSub title={`채용 절차 <span class="mark">(상시)</span>`} />
            <div class="company__careers-process-list">
              <TextList type="type_1" circleType="type_2">
                1차 서류 전형 : 지원자는 이력서와 자기소개(경력자는 경력기술서 포함)를 인사지원팀
                이메일(<a href="mailto:recruit@m2mglobal.co.kr">recruit@m2mglobal.co.kr</a>) 로
                보내주세요
              </TextList>
              <TextList type="type_1" circleType="type_2">
                제출한 입사지원 서류는 반환하지 않으며, 입사지원 검토용으로만 사용됩니다
              </TextList>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
