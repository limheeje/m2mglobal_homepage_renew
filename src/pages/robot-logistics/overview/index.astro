import CaseStudySection from '~/components/common/CaseStudySection.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'
import RobCompImage001 from '~/assets/images/common/rl_int-asset001.png'
import RobCompImage002 from '~/assets/images/common/rl_int-asset002.png'
import RobCompImage003 from '~/assets/images/common/rl_int-asset003.png'
import RobCompImage004 from '~/assets/images/common/rl_int-asset004.png'
import RobCompImage005 from '~/assets/images/common/rl_int-asset005.png'
