---
// Solutions > Logistics Platform (/solutions/logistics-platform)
// Figma "솔루션 소개 > Logistics Solution" 3개 프레임(솔루션 이해 / 기술 구성 안내 / 주요 특장점) —
// 전부 같은 Tap_series 앵커 탭의 상태라 한 페이지로 합쳤다 (/solutions/commerce-platform과 동일 패턴).
//
// 참고: "솔루션 이해" 탭의 삼각형(도식) 다이어그램은 사용자 요청에 따라 이미지로 대체할 자리만
// 남기고 세부 구현은 하지 않았다.
import {route} from '@config/route/routeMap.ts'
import Layout from '~/layouts/Layout.astro'
import SubBanner from '~/components/common/SubBanner.astro'
import TitleMain from '~/components/common/TitleMain.astro'
import TitleSub from '~/components/common/TitleSub.astro'
import TitleThird from '~/components/common/TitleThird.astro'
import Navigation from '~/components/common/Navigation.astro'
import TextList from '~/components/common/TextList.astro'
import SYMBOL019 from '~/assets/images/common/symbol019.png'
import SYMBOL020 from '~/assets/images/common/symbol020.png'
import SYMBOL021 from '~/assets/images/common/symbol021.png'
import SYMBOL022 from '~/assets/images/common/symbol022.png'
import Icon from '~/components/common/Icon.astro'
import {ICON_KEY_NAME} from '~/constants/Icon'

const localNavigation = route.find((item) => item.href === '/solutions/commerce-platform')

const sectionTabs = [
  {id: 'understand', label: '솔루션 이해'},
  {id: 'tech', label: '기술 구성 안내'},
  {id: 'features', label: '주요 특장점'}
]

// --- 솔루션 이해: M2M-TMS / M2M-WMS / M2M-CVO ---
const understandCards = [
  {
    icon: ICON_KEY_NAME['Solution3-1'],
    title: 'M2M-TMS',
    items: [
      '화물 운송 계획 → 실행 → 모니터링 → 정산까지<br/>전체 프로세스를 디지털화, 최적화한 핵심 물류 솔루션',
      '운송 계획 : 배송 요청 수집, 배차/차량선택, 최적 경로 계획(거리, 시간, 비용)',
      '운송 실행 : 운송 오더 생성, 기사/차량 배송, 출고지시 및 문서 발행',
      '실시간 모니터링 : GPS기반 차량 위치 추적, 배송 도착예정 시간 관리, 운송 상태 알림 (출발, 지연, 도착 등)',
      '운송 정산 : 운송 비용 자동 계산, 운임 비교 및 협력사 정산',
      '운송 KPI 분석 : 시간, 비용, 지연율 등 분석, 지속적 개선을 위한 시뮬레이션'
    ]
  },
  {
    icon: ICON_KEY_NAME['Solution3-2'],
    title: 'M2M-WMS',
    items: [
      '입고 → 보관 → 피킹 → 포장 → 출고까지 과정을 디지털화,<br/>자동화한 스마트 물류 솔루션',
      '입고관리 : 입고예정 등록, 검수, 로케이션 자동할당, 바코드/QR스캔 기반 입고처리',
      '재고관리 : 로케이션 단위 재고 추천, LOT/유통기한/Serial No 관리, 실시간 재고 현황 파악',
      '피킹/포장 관리 : 주문 별 최적 피킹 경로 제시, 피킹 작업자/장비 배정, 자동 패킹 시 라벨 출력',
      '출고관리 : 출고 스케줄, 배차 연계, 출고 검수 및 적재 지시, 운송관리시스템(TMS) 연동',
      '리포팅&분석 : 재고 회전율, 작업 생산성, 적재 효율 분석, 안전재고 관리 및 부족 알림 제공'
    ]
  },
  {
    icon: ICON_KEY_NAME['Solution3-3'],
    title: 'M2M-CVO',
    items: [
      '실시간 위치 추적을 통한 운송 최적화(배차, 경로, 스케줄)하는<br/>물류 가시성 솔루션임',
      '효율적 배차 및 경로 최적화 제공 가능(연료비 절감 & 운송 과정 효율 극대화)',
      '멀티배송 및 복수차량 관리 가능(대규모 물류 처리 및 운영 체계화 가능)',
      '지연, 경로이탈, 차량 정지 등 이상상황 알림 및 즉각 대응 가능(신속 대응에 따른 리스크 최소화)',
      '주행 거리, 속도, 연료 사용량 등 운행 데이터 기록 및 분석 제공 (관리 및 정비 주기 최적화 및 비용 절감 효과)',
      '실시간 배송 추척에 따른 고객에게 투명한 정보 공유 가능(신뢰 강화)'
    ]
  }
]

// --- 기술 구성 안내: 컴포넌트 별 아키텍처 다이어그램 (이미지) ---
const techGroups = [
  {imgSrc: SYMBOL020.src, title: 'M2M-WMS'},
  {imgSrc: SYMBOL021.src, title: 'M2M-TMS'},
  {imgSrc: SYMBOL022.src, title: 'M2M-CVO'}
]
// --- 주요 특장점: Figma 실측대로 3개 그룹(M2M-TMS 5 / M2M-WMS 5 / M2M-CVO 8)으로 나뉜다 ---
const featureGroups = [
  {
    title: 'M2M-TMS ( 운송 관리 )',
    cards: [
      {
        icon: ICON_KEY_NAME['Solution4-1'],
        title: '운송비 절감',
        desc: '최적 경로 배차 가능<br/>연료 및 인건비 절감'
      },
      {
        icon: ICON_KEY_NAME['Solution4-2'],
        title: '운영의 효율성',
        desc: '배차 자동화<br/>속도, 정확성 강화'
      },
      {
        icon: ICON_KEY_NAME['Solution4-3'],
        title: '투명성 확보',
        desc: '고객, 파트너와 운송 현황<br/>실시간 공유'
      },
      {
        icon: ICON_KEY_NAME['Solution4-4'],
        title: '서비스 향상',
        desc: '정시 배송률 개선<br/>고객 신뢰 증대'
      },
      {
        icon: ICON_KEY_NAME['Solution4-5'],
        title: '데이터 분석&최적화',
        desc: 'KPI 분석으로<br/>전략적 개선 가능'
      }
    ]
  },
  {
    title: 'M2M-WMS (창고 관리)',
    cards: [
      {
        icon: ICON_KEY_NAME['Solution4-6'],
        title: '정밀한 재고 추적',
        desc: '로케이션 단위로 재고 위치 파악<br/>입출고이력, 유효기간, LOT관리'
      },
      {
        icon: ICON_KEY_NAME['Solution4-7'],
        title: '재고 정확성',
        desc: '실시간 데이터 갱신<br/>재고 오류 최소화<br/>실사 부담 감소'
      },
      {
        icon: ICON_KEY_NAME['Solution4-8'],
        title: '피킹/출고 효율화',
        desc: '주문에 맞는 최적의 피킹 경로 제시<br/>출고 지연 방지'
      },
      {
        icon: ICON_KEY_NAME['Solution4-9'],
        title: '최적의 재고 운영',
        desc: '과잉재고, 품절 방지<br/>안전 재고 자동 알림<br/>작업 동선, 작업시간 단축'
      },
      {
        icon: ICON_KEY_NAME['Solution4-10'],
        title: '현장 즉시 대응',
        desc: '창고 내 휴대 장비 지원<br/>(각종 휴대장비, 바코드 스캔,<br/>RFID, 라벨발행)'
      }
    ]
  },
  {
    title: 'M2M-CVO (차량관제)',
    cards: [
      {
        icon: ICON_KEY_NAME['Solution4-11'],
        title: '실시간 차량관제',
        desc: '차량 위치 실시간 관제(GPS Tracking)<br/>차량 원격제어 도난 상태 감시 및<br/>추천차량 출발-도착 관리'
      },
      {
        icon: ICON_KEY_NAME['Solution4-12'],
        title: '경로 최적화',
        desc: '교통 상황, 거리, 운송 비용 등<br/>고려하여 최적의 경로 추천 제공'
      },
      {
        icon: ICON_KEY_NAME['Solution4-13'],
        title: '차량 정보 관리',
        desc: '차량 등록 정보 관리, 사고, 정보/점검 내역 관리<br/>엔진/온도이상 차량 모니터링<br/>방전 예상 차량 모니터링'
      },
      {
        icon: ICON_KEY_NAME['Solution4-14'],
        title: '차량 배차 관리',
        desc: '차량 배차내역 관리<br/>차량별 운행 내역 관리<br/>운행 기록부 생성'
      },
      {
        icon: ICON_KEY_NAME['Solution4-15'],
        title: '멀티 배송',
        desc: '여러 대 차량 동시 모니터링 제공<br/>분할/합 배송 관리<br/>(대규모 물류 체계적 관리)'
      },
      {
        icon: ICON_KEY_NAME['Solution4-16'],
        title: '다양한 디바이스',
        desc: '다양한 디바이스 연계<br/>전용 단말기<br/>모바일'
      },
      {
        icon: ICON_KEY_NAME['Solution4-17'],
        title: '이상 상황 알림',
        desc: '지연, 경로이탈, 차량 정지 등<br/>이상 상황 발생 시<br/>즉각 알림 발송-대응'
      },
      {
        icon: ICON_KEY_NAME['Solution4-18'],
        title: '데이터 기록&분석',
        desc: '운행 내역 분석<br/>시간대 별, 차종-차량별 가동률 분석<br/>기간 별 매출 분석'
      }
    ]
  }
]
---

<Layout>
  <SubBanner
    title="Solutions"
    description="다년간의 프로젝트 축적된 경험과 노하우를 바탕으로 연구 · 개발 · 실행하여<br/>성공적으로 입증한 최적의 Smart Solution을 소개합니다."
  />
  <Navigation items={localNavigation?.children} activeMenuId={'MAP-SOLUTIONS-ID-2'} />
  <TitleMain title="Logistics Platform" />

  <div class="innerWrap">
    <div class="bs-tab-group">
      {
        sectionTabs.map((tab, i) => (
          <a
            class="bs-tab tab__item"
            class:list={{'is-active': i === 0}}
            data-type="box"
            href={`#${tab.id}`}
          >
            {tab.label}
          </a>
        ))
      }
    </div>
  </div>

  <section id="understand" class="g-section">
    <div class="innerWrap">
      <TitleSub
        title={`솔루션<span class="mark"> 이해</span>`}
        description="<span class='mark'>'고객주문접수 → 물류 서비스로 전환 → 실행 시스템과 연동 → 배송 관리 → GPS 위치정보 활용'</span>까지, 엔드투엔드 무역/물류 프로세스를 지원함으로써, 운송 업무에 효율화를 제공하며 이를 통해 비용 절감 및 리스크 최소화가 가능해짐."
      />
      <!-- TODO: 솔루션 구성도(삼각형 다이어그램) 이미지 삽입 -->
      <div class="sol__diagram-placeholder max-width-1760" aria-hidden="true">
        <img src={SYMBOL019.src} alt="" />
      </div>

      <div class="sol__understand-grid">
        {
          understandCards.map((card) => (
            <div class="sol__understand-card">
              {/* <!-- TODO: 아이콘 이미지 삽입 --> */}
              <span class="sol__understand-icon" aria-hidden="true">
                <Icon name={card.icon} />
              </span>
              <p class="sol__understand-title">{card.title}</p>
              <div class="sol__understand-list">
                {card.items.map((item) => (
                  <TextList type="type_2" set:html={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="tech" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`<span class="mark">기술 구성 안내</span>`} />
      {
        techGroups.map((name) => (
          <div class="sol__tech-group">
            <TitleThird>{name.title}</TitleThird>
            {/* <!-- TODO: 아키텍처 구성도 이미지 삽입 --> */}
            <div class="sol__tech-diagram sol__diagram-placeholder" aria-hidden="true">
              <img src={name.imgSrc} alt="" />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="features" class="g-section">
    <div class="innerWrap">
      <TitleSub title={`주요<span class="mark"> 특장점</span>`} />
      {
        featureGroups.map((group) => (
          <div class="sol__feature-group">
            <TitleThird>{group.title}</TitleThird>
            <div class="sol__stat-grid">
              {group.cards.map((card) => (
                <div class="sol__stat-card">
                  <span class="sol__stat-icon" aria-hidden="true">
                    <Icon name={card.icon} />
                  </span>
                  <p class="sol__stat-title">{card.title}</p>
                  <p class="sol__stat-desc" set:html={card.desc} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
